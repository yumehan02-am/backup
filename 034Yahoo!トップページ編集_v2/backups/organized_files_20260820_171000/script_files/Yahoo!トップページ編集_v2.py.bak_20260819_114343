    def get_calendar_holiday_dates(self):
        dates = set()
        for item in self.sections.get("calendar_holidays", []):
            if not isinstance(item, dict):
                continue
            value = item.get("date", "").strip()
            if re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
                dates.add(value)
        return dates

    def sort_calendar_holidays(self):
        items = []
        seen = set()
        for item in self.sections.get("calendar_holidays", []):
            if not isinstance(item, dict):
                continue
            value = item.get("date", "").strip()
            if re.fullmatch(r"\d{4}-\d{2}-\d{2}", value) and value not in seen:
                items.append({"date": value})
                seen.add(value)
        items.sort(key=lambda row: row["date"])
        self.sections["calendar_holidays"] = items

    def shift_calendar_month(self, delta):
        month_index = (self.calendar_view_year * 12 + (self.calendar_view_month - 1)) + delta
        self.calendar_view_year = month_index // 12
        self.calendar_view_month = month_index % 12 + 1
        self.refresh_calendar_view()

    def show_current_calendar_month(self):
        today = datetime.date.today()
        self.calendar_view_year = today.year
        self.calendar_view_month = today.month
        self.refresh_calendar_view()

    def refresh_calendar_view(self):
        if not self.calendar_day_buttons or not self.calendar_title_var:
            return
        self.calendar_title_var.set(f"{self.calendar_view_year}年 {self.calendar_view_month}月")
        month_rows = calendar.Calendar(firstweekday=0).monthdayscalendar(
            self.calendar_view_year,
            self.calendar_view_month
        )
        while len(month_rows) < 6:
            month_rows.append([0] * 7)
        holidays = self.get_calendar_holiday_dates()
        today = datetime.date.today().isoformat()

        for row_index, week in enumerate(month_rows[:6]):
            for col, day in enumerate(week):
                btn = self.calendar_day_buttons[row_index][col]
                btn._calendar_date = ""
                if day == 0:
                    btn.configure(text="", state="disabled", bg="#f5f5f5", fg="#999999", activebackground="#f5f5f5")
                    continue
                date_value = f"{self.calendar_view_year:04d}-{self.calendar_view_month:02d}-{day:02d}"
                btn._calendar_date = date_value
                is_holiday = date_value in holidays
                is_today = date_value == today
                bg = "#ffd6d6" if is_holiday else "#ffffff"
                fg = "#9a2d2d" if is_holiday or col == 6 else "#1f5a86" if col == 5 else "#222222"
                relief = "sunken" if is_holiday else "ridge"
                text = f"{day}\n休" if is_holiday else str(day)
                if is_today and not is_holiday:
                    bg = "#e7f1ff"
                btn.configure(
                    text=text,
                    state="normal",
                    bg=bg,
                    fg=fg,
                    activebackground="#d8ffd8",
                    activeforeground=fg,
                    relief=relief
                )

    def toggle_calendar_day(self, row, col, tree):
        if row <= 0 or row > len(self.calendar_day_buttons):
            return
        btn = self.calendar_day_buttons[row - 1][col]
        date_value = getattr(btn, "_calendar_date", "")
        if not date_value:
            return
        holidays = self.get_calendar_holiday_dates()
        if date_value in holidays:
            self.sections["calendar_holidays"] = [
                item for item in self.sections.get("calendar_holidays", [])
                if not isinstance(item, dict) or item.get("date", "").strip() != date_value
            ]
        else:
            self.sections.setdefault("calendar_holidays", []).append({"date": date_value})
        self.sort_calendar_holidays()
        self.populate_tree(tree, "calendar_holidays", False)

    # ====================== ドラッグ＆ドロップ ======================
    def drag_start(self, event, tree):
        tree.drag_iid = tree.identify_row(event.y)
        if tree.drag_iid:
            tree.drag_selected = list(tree.selection())
            if tree.drag_iid not in tree.drag_selected:
                tree.drag_selected = [tree.drag_iid]
            self.dragging_items = tree.drag_selected[:]
            for iid in self.dragging_items:
                if tree.exists(iid):
                    tree.item(iid, tags=("dragging",))

    def drag_motion(self, event, tree):
        if not hasattr(tree, "drag_selected") or not tree.drag_selected:
            return
        target = tree.identify_row(event.y)
        if target == self.current_highlight:
            return
        if self.current_highlight and tree.exists(self.current_highlight):
            tree.item(self.current_highlight, tags=())
        if target and target not in getattr(tree, "drag_selected", []):
            tree.item(target, tags=("DragTarget",))
            self.current_highlight = target
        else:
            self.current_highlight = None

    def drag_end(self, event, tree, section_key):
        if self.current_highlight and tree.exists(self.current_highlight):
            tree.item(self.current_highlight, tags=())
        self.current_highlight = None
        if hasattr(tree, "drag_selected") and tree.drag_selected:
            for iid in self.dragging_items:
                if tree.exists(iid):
                    tree.item(iid, tags=())
        self.dragging_items = []
        if not hasattr(tree, "drag_iid") or not getattr(tree, "drag_iid", None):
            self._cleanup_drag(tree)
            return
        target = tree.identify_row(event.y)
        data = self.sections[section_key]
        selected = getattr(tree, "drag_selected", [])
        if not selected:
            self._cleanup_drag(tree)
            return
        if target and target in selected:
            self._cleanup_drag(tree)
            return
        sel_indices = sorted(tree.index(iid) for iid in selected)
        to_move = [data[i] for i in sel_indices]
        for i in sorted(sel_indices, reverse=True):
            del data[i]
        if target is None:
            insert_pos = len(data)
        else:
            orig_target_idx = tree.index(target)
            num_removed_before = sum(1 for i in sel_indices if i < orig_target_idx)
            insert_pos = orig_target_idx - num_removed_before + 1
        data[insert_pos:insert_pos] = to_move
        self.populate_tree(tree, section_key, self.tree_info[section_key])
        self._cleanup_drag(tree)

    def _cleanup_drag(self, tree):
        for attr in ("drag_iid", "drag_selected"):
            if hasattr(tree, attr):
                delattr(tree, attr)

