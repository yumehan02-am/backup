    def create_section_background_editor(self, parent, section_key):
        frame = ttk.LabelFrame(parent, text="セクション詳細")
        if not self.add_section_background_controls(frame, section_key, row=0):
            return False
        parent.add(frame, weight=0)
        return True

    def refresh_section_background_editor(self, section_key):
        editor = self.section_background_editors.get(section_key)
        if not editor:
            return
        src = self.get_section_background_src(section_key)
        resolution = self.get_image_resolution_text(src)
        default_size = self.get_background_default_size_text(section_key)
        editable = self.is_section_background_editable_for_key(section_key)
        editor["src_var"].set(src)
        editor["select_btn"].configure(state="normal" if editable else "disabled")
        editor["clear_btn"].configure(state="normal" if editable and src else "disabled")
        info_parts = [f"既定: {default_size}" if default_size else "既定: -"]
        info_parts.append(f"現在: {resolution}" if resolution else "現在: 未設定")
        heading_note = self.get_heading_compact_note(section_key)
        if heading_note:
            info_parts.append(heading_note)
        if section_key.startswith("group_") and not editable:
            primary = self.get_primary_heading_group_key(section_key)
            label, _bg, _fg = self.get_group_badge(primary)
            bg_note = f"背景は{label}側"
            if bg_note not in info_parts:
                info_parts.append(bg_note)
        editor["info_var"].set(" / ".join(info_parts))

    def get_heading_compact_note(self, section_key):
        meta = self.section_headings.get(section_key)
        if not meta:
            return ""
        if section_key.startswith("group_") and not self.is_heading_editable_for_section(section_key):
            primary = self.get_primary_heading_group_key(section_key)
            label, _bg, _fg = self.get_group_badge(primary)
            return f"見出しは{label}側"
        return ""

    def refresh_all_section_background_editors(self):
        for section_key in list(self.section_background_editors):
            self.refresh_section_background_editor(section_key)

    def choose_section_background_image(self, section_key):
        section_id = self.get_section_id_for_key(section_key)
        if not section_id:
            messagebox.showwarning("警告", "このタブに対応するセクションIDが見つかりません。")
            return
        path = filedialog.askopenfilename(
            title="セクション背景画像を選択",
            filetypes=[("画像ファイル", "*.jpg *.png *.gif *.webp *.jpeg")]
        )
        if not path:
            return
        current_src = self.get_section_background_src(section_key)
        try:
            final_path = self.save_processed_local_image(
                path,
                section_key=f"section_bg_{section_id}",
                current_src=current_src,
                for_css=True
            )
        except Exception as e:
            messagebox.showerror("画像加工失敗", str(e))
            return
        self.set_section_background_src(section_id, final_path)
        self.refresh_section_background_editor(section_key)
        self.refresh_related_section_background_editors(section_id)
        self.refresh_nav_menu_tree()
        self.refresh_section_manager_if_open()

    def clear_section_background(self, section_key):
        section_id = self.get_section_id_for_key(section_key)
        if not section_id:
            return
        if not messagebox.askyesno("確認", "このセクション背景を解除しますか？\n保存時にCSSの背景指定も削除されます。"):
            return
        self.set_section_background_src(section_id, "")
        self.refresh_section_background_editor(section_key)
        self.refresh_related_section_background_editors(section_id)
        self.refresh_nav_menu_tree()
        self.refresh_section_manager_if_open()

