    def sync_custom_section_css_selectors(self):
        if not self.css_content:
            return
        special_ids = ["special"] + self.get_custom_section_ids_by_type("special")
        category_ids = ["menu"] + self.get_custom_section_ids_by_type("category")

        def replace_selector(predicate, new_selector):
            block_pattern = r'([^{}]+)\{([^{}]+)\}'

            def repl(match):
                selector = match.group(1)
                body = match.group(2)
                if predicate(selector, body):
                    return f"{new_selector} {{{body}}}"
                return match.group(0)

            self.css_content = re.sub(block_pattern, repl, self.css_content, flags=re.DOTALL | re.IGNORECASE)

        if len(special_ids) > 1:
            special_contents = ", ".join(f"#{section_id} .contents" for section_id in special_ids)
            replace_selector(
                lambda selector, body: "#special .contents" in selector and "bg_special.png" in body,
                special_contents,
            )

        if len(category_ids) > 1:
            category_h2 = ", ".join(f"#{section_id} h2" for section_id in category_ids)
            replace_selector(
                lambda selector, body: "#menu h2" in selector and "var(--secondary-color)" in body,
                category_h2,
            )

