    # ====================== 自由テキスト抽出 ======================
    def extract_free_text(self, html):
        if not html:
            return []
        lines = html.splitlines()
        free_lines = []
        i = 0
        inside_structured = False
        while i < len(lines):
            line = lines[i]
            stripped = line.strip()
            if (re.search(r'ここからグループ[abcd]', stripped, re.IGNORECASE) or
                re.search(r'ここからspecial', stripped, re.IGNORECASE) or
                re.search(r'ここからカテゴリ', stripped, re.IGNORECASE) or
                re.search(r'<dl class="table reverse">', stripped, re.IGNORECASE)):
                inside_structured = True
            if (re.search(r'ここまでグループ[abcd]', stripped, re.IGNORECASE) or
                re.search(r'ここまでspecial', stripped, re.IGNORECASE) or
                re.search(r'ここまでカテゴリ', stripped, re.IGNORECASE) or
                '</dl>' in stripped):
                inside_structured = False
                i += 1
                continue
            if not inside_structured:
                text_only = re.sub(r'<[^>]+>', '', stripped).strip()
                if text_only:
                    free_lines.append(line)
            i += 1
        return free_lines

    # ====================== テキスト管理 ======================
    def refresh_text_management(self):
        current = self.sections.get("text_management", [])
        keep = [item for item in current if item.get("edited") or item.get("html_edited")]
        extracted = []
        if self.index_html:
            extracted.extend(self.extract_manageable_texts(self.index_html, "index"))
        if self.menu_html:
            extracted.extend(self.extract_manageable_texts(self.menu_html, "menu"))
        edited_keys = {(item.get("file"), item.get("original_html")) for item in keep}
        merged = keep + [item for item in extracted if (item.get("file"), item.get("original_html")) not in edited_keys]
        self.sections["text_management"] = merged

    def extract_manageable_texts(self, html, file_key):
        masked = self.mask_text_excluded_blocks(html)
        items = []
        patterns = [
            (r'<span\b(?=[^>]*class="[^"]*\bhosoku\b[^"]*")[^>]*>.*?</span>', "小見出し"),
            (r'<span\b(?=[^>]*class="[^"]*\bfade-in-text\b[^"]*")[^>]*>.*?</span>', "見出し"),
            (r'<h3\b[^>]*>.*?</h3>', "見出し"),
            (r'<h4\b[^>]*>.*?</h4>', "見出し"),
            (r'<p\b[^>]*>.*?</p>', "段落"),
            (r'<button\b[^>]*>.*?</button>', "ボタン"),
        ]
        for pattern, kind in patterns:
            for m in re.finditer(pattern, masked, re.DOTALL | re.IGNORECASE):
                html_part = html[m.start():m.end()]
                if re.search(r'<(img|script|style|iframe)\b', html_part, re.IGNORECASE):
                    continue
                text = self.html_to_plain_text(html_part)
                if not text:
                    continue
                items.append({
                    "file": file_key,
                    "section": self.find_parent_section_id(html, m.start()),
                    "kind": kind,
                    "text": text,
                    "html": html_part,
                    "original_html": html_part,
                    "edited": False,
                    "html_edited": False,
                })
        items.sort(key=lambda item: html.find(item["original_html"]))
        return items

    def mask_text_excluded_blocks(self, html):
        masked = html
        patterns = [
            r'<nav\s+id="header-menu"[^>]*>.*?</nav>',
            r'<div\s+id="menubar"[^>]*>.*?</div>',
            r'<!--\s*ここからspecial\s*-->.*?<!--\s*ここまでspecial\s*-->',
            r'<!--\s*ここからカテゴリ\s*-->.*?<!--\s*ここまでカテゴリ\s*-->',
            r'<!--\s*ここからグループ[a-z]\s*-->.*?<!--\s*ここまでグループ[a-z]\s*-->',
            r'<dl class="table reverse">.*?</dl>',
            r'<!--\s*YUMEHAN_CUSTOM_SECTION_START\b.*?<!--\s*YUMEHAN_CUSTOM_SECTION_END\b[^>]*-->',
        ]
        for pattern in patterns:
            masked = re.sub(pattern, lambda m: " " * (m.end() - m.start()), masked, flags=re.DOTALL | re.IGNORECASE)
        return masked

    def html_to_plain_text(self, html_part):
        text = re.sub(r'<br\s*/?>', '\n', html_part, flags=re.IGNORECASE)
        text = re.sub(r'<[^>]+>', '', text)
        return re.sub(r'\s+', ' ', text).strip()

    def find_parent_section_id(self, html, pos):
        section_id = ""
        for m in re.finditer(r'<section\s+id="([^"]+)"', html[:pos], re.IGNORECASE):
            section_id = m.group(1)
        return section_id

    def update_html_inner_text(self, original_html, new_text):
        m = re.match(r'(<[^>]+>)(.*?)(</[^>]+>)\s*$', original_html, re.DOTALL)
        if not m:
            return new_text
        return f"{m.group(1)}{new_text}{m.group(3)}"

    def apply_text_management_replaces(self):
        for item in self.sections.get("text_management", []):
            if not item.get("edited") and not item.get("html_edited"):
                continue
            file_key = item.get("file")
            original = item.get("original_html", "")
            if not original:
                continue
            new_html = item.get("html", "") if item.get("html_edited") else self.update_html_inner_text(original, item.get("text", ""))
            if file_key == "index" and self.index_html:
                self.index_html = self.index_html.replace(original, new_html, 1)
            elif file_key == "menu" and self.menu_html:
                self.menu_html = self.menu_html.replace(original, new_html, 1)
            item["original_html"] = new_html
            item["html"] = new_html
            item["text"] = self.html_to_plain_text(new_html)
            item["edited"] = False
            item["html_edited"] = False

    # ====================== 解析 ======================
    def parse_index_sections(self):
        self.custom_section_defs = []
        self.section_headings = {
            key: value for key, value in self.section_headings.items()
            if value.get("file") == "menu"
        }
        self.parse_custom_sections()
        group_letters = set(re.findall(r'ここからグループ([a-z])', self.index_html, re.IGNORECASE))
        group_letters.update(["a", "b", "c", "d"])
        active_group_keys = {self.get_group_key(g) for g in group_letters}
        self.active_index_group_keys = set(active_group_keys)
        for g in sorted(group_letters):
            self.sections[f"group_{g}"] = self.extract_group(self.index_html, g)
        active_custom_keys = {meta.get("key", "") for meta in self.custom_section_defs if meta.get("key")}
        self.active_index_custom_keys = set(active_custom_keys)
        self.prune_stale_index_sections(active_group_keys, active_custom_keys)
        self.sections["special"] = self.extract_special(self.index_html)
        self.sections["index_menu_banners"] = self.extract_banners(self.index_html)
        self.sections["nav_menu"] = self.extract_nav_menu(self.index_html)
        self.parse_holiday_notice()
        self.sync_nav_menu_backgrounds_from_css()
        self.extract_section_headings()

    def prune_stale_index_sections(self, active_group_keys, active_custom_keys):
        for key in list(self.sections.keys()):
            if key.startswith("group_") and key not in active_group_keys:
                self.remove_tab_and_section(key)
            elif key.startswith("custom_") and key not in active_custom_keys:
                self.remove_tab_and_section(key)
        self.section_headings = {
            key: value for key, value in self.section_headings.items()
            if value.get("file") == "menu"
            or key in active_group_keys
            or key in active_custom_keys
            or key in ("special", "index_menu_banners")
        }

    def sync_dynamic_tabs_after_index_parse(self):
        if not getattr(self, "tabs_built", False) or not hasattr(self, "tab_info"):
            return
        for group_key in self.get_group_keys():
            self.add_group_tab_if_needed(group_key)
        for meta in self.custom_section_defs:
            self.add_custom_section_tab_if_needed(meta)

    def get_holiday_notice_data(self):
        items = self.sections.setdefault("holiday_notice", [])
        if not items or not isinstance(items[0], dict):
            items[:] = [{"enabled": False, "label": "", "date": "", "text": ""}]
        return items[0]

    def parse_holiday_notice(self):
        default = {"enabled": False, "label": "", "date": "", "text": ""}
        if not self.index_html:
            self.sections["holiday_notice"] = [default]
            return
        m = re.search(r'<div\s+class=["\']top-holiday-notice["\']([^>]*)>(.*?)</div>', self.index_html, re.DOTALL | re.IGNORECASE)
        if not m:
            self.sections["holiday_notice"] = [default]
            return
        attrs = m.group(1) or ""
        body = m.group(2) or ""

        def span_text(class_name):
            sm = re.search(rf'<span\s+class=["\']{re.escape(class_name)}["\'][^>]*>(.*?)</span>', body, re.DOTALL | re.IGNORECASE)
            return self.html_to_plain_text(sm.group(1)).strip() if sm else ""

        hidden = (
            re.search(r'display\s*:\s*none', attrs, re.IGNORECASE) is not None
            or re.search(r'data-visible\s*=\s*["\']false["\']', attrs, re.IGNORECASE) is not None
        )
        self.sections["holiday_notice"] = [{
            "enabled": not hidden,
            "label": span_text("notice-label"),
            "date": span_text("notice-date"),
            "text": span_text("notice-text"),
        }]

    def parse_calendar_holidays(self):
        if not self.js_content:
            self.sections["calendar_holidays"] = []
            return
        m = re.search(r'const\s+extraHolidays\s*=\s*\[(.*?)\]\s*;', self.js_content, re.DOTALL | re.IGNORECASE)
        if not m:
            self.sections["calendar_holidays"] = []
            return
        dates = re.findall(r'["\'](\d{4}-\d{2}-\d{2})["\']', m.group(1))
        self.sections["calendar_holidays"] = [{"date": date} for date in dates]

    def parse_custom_sections(self):
        if not self.index_html:
            return
        pattern = (
            r'<!--\s*YUMEHAN_CUSTOM_SECTION_START\s+'
            r'id="([^"]+)"\s+type="([^"]+)"\s+title="([^"]*)"\s+sub="([^"]*)"\s*-->'
            r'(.*?)'
            r'<!--\s*YUMEHAN_CUSTOM_SECTION_END\s+id="\1"\s*-->'
        )
        for section_id, section_type, title, subheading, block in re.findall(pattern, self.index_html, re.DOTALL | re.IGNORECASE):
            key = self.get_custom_section_key(section_type, section_id)
            meta = {"id": section_id, "type": section_type, "title": title, "sub": subheading, "key": key}
            self.custom_section_defs.append(meta)
            if section_type == "special":
                self.sections[key] = self.extract_special_from_block(block)
            elif section_type == "category":
                self.sections[key] = self.extract_banners(block)
            elif section_type == "text":
                self.sections[key] = self.extract_custom_text_items(block)

    def get_custom_section_key(self, section_type, section_id):
        safe_id = re.sub(r'[^a-zA-Z0-9_]+', '_', section_id)
        return f"custom_{section_type}_{safe_id}"

    def extract_special_from_block(self, block):
        return self.extract_special_items_from_block(block)

    def extract_special_items_from_block(self, block):
        items = []
        slide_pattern = r'<div\s+class="slide(?:\s+img1)?\b[^"]*"[^>]*>(.*?)</div>'
        for b in re.findall(slide_pattern, block, re.DOTALL | re.IGNORECASE):
            href = re.search(r'href="([^"]+)"', b)
            src = re.search(r'src="([^"]+)"', b)
            text = re.search(r'<p class="text">([^<]+)</p>', b)
            badge = re.search(r'<span class="icon-menu-point">([^<]+)</span>', b)
            if href and src:
                items.append({
                    "href": href.group(1),
                    "src": src.group(1),
                    "text": text.group(1) if text else "",
                    "badge": badge.group(1) if badge else ""
                })
        return items

    def extract_custom_text_items(self, block):
        items = []
        m = re.search(r'<div class="custom-text-body">(.*?)</div>', block, re.DOTALL | re.IGNORECASE)
        source = m.group(1) if m else block
        for item in re.findall(r'<p>.*?</p>', source, re.DOTALL | re.IGNORECASE):
            items.append(item.strip())
        return items

    def parse_menu_sections(self):
        self.sections["menu_banners"] = self.extract_banners(self.menu_html)
        self.sections["menu_bottom_links"] = self.extract_bottom_links(self.menu_html)
        self.extract_menu_heading()

    def extract_section_headings(self):
        if not self.index_html:
            return
        for key in self.get_group_keys():
            group_letter = self.get_group_letter_from_key(key)
            section_id = self.find_section_id_for_group(group_letter)
            meta = self.get_heading_meta_for_section(self.index_html, section_id)
            if meta:
                meta.update({"file": "index", "section_id": section_id, "key": key})
                self.section_headings[key] = meta
        for key, section_id in (("special", "special"), ("index_menu_banners", "menu")):
            meta = self.get_heading_meta_for_section(self.index_html, section_id)
            if meta:
                meta.update({"file": "index", "section_id": section_id, "key": key})
                self.section_headings[key] = meta
        for custom_meta in self.custom_section_defs:
            key = custom_meta.get("key", "")
            section_id = custom_meta.get("id", "")
            meta = self.get_heading_meta_for_section(self.index_html, section_id) or {
                "title": custom_meta.get("title", ""),
                "sub": custom_meta.get("sub", ""),
                "style": "span" if custom_meta.get("sub") else "simple",
            }
            meta.update({
                "file": "index",
                "section_id": section_id,
                "key": key,
                "custom_meta": custom_meta,
            })
            self.section_headings[key] = meta

    def extract_menu_heading(self):
        if not self.menu_html:
            return
        m = re.search(r'<h2[^>]*>(.*?)</h2>', self.menu_html, re.DOTALL | re.IGNORECASE)
        if not m:
            return
        title, subheading, style = self.parse_heading_inner(m.group(1))
        self.section_headings["menu_banners"] = {
            "file": "menu",
            "section_id": "",
            "key": "menu_banners",
            "title": title,
            "sub": subheading,
            "style": style,
        }

    def find_section_id_for_group(self, group_letter):
        if not group_letter:
            return ""
        marker = f"ここからグループ{group_letter}"
        for m in re.finditer(r'<section\s+id="([^"]+)"[^>]*>(.*?)</section>', self.index_html, re.DOTALL | re.IGNORECASE):
            if re.search(re.escape(marker), m.group(2), re.IGNORECASE):
                return m.group(1)
        gallery_map = {"a": "gallery0", "b": "gallery0", "c": "gallery1", "d": "gallery1"}
        return gallery_map.get(group_letter.lower(), "")

    def get_heading_meta_for_section(self, html, section_id):
        section = self.extract_section_by_id(html, section_id)
        if not section:
            return None
        m = re.search(r'<h2[^>]*>(.*?)</h2>', section, re.DOTALL | re.IGNORECASE)
        if not m:
            return None
        title, subheading, style = self.parse_heading_inner(m.group(1))
        return {"title": title, "sub": subheading, "style": style}

    def parse_heading_inner(self, inner_html):
        spans = re.findall(r'<span[^>]*class="([^"]*)"[^>]*>(.*?)</span>', inner_html, re.DOTALL | re.IGNORECASE)
        subheading = ""
        title = ""
        for classes, value in spans:
            text = self.html_to_plain_text(value)
            if "hosoku" in classes:
                subheading = text
            elif "fade-in-text" in classes:
                title = text
        if title or subheading:
            return title, subheading, "span"
        return self.html_to_plain_text(inner_html), "", "simple"

    def extract_group(self, html, group_letter):
        pattern = rf'ここからグループ{group_letter}.*?(.*?)ここまでグループ{group_letter}'
        m = re.search(pattern, html, re.DOTALL | re.IGNORECASE)
        if m:
            block = m.group(1)
        else:
            block = self.extract_group_without_markers(html, group_letter)
            if not block:
                return []
        items = []
        for href, src in re.findall(r'<div><a href="([^"]+)"><img src="([^"]+)" alt="[^"]*"></a></div>', block):
            items.append({"href": href, "src": src})
        return items

    def extract_group_without_markers(self, html, group_letter):
        gallery_map = {
            "a": ("gallery0", 0),
            "b": ("gallery0", 1),
            "c": ("gallery1", 0),
            "d": ("gallery1", 1),
        }
        section_id, block_index = gallery_map.get(group_letter, ("", -1))
        section = self.extract_section_by_id(html, section_id)
        if not section:
            return ""
        blocks = re.findall(
            r'<div class="slide-thumbnail1">\s*<div class="img[^"]*">\s*(.*?)(?=\n</div>\s*\n</div>)',
            section,
            re.DOTALL | re.IGNORECASE
        )
        if block_index < 0 or block_index >= len(blocks):
            return ""
        return blocks[block_index]

    def extract_section_by_id(self, html, section_id):
        if not section_id:
            return ""
        m = re.search(
            rf'<section\s+id="{re.escape(section_id)}"[^>]*>(.*?)</section>',
            html,
            re.DOTALL | re.IGNORECASE
        )
        return m.group(1) if m else ""

    def extract_special(self, html):
        m = re.search(r'<!--\s*ここからspecial\s*-->(.*?)<!--\s*ここまでspecial\s*-->', html, re.DOTALL | re.IGNORECASE)
        if m:
            items = self.extract_special_items_from_block(m.group(1))
            if items:
                return items
        section = self.extract_section_by_id(html, "special")
        if section:
            return self.extract_special_items_from_block(section)
        return []

    def extract_banners(self, html):
        items = []
        pattern = r'<div class="menu (?:up|blur)">.*?<a href="([^"]+)">.*?<img src="([^"]+)"[^>]*>.*?<p class="text">([^<]+)</p>(?:.*?<span class="icon-menu-point">([^<]+)</span>)?'
        for m in re.finditer(pattern, html, re.DOTALL | re.IGNORECASE):
            items.append({
                "href": m.group(1),
                "src": m.group(2),
                "text": m.group(3).strip(),
                "badge": m.group(4).strip() if m.group(4) else ""
            })
        return items

    def extract_bottom_links(self, html):
        items = []
        dl_block = re.search(r'<dl class="table reverse">(.*?)</dl>', html, re.DOTALL)
        if not dl_block: return []
        for dt, dd in re.findall(r'<dt>(.*?)</dt>\s*<dd>(.*?)</dd>', dl_block.group(1), re.DOTALL):
            href_match = re.search(r'href="([^"]+)"', dd)
            if href_match:
                items.append({
                    "label": re.sub(r'<[^>]+>', '', dt).strip(),
                    "href": href_match.group(1),
                    "link_text": re.sub(r'<[^>]+>', '', dd).strip()
                })
        return items

    def extract_nav_menu(self, html):
        items = self.extract_nav_menu_block(
            html,
            r'<nav\s+id="header-menu"[^>]*>\s*<ul>(.*?)</ul>\s*</nav>'
        )
        if items:
            return items
        return self.extract_nav_menu_block(
            html,
            r'<div\s+id="menubar"[^>]*>\s*<nav>\s*<ul>(.*?)</ul>\s*</nav>\s*</div>'
        )

    def extract_nav_menu_block(self, html, pattern):
        m = re.search(pattern, html, re.DOTALL | re.IGNORECASE)
        if not m:
            return []
        items = []
        for href, text in re.findall(r'<li>\s*<a\s+href="([^"]*)"\s*>(.*?)</a>\s*</li>', m.group(1), re.DOTALL | re.IGNORECASE):
            clean_text = re.sub(r'<[^>]+>', '', text).strip()
            items.append({"href": href.strip(), "text": clean_text})
        return items

    def get_section_id_from_href(self, href):
        href = (href or "").strip()
        if not href.startswith("#") or len(href) <= 1:
            return ""
        return href[1:]

    def get_css_section_background(self, section_id):
        if not section_id or not self.css_content:
            return ""
        pattern = rf'#{re.escape(section_id)}::before\s*\{{(.*?)\}}'
        match = re.search(pattern, self.css_content, re.DOTALL | re.IGNORECASE)
        if not match:
            return ""
        url_match = re.search(r'url\s*\(\s*["\']?([^"\')]+)["\']?\s*\)', match.group(1), re.IGNORECASE)
        return url_match.group(1).strip() if url_match else ""

    def get_section_id_for_key(self, section_key):
        if section_key.startswith("group_"):
            meta = self.section_headings.get(section_key)
            if meta and meta.get("section_id"):
                return meta.get("section_id", "")
            return self.find_section_id_for_group(self.get_group_letter_from_key(section_key))
        if section_key == "special":
            return "special"
        if section_key == "index_menu_banners":
            return "menu"
        if section_key == "holiday_notice":
            return "home"
        if section_key.startswith("custom_"):
            for meta in self.custom_section_defs:
                if meta.get("key") == section_key:
                    return meta.get("id", "")
        return ""

    def get_nav_item_for_section_id(self, section_id):
        if not section_id:
            return None
        for item in self.sections.get("nav_menu", []):
            if isinstance(item, dict) and self.get_section_id_from_href(item.get("href", "")) == section_id:
                return item
        return None

    def get_section_background_src(self, section_key_or_id):
        section_id = section_key_or_id
        if not re.fullmatch(r'[A-Za-z0-9_-]+', section_id or "") or section_key_or_id in self.sections:
            section_id = self.get_section_id_for_key(section_key_or_id)
        item = self.get_nav_item_for_section_id(section_id)
        if item and item.get("background_src"):
            return item.get("background_src", "")
        return self.get_css_section_background(section_id)

    def set_section_background_src(self, section_key_or_id, src):
        section_id = section_key_or_id
        if section_key_or_id in self.sections or section_key_or_id.startswith("group_") or section_key_or_id.startswith("custom_"):
            section_id = self.get_section_id_for_key(section_key_or_id)
        if not section_id:
            return
        item = self.get_nav_item_for_section_id(section_id)
        if item is not None:
            item["background_src"] = src.strip()
        elif src.strip():
            self.sections.setdefault("nav_menu", []).append({"href": f"#{section_id}", "text": section_id, "background_src": src.strip()})

    def is_section_background_editable_for_key(self, section_key):
        section_id = self.get_section_id_for_key(section_key)
        if not section_id:
            return False
        if section_key.startswith("group_"):
            return self.is_heading_editable_for_section(section_key)
        return section_key in ("special", "index_menu_banners", "holiday_notice") or section_key.startswith("custom_")

    def get_background_default_size_text(self, section_key):
        size = self.get_default_background_size_for_section(section_key)
        return f"{size[0]}x{size[1]}" if size else ""

    def sync_nav_menu_backgrounds_from_css(self):
        for item in self.sections.get("nav_menu", []):
            if not isinstance(item, dict):
                continue
            section_id = self.get_section_id_from_href(item.get("href", ""))
            if not section_id:
                continue
            item["background_src"] = self.get_css_section_background(section_id)

    def upsert_css_section_background(self, section_id, src):
        if not section_id or not src:
            return
        if self.css_content is None:
            self.css_content = ""
        block_pattern = rf'(#{re.escape(section_id)}::before\s*\{{)(.*?)(\}})'

        def replace_block(match):
            body = match.group(2)
            background_line = f'    background: url("{src}") no-repeat center center / cover;'
            if re.search(r'background\s*:', body, re.IGNORECASE):
                body = re.sub(r'background\s*:[^;]+;', background_line, body, count=1, flags=re.IGNORECASE)
            else:
                body = "\n" + background_line + body
            return match.group(1) + body + match.group(3)

        if re.search(block_pattern, self.css_content, re.DOTALL | re.IGNORECASE):
            self.css_content = re.sub(block_pattern, replace_block, self.css_content, count=1, flags=re.DOTALL | re.IGNORECASE)
            return

        addition = (
            f'\n/* {section_id} 用の背景画像 */\n'
            f'#{section_id}::before {{\n'
            f'    background: url("{src}") no-repeat center center / cover;\n'
            f'}}\n'
        )
        self.css_content = (self.css_content or "").rstrip() + "\n" + addition

    def remove_css_section_background(self, section_id):
        if not section_id or not self.css_content:
            return
        block_pattern = rf'\n?/\*\s*{re.escape(section_id)}[^*]*背景画像\s*\*/\s*\n?#{re.escape(section_id)}::before\s*\{{.*?\}}\s*\n?'
        self.css_content, count = re.subn(block_pattern, "\n", self.css_content, count=1, flags=re.DOTALL | re.IGNORECASE)
        if count:
            return
        selector_pattern = rf'(#{re.escape(section_id)}::before\s*\{{)(.*?)(\}})'

        def remove_background_line(match):
            body = re.sub(r'\s*background\s*:[^;]+;\s*(?:/\*.*?\*/)?', "\n", match.group(2), count=1, flags=re.DOTALL | re.IGNORECASE)
            return match.group(1) + body + match.group(3)

        self.css_content = re.sub(selector_pattern, remove_background_line, self.css_content, count=1, flags=re.DOTALL | re.IGNORECASE)

    def apply_nav_menu_backgrounds_to_css(self):
        for item in self.sections.get("nav_menu", []):
            if not isinstance(item, dict):
                continue
            section_id = self.get_section_id_from_href(item.get("href", ""))
            src = item.get("background_src", "").strip()
            if section_id and src:
                self.upsert_css_section_background(section_id, src)
            elif section_id and "background_src" in item:
                self.remove_css_section_background(section_id)

    def extract_index_section_blocks(self):
        if not self.index_html:
            return []
        return list(re.finditer(r'<section\s+id="([^"]+)"[^>]*>.*?</section>', self.index_html, re.DOTALL | re.IGNORECASE))

    def sync_index_sections_to_nav_order(self):
        if not self.index_html:
            return
        matches = self.extract_index_section_blocks()
        if len(matches) < 2:
            return
        section_by_id = {m.group(1): m.group(0) for m in matches}
        original_ids = [m.group(1) for m in matches]
        nav_ids = []
        for item in self.sections.get("nav_menu", []):
            if not isinstance(item, dict):
                continue
            section_id = self.get_section_id_from_href(item.get("href", ""))
            if section_id in section_by_id and section_id not in nav_ids:
                nav_ids.append(section_id)
        if not nav_ids:
            return
        ordered_ids = nav_ids + [section_id for section_id in original_ids if section_id not in nav_ids]
        if ordered_ids == original_ids:
            return
        first = matches[0].start()
        last = matches[-1].end()
        rebuilt = "\n\n".join(section_by_id[section_id] for section_id in ordered_ids)
        self.index_html = self.index_html[:first] + rebuilt + self.index_html[last:]

    def get_gallery_section_ids(self):
        ids = []
        for match in self.extract_index_section_blocks():
            section_id = match.group(1)
            block = match.group(0)
            if 'class="gallery-box"' in block or "class='gallery-box'" in block:
                ids.append(section_id)
        return ids

    def sync_gallery_css_selectors(self):
        if not self.css_content:
            return
        self.ensure_global_contents_css()
        gallery_ids = self.get_gallery_section_ids()
        if not gallery_ids:
            return
        aside_selectors = ", ".join(f"#{section_id} aside" for section_id in gallery_ids)
        contents_selectors = ", ".join(f"#{section_id} .contents" for section_id in gallery_ids)
        box_selectors = ", ".join(f"#{section_id} .gallery-box" for section_id in gallery_ids)
        before_selectors = ",\n".join(f"#{section_id} .gallery-box::before" for section_id in gallery_ids)
        after_selectors = ",\n".join(f"#{section_id} .gallery-box::after" for section_id in gallery_ids)
        shared_selectors = ",\n".join(
            [f"#{section_id} .gallery-box::before" for section_id in gallery_ids] +
            [f"#{section_id} .gallery-box::after" for section_id in gallery_ids]
        )

        def replace_selector(predicate, new_selector):
            block_pattern = r'([^{}]+)\{([^{}]+)\}'

            def repl(match):
                selector = match.group(1)
                body = match.group(2)
                if predicate(selector, body):
                    return f"{new_selector} {{{body}}}"
                return match.group(0)

            self.css_content = re.sub(block_pattern, repl, self.css_content, flags=re.DOTALL | re.IGNORECASE)

        replace_selector(
            lambda selector, body: "#gallery0" in selector and "#gallery1" in selector and " aside" in selector and "var(--gallery-space)" in body and "position: absolute" in body,
