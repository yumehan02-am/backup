    def get_primary_heading_group_key(self, section_key):
        meta = self.section_headings.get(section_key)
        if not meta or not section_key.startswith("group_"):
            return section_key
        section_id = meta.get("section_id", "")
        same_keys = []
        for key in self.get_group_keys():
            other = self.section_headings.get(key)
            if other and other.get("section_id") == section_id:
                same_keys.append(key)
        return same_keys[0] if same_keys else section_key

    def is_heading_editable_for_section(self, section_key):
        if not section_key.startswith("group_"):
            return True
        return self.get_primary_heading_group_key(section_key) == section_key

    def refresh_heading_editor(self, section_key):
        editor = self.heading_editors.get(section_key)
        if not editor:
            return
        meta = self.section_headings.get(section_key)
        editable = bool(meta and self.is_heading_editable_for_section(section_key))
        state = "normal" if editable else "disabled"
        editor["updating"] = True
        editor["title_var"].set(meta.get("title", "") if meta else "")
        editor["sub_var"].set(meta.get("sub", "") if meta else "")
        editor["updating"] = False
        editor["title_entry"].configure(state=state)
        editor["sub_entry"].configure(state=state)
        self.refresh_section_background_editor(section_key)

    def on_heading_var_changed(self, section_key):
        editor = self.heading_editors.get(section_key)
        if not editor or editor.get("updating"):
            return
        if not self.is_heading_editable_for_section(section_key):
            return
        changed = self.update_heading_from_values(
            section_key,
            editor["title_var"].get(),
            editor["sub_var"].get()
        )
        if changed:
            self.refresh_shared_heading_editors(section_key)

    def refresh_shared_heading_editors(self, section_key):
        meta = self.section_headings.get(section_key)
        if not meta:
            return
        for other_key, other_meta in self.section_headings.items():
            if other_key == section_key:
                continue
            if other_meta.get("file") == meta.get("file") and other_meta.get("section_id") == meta.get("section_id"):
                self.refresh_heading_editor(other_key)

    def refresh_all_heading_editors(self):
        for section_key in list(self.heading_editors):
            self.refresh_heading_editor(section_key)

