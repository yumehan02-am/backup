        self.notebook.bind("<ButtonPress-1>", self.on_tab_drag_start, add="+")
        self.notebook.bind("<B1-Motion>", self.on_tab_drag_motion, add="+")
        self.notebook.bind("<ButtonRelease-1>", self.on_tab_drag_release, add="+")

    def create_tab(self, title, key, has_image):
        if key in self.tab_frames:
            return
        frame = ttk.Frame(self.notebook)
        tab_options = {"text": title}
        if key.startswith("group_"):
            _label, bg, _fg = self.get_group_badge(key)
            icon = self.create_color_square(bg)
            self.tab_icons[key] = icon
            tab_options.update({"image": icon, "compound": "left"})
        self.notebook.add(frame, **tab_options)
        self.tab_frames[key] = frame
        self.create_section_ui(frame, key, has_image)

    def add_group_tab_if_needed(self, group_key):
        if group_key in self.tab_frames:
            return
        if not hasattr(self, "notebook"):
            return
        label, _bg, _fg = self.get_group_badge(group_key)
        title = f"{label}: {self.get_group_display_name(group_key)}"
        insert_at = len([key for _title, key, _has_image in self.tab_info if key.startswith("group_")])
        self.tab_info.insert(insert_at, (title, group_key, True))
        self.create_tab(title, group_key, True)

    def add_custom_section_tab_if_needed(self, meta):
        key = meta["key"]
        if key in self.tab_frames:
            return
        if not hasattr(self, "notebook"):
            return
        has_image = meta.get("type") in ("special", "category")
        title = f"追加: {meta.get('title', meta.get('id', ''))}"
        self.tab_info.append((title, key, has_image))
        self.create_tab(title, key, has_image)

    def get_tab_key_by_frame(self, frame_id):
        for key, frame in self.tab_frames.items():
            if str(frame) == str(frame_id):
                return key
        return ""

    def sync_tab_info_from_notebook(self):
        info_by_key = {key: (title, key, has_image) for title, key, has_image in self.tab_info}
        ordered = []
        for frame_id in self.notebook.tabs():
            key = self.get_tab_key_by_frame(frame_id)
            if key and key in info_by_key:
                ordered.append(info_by_key[key])
        remaining = [info for info in self.tab_info if info[1] not in {item[1] for item in ordered}]
        self.tab_info = ordered + remaining

    def apply_saved_tab_order(self):
        order = self.settings.get("tab_order", [])
        if not isinstance(order, list) or not order:
            return
        current_keys = [self.get_tab_key_by_frame(frame_id) for frame_id in self.notebook.tabs()]
        desired_keys = [key for key in order if key in self.tab_frames]
        desired_keys.extend(key for key in current_keys if key and key not in desired_keys)
        for index, key in enumerate(desired_keys):
            frame = self.tab_frames.get(key)
            if frame:
                try:
                    self.notebook.insert(index, frame)
                except tk.TclError:
                    pass
        self.sync_tab_info_from_notebook()

    def save_tab_order(self):
        order = []
        for frame_id in self.notebook.tabs():
            key = self.get_tab_key_by_frame(frame_id)
            if key:
                order.append(key)
        self.settings["tab_order"] = order
        self.save_settings()

    def on_tab_drag_start(self, event):
        try:
            self.tab_drag_index = self.notebook.index(f"@{event.x},{event.y}")
        except tk.TclError:
            self.tab_drag_index = None

    def on_tab_drag_motion(self, event):
        if self.tab_drag_index is None:
            return
        try:
            target_index = self.notebook.index(f"@{event.x},{event.y}")
        except tk.TclError:
            return
        if target_index == self.tab_drag_index:
            return
        tabs = self.notebook.tabs()
        if self.tab_drag_index < 0 or self.tab_drag_index >= len(tabs):
            return
        moving = tabs[self.tab_drag_index]
        try:
            self.notebook.insert(target_index, moving)
            self.tab_drag_index = target_index
        except tk.TclError:
            pass

    def on_tab_drag_release(self, _event):
        if self.tab_drag_index is not None:
            self.sync_tab_info_from_notebook()
            self.save_tab_order()
        self.tab_drag_index = None

