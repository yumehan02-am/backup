    def get_selected_section_key(self):
        selected = self.notebook.select()
        for key, frame in self.tab_frames.items():
            if str(frame) == str(selected):
                return key
        return "group_a" if "group_a" in self.tree_widgets else ""

    def get_visible_tab_frame_ids(self):
        visible = []
        for frame_id in self.notebook.tabs():
            try:
                if self.notebook.tab(frame_id, "state") != "hidden":
                    visible.append(frame_id)
            except tk.TclError:
                pass
        return visible

    def switch_tab_by_offset(self, offset):
        visible = self.get_visible_tab_frame_ids()
        if not visible:
            return
        selected = self.notebook.select()
        try:
            current = visible.index(selected)
        except ValueError:
            current = 0
        next_index = (current + offset) % len(visible)
        try:
            self.notebook.select(visible[next_index])
        except tk.TclError:
            return
        self.on_tab_changed()
        self.update_tab_nav_status()

    def get_tab_title_by_key(self, key):
        for title, info_key, _has_image in getattr(self, "tab_info", []):
            if info_key == key:
                return title
        return key

    def update_tab_nav_status(self):
        if not self.tab_position_var or not hasattr(self, "notebook"):
            return
        visible = self.get_visible_tab_frame_ids()
        if not visible:
            self.tab_position_var.set("")
            return
        selected = self.notebook.select()
        try:
            index = visible.index(selected)
        except ValueError:
            index = 0
        key = self.get_selected_section_key()
        title = self.get_tab_title_by_key(key)
        self.tab_position_var.set(f"{index + 1} / {len(visible)}  {title}")

    def is_section_tab_visible(self, key):
