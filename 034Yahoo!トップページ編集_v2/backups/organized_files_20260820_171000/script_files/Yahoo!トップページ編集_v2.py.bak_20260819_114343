        dlg.geometry("980x520")
        dlg.minsize(820, 420)
        dlg.transient(self.root)

        main = ttk.Frame(dlg, padding=10)
        main.pack(fill="both", expand=True)
        tree_frame = ttk.Frame(main)
        columns = ("kind", "section_id", "title", "background", "resolution", "default_size", "protected")
        tree = ttk.Treeview(tree_frame, columns=columns, show="tree headings", height=16)
        tree.heading("#0", text="No.")
        tree.heading("kind", text="種類")
        tree.heading("section_id", text="ID")
        tree.heading("title", text="表示名")
        tree.heading("background", text="背景画像")
        tree.heading("resolution", text="解像度")
        tree.heading("default_size", text="既定")
        tree.heading("protected", text="削除")
        tree.column("#0", width=48, anchor="center")
        tree.column("kind", width=120, anchor="center")
        tree.column("section_id", width=100, anchor="center")
        tree.column("title", width=170, anchor="w")
        tree.column("background", width=320, anchor="w")
        tree.column("resolution", width=80, anchor="center")
        tree.column("default_size", width=80, anchor="center")
        tree.column("protected", width=60, anchor="center")
        yscroll = ttk.Scrollbar(tree_frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=yscroll.set)
        tree.pack(side="left", fill="both", expand=True)
        yscroll.pack(side="right", fill="y")

        def selected_indices():
            indices = []
            for iid in tree.selection():
                try:
                    indices.append(int(str(iid).replace("nav_", "", 1)))
                except ValueError:
                    pass
            return indices

        pending_reorder_var = tk.BooleanVar(value=False)
        pending_label_var = tk.StringVar(value="")

        def mark_pending_reorder():
            pending_reorder_var.set(True)
            pending_label_var.set("並び変更あり: 反映でメイン画面へ更新")

        def clear_pending_reorder():
            pending_reorder_var.set(False)
            pending_label_var.set("")

        def refresh():
            tree.delete(*tree.get_children())
            protected_ids = {"home", "kodawari", "gallery0", "gallery1", "special", "menu", "shop"}
            for idx, item in enumerate(self.sections.get("nav_menu", []), start=1):
                if not isinstance(item, dict):
                    continue
                section_id = self.get_section_id_from_href(item.get("href", ""))
                background = item.get("background_src", "") or self.get_css_section_background(section_id)
                resolution = self.get_image_resolution_text(background)
                default_size = self.get_background_default_size_text(section_id)
                protected = "不可" if section_id in protected_ids else "可"
                kind = self.get_section_kind_label(section_id)
                values = (
                    kind,
                    section_id,
                    item.get("text", ""),
                    background,
                    resolution,
                    default_size,
                    protected,
                )
                tree.insert("", "end", iid=f"nav_{idx - 1}", text=str(idx), values=values)

        def add_section():
            self.open_add_section_dialog()
            dlg.after(300, refresh)

        def delete_section():
            indices = sorted(selected_indices(), reverse=True)
            if not indices:
                messagebox.showwarning("警告", "削除するセクションを選択してください。")
                return
            removed_menus, removed_sections = self.delete_nav_sections_by_indices(indices)
            self.refresh_nav_menu_tree()
            self.update_tab_visibility()
            self.update_all_trees()
            refresh()
            clear_pending_reorder()
            messagebox.showinfo("削除完了", f"メニュー {removed_menus} 件、セクション {len(removed_sections)} 件を削除しました。")

        def choose_background():
            indices = selected_indices()
            if not indices:
                messagebox.showwarning("警告", "背景を設定するセクションを選択してください。")
                return
            idx = indices[0]
            item = self.sections.get("nav_menu", [])[idx]
            section_id = self.get_section_id_from_href(item.get("href", ""))
            self.choose_section_background_by_id(section_id)
            refresh()

        def clear_background():
            indices = selected_indices()
            if not indices:
                messagebox.showwarning("警告", "背景を解除するセクションを選択してください。")
                return
            idx = indices[0]
            item = self.sections.get("nav_menu", [])[idx]
            section_id = self.get_section_id_from_href(item.get("href", ""))
            if not section_id:
                return
            if not messagebox.askyesno("確認", "選択セクションの背景を解除しますか？\n保存時にCSSの背景指定も削除されます。"):
                return
            self.set_section_background_src(section_id, "")
            self.refresh_related_section_background_editors(section_id)
            self.refresh_nav_menu_tree()
            refresh()

        def move_selected(delta):
            indices = selected_indices()
            if len(indices) != 1:
                messagebox.showwarning("警告", "移動するセクションを1つ選択してください。")
                return
            idx = indices[0]
            new_idx = idx + delta
            nav = self.sections.get("nav_menu", [])
            if new_idx < 0 or new_idx >= len(nav):
                return
            nav[idx], nav[new_idx] = nav[new_idx], nav[idx]
            refresh()
            mark_pending_reorder()
            children = tree.get_children()
            if 0 <= new_idx < len(children):
                tree.selection_set(children[new_idx])
                tree.focus(children[new_idx])
                tree.see(children[new_idx])

        def apply_section_order():
            if self.index_html:
                self.rebuild_nav_menus()
                self.sync_index_sections_to_nav_order()
            self.refresh_nav_menu_tree()
            self.update_tab_visibility()
            self.update_all_trees()
            refresh()
            clear_pending_reorder()
            messagebox.showinfo("反映完了", "セクションの並びをメイン画面へ反映しました。")

        buttons = ttk.Frame(main)
        buttons.pack(fill="x", pady=(0, 8))
        ttk.Button(buttons, text="新規追加", command=add_section).pack(side="left", padx=4)
        ttk.Button(buttons, text="削除", command=delete_section).pack(side="left", padx=4)
        ttk.Button(buttons, text="上へ", command=lambda: move_selected(-1)).pack(side="left", padx=(18, 4))
        ttk.Button(buttons, text="下へ", command=lambda: move_selected(1)).pack(side="left", padx=4)
        ttk.Button(buttons, text="背景選択", command=choose_background).pack(side="left", padx=(18, 4))
        ttk.Button(buttons, text="背景解除", command=clear_background).pack(side="left", padx=4)
        ttk.Label(buttons, textvariable=pending_label_var, foreground="#b06000").pack(side="left", padx=(18, 4))
        ttk.Button(buttons, text="反映", command=apply_section_order).pack(side="right", padx=4)
        ttk.Button(buttons, text="更新", command=refresh).pack(side="right", padx=4)
        ttk.Button(buttons, text="閉じる", command=dlg.destroy).pack(side="right", padx=4)
        tree_frame.pack(fill="both", expand=True)
        self.section_manager_refresh_callback = refresh
        dlg.protocol("WM_DELETE_WINDOW", lambda: (setattr(self, "section_manager_refresh_callback", None), dlg.destroy()))
        refresh()

    def refresh_section_manager_if_open(self):
        callback = getattr(self, "section_manager_refresh_callback", None)
        if callback:
            try:
                callback()
            except tk.TclError:
                self.section_manager_refresh_callback = None

    def get_section_kind_label(self, section_id):
        if not section_id:
            return ""
        for meta in self.custom_section_defs:
            if meta.get("id") == section_id:
                return {
                    "special": "追加スライド",
                    "category": "追加カテゴリ",
                    "text": "追加説明",
                }.get(meta.get("type"), "追加")
        section = self.extract_section_by_id(self.index_html or "", section_id)
        if re.search(r'ここからグループ[a-z]', section or "", re.IGNORECASE):
            return "グループ"
        return "基本"

    def choose_section_background_by_id(self, section_id):
        if not section_id:
            messagebox.showwarning("警告", "セクションIDが見つかりません。")
            return
        path = filedialog.askopenfilename(
            title="セクション背景画像を選択",
            filetypes=[("画像ファイル", "*.jpg *.png *.gif *.webp *.jpeg")]
        )
        if not path:
            return
        current_src = self.get_section_background_src(section_id)
        try:
            final_path = self.save_processed_local_image(
                path,
                section_key=f"section_bg_{section_id}",
                current_src=current_src,
                for_css=True
            )
        except Exception as e:
            messagebox.showerror("画像加工失敗", str(e))
            return
        self.set_section_background_src(section_id, final_path)
        self.refresh_related_section_background_editors(section_id)
        self.refresh_nav_menu_tree()
        self.refresh_section_manager_if_open()

    def get_template_background_for_section_type(self, section_type):
        if section_type == "group":
            for section_id in ("gallery1", "gallery0"):
                src = self.get_css_section_background(section_id)
                if src:
                    return src
        if section_type == "special":
            return self.get_css_section_background("special")
        if section_type == "category":
            return self.get_css_section_background("menu")
        return ""

