        if menu_type == "header":
            visible_count = sum(
                1 for item in items
                if isinstance(item, dict) and (item.get("href", "").strip() or item.get("text", "").strip())
            )
            style = self.get_header_menu_layout_vars(visible_count)
            lines = [f'<nav id="header-menu" style="{style}">', '<ul>']
        else:
            lines = ['<div id="menubar">', '<nav>', '<ul>']
        for item in items:
            if not isinstance(item, dict):
                continue
            href = item.get("href", "").strip()
            text = item.get("text", "").strip()
            if not href and not text:
                continue
            lines.append(f'<li><a href="{href}">{text}</a></li>')
