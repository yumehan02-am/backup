    # ====================== 画像選択 ======================
    def choose_image(self, var, for_css=False, section_key="", current_src=""):
        path = filedialog.askopenfilename(title="新しい画像を選択", 
                                         filetypes=[("画像ファイル", "*.jpg *.png *.gif *.webp *.jpeg")])
        if not path: 
            return

        if self.images_dir and os.path.exists(self.images_dir):
            abs_images = os.path.abspath(self.images_dir)
            abs_selected = os.path.abspath(path)
            current_path = os.path.abspath(self.resolve_image_file_path(current_src)) if current_src else ""

            if abs_selected.startswith(abs_images + os.sep):
                if current_path and abs_selected == current_path:
                    rel = os.path.relpath(abs_selected, abs_images).replace(os.sep, "/")
                    final_path = f"images/{rel}"
                    if for_css:
                        final_path = "../" + final_path.replace("\\", "/")
                else:
                    try:
                        final_path = self.save_processed_local_image(
                            path,
                            section_key=section_key,
                            current_src=current_src,
                            for_css=for_css
                        )
                    except Exception as e:
                        messagebox.showerror("画像加工失敗", str(e))
                        return
            else:
                try:
                    final_path = self.save_processed_local_image(
                        path,
                        section_key=section_key,
                        current_src=current_src,
                        for_css=for_css
                    )
                except Exception as e:
                    messagebox.showerror("画像加工失敗", str(e))
                    return
        else:
            final_path = path

        var.set(final_path)

    # ====================== 保存 ======================
    def save_all_with_backup(self):
        self._save_core(backup=True)

    def save_all_overwrite(self):
        if not messagebox.askyesno("確認", "バックアップなしで上書き保存します。よろしいですか？"):
            return
        self._save_core(backup=False)

    def build_unsaved_preview_contents(self):
        state = {
            "index_html": self.index_html,
            "menu_html": self.menu_html,
            "css_content": self.css_content,
            "js_content": self.js_content,
            "sections": copy.deepcopy(self.sections),
            "custom_section_defs": copy.deepcopy(self.custom_section_defs),
            "section_headings": copy.deepcopy(self.section_headings),
        }
        try:
            self.apply_text_management_replaces()
            if self.index_html:
                self.rebuild_index()
            if self.menu_html:
                self.rebuild_menu()
            if self.js_content:
                self.rebuild_calendar_holidays()
            self.apply_background_replaces()
            self.apply_nav_menu_backgrounds_to_css()
            self.sync_gallery_css_selectors()
            self.sync_custom_section_css_selectors()
            self.sync_mobile_gallery_swipe_behavior()
            self.sync_header_menu_layout_css()
            return {
                "index_html": self.index_html or "",
                "css_content": self.css_content or "",
                "js_content": self.js_content or "",
            }
        finally:
            self.index_html = state["index_html"]
            self.menu_html = state["menu_html"]
            self.css_content = state["css_content"]
            self.js_content = state["js_content"]
            self.sections = state["sections"]
            self.custom_section_defs = state["custom_section_defs"]
            self.section_headings = state["section_headings"]

    def preview_unsaved(self):
        if not self.index_path or not self.index_html:
            messagebox.showwarning("警告", "先に index.html を読み込んでください。")
            return
        try:
            contents = self.build_unsaved_preview_contents()
            html_folder = os.path.dirname(self.index_path)
            preview_index = os.path.join(html_folder, "preview_index.html")
            preview_html = contents["index_html"]
            cache_buster = datetime.datetime.now().strftime("%Y%m%d%H%M%S")

            if self.css_path and contents["css_content"]:
                css_dir = os.path.dirname(self.css_path)
                os.makedirs(css_dir, exist_ok=True)
                preview_css = os.path.join(css_dir, "preview_style.css")
                with open(preview_css, "w", encoding="utf-8") as f:
                    f.write(contents["css_content"])
                preview_html = re.sub(
                    r'href=(["\'])css/style\.css(?:\?[^"\']*)?\1',
                    lambda _m: f'href="css/preview_style.css?v={cache_buster}"',
                    preview_html,
                    count=1,
                    flags=re.IGNORECASE
                )

            if self.js_path and contents["js_content"]:
                js_dir = os.path.dirname(self.js_path)
                os.makedirs(js_dir, exist_ok=True)
                preview_js = os.path.join(js_dir, "preview_main.js")
                with open(preview_js, "w", encoding="utf-8") as f:
                    f.write(contents["js_content"])
                preview_html = re.sub(
                    r'src=(["\'])js/main\.js(?:\?[^"\']*)?\1',
                    lambda _m: f'src="js/preview_main.js?v={cache_buster}"',
                    preview_html,
                    count=1,
                    flags=re.IGNORECASE
                )

            with open(preview_index, "w", encoding="utf-8") as f:
                f.write(preview_html)
            os.startfile(preview_index)
        except Exception as e:
            messagebox.showerror("プレビュー失敗", str(e))

    def create_html_folder_backup(self, timestamp):
        source_folder = self.get_html_folder()
        if not source_folder or not os.path.isdir(source_folder):
            return ""
        backup_root = os.path.join(SCRIPT_DIR, "backups")
        os.makedirs(backup_root, exist_ok=True)
        folder_name = os.path.basename(os.path.normpath(source_folder)) or "html_folder"
        backup_path = os.path.join(backup_root, f"{folder_name}_{timestamp}")
        counter = 2
        while os.path.exists(backup_path):
            backup_path = os.path.join(backup_root, f"{folder_name}_{timestamp}_{counter}")
            counter += 1

        excluded_dirs = {"images", "__pycache__"}
        excluded_exts = {".bak", ".tmp"}
        excluded_names = {"preview_index.html", "preview_style.css", "preview_main.js"}

        def ignore_func(_dir, names):
            ignored = []
            for name in names:
                lower = name.lower()
                if lower in excluded_dirs or lower in excluded_names:
                    ignored.append(name)
                elif os.path.splitext(lower)[1] in excluded_exts:
                    ignored.append(name)
            return ignored

        shutil.copytree(source_folder, backup_path, ignore=ignore_func)
        manifest = {
            "created_at": datetime.datetime.now().isoformat(timespec="seconds"),
            "source_folder": os.path.abspath(source_folder),
            "backup_path": os.path.abspath(backup_path),
            "excluded_dirs": sorted(excluded_dirs),
            "excluded_exts": sorted(excluded_exts),
            "excluded_names": sorted(excluded_names),
        }
        with open(os.path.join(backup_path, "backup_manifest.json"), "w", encoding="utf-8") as f:
            json.dump(manifest, f, ensure_ascii=False, indent=2)
        return backup_path

    def _save_core(self, backup=True):
        self.apply_text_management_replaces()
        if self.index_path:
            self.rebuild_index()
        if self.menu_path:
            self.rebuild_menu()
        if self.js_path:
            self.rebuild_calendar_holidays()
        self.apply_background_replaces()
        self.apply_nav_menu_backgrounds_to_css()
        self.sync_gallery_css_selectors()
        self.sync_custom_section_css_selectors()
        self.sync_mobile_gallery_swipe_behavior()
        self.sync_header_menu_layout_css()

        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_path = ""
        if backup:
            try:
                backup_path = self.create_html_folder_backup(timestamp)
            except Exception as e:
                messagebox.showerror("バックアップ失敗", f"HTMLフォルダのバックアップに失敗しました。\n保存は中止しました。\n\n{e}")
                return

        if self.index_path and self.index_html:
            with open(self.index_path, "w", encoding="utf-8") as f:
                f.write(self.index_html)

        if self.menu_path and self.menu_html:
            with open(self.menu_path, "w", encoding="utf-8") as f:
                f.write(self.menu_html)

        if self.css_path and self.css_content:
            with open(self.css_path, "w", encoding="utf-8") as f:
                f.write(self.css_content)

        if self.js_path and self.js_content:
            with open(self.js_path, "w", encoding="utf-8") as f:
                f.write(self.js_content)

        self.sync_background_originals()
        self.update_all_trees()
        self.clear_session_draft()
        self.save_settings()
        backup_msg = f"\nバックアップ: {backup_path}" if backup and backup_path else ""
        messagebox.showinfo("保存完了", "保存しました。" + backup_msg)

    def request_update_all_trees(self):
        if self.defer_tree_updates:
            self.tree_update_pending = True
            return
        self.update_all_trees()

    def update_all_trees(self, lazy_delay=150, immediate_only_primary=False):
        if not self.tree_widgets:
            return
        self.tree_update_pending = False
        self.refresh_all_heading_editors()
        self.refresh_all_section_background_editors()
        self.cancel_lazy_tree_render()
        self.rendered_sections.clear()
        visible_keys = [key for _title, key, _has_image in self.tab_info
                        if key in self.tree_widgets and self.is_section_tab_visible(key)]
        if not visible_keys:
            return
        primary_key = self.get_selected_section_key()
        if primary_key not in self.tree_widgets or not self.is_section_tab_visible(primary_key):
            primary_key = "group_a" if "group_a" in visible_keys else visible_keys[0]
        immediate_keys = [primary_key] if immediate_only_primary else self.get_immediate_render_keys(primary_key, visible_keys)
        for key in immediate_keys:
            self.render_section_tree(key)
        if immediate_only_primary:
            return
        remaining = [key for key in visible_keys if key not in immediate_keys]
        self.schedule_lazy_tree_render(remaining, delay=lazy_delay)

    def update_status(self):
        txt = []
        if self.index_path: txt.append(f"index: {os.path.basename(self.index_path)}")
        if self.menu_path: txt.append(f"menu: {os.path.basename(self.menu_path)}")
        if self.css_path: txt.append(f"css: {os.path.basename(self.css_path)}")
        if self.js_path: txt.append(f"js: {os.path.basename(self.js_path)}")
        if self.product_csv_path: txt.append(f"商品CSV: {os.path.basename(self.product_csv_path)} ({len(self.product_rows)}件)")
        self.status_label.config(
            text=" | ".join(txt) if txt else "未読み込み",
            foreground="green" if txt else "gray"
        )
        if self.index_path or self.menu_path or self.css_path or self.js_path:
            self.save_backup_btn.config(state="normal")
            self.save_overwrite_btn.config(state="normal")
        if self.index_path:
            self.preview_btn.config(state="normal")

    def on_close(self):
        if messagebox.askokcancel("終了", "編集を終了しますか？"):
            self.stop_repeat_action()
            self.cancel_lazy_tree_render()
            if self.thumbnail_refresh_after_id:
                try:
                    self.root.after_cancel(self.thumbnail_refresh_after_id)
                except tk.TclError:
                    pass
                self.thumbnail_refresh_after_id = None
            if self.product_add_refresh_after_id:
                try:
                    self.root.after_cancel(self.product_add_refresh_after_id)
                except tk.TclError:
                    pass
                self.product_add_refresh_after_id = None
            self.save_session_draft()
            self.save_settings()
            self.root.destroy()


