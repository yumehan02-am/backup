    # ====================== 設定 ======================
    def load_settings(self):
        defaults = {
            "auto_load_files": False,
            "auto_load_product_csv": False,
            "product_thumb_cache_max_mb": 200,
            "html_folder": "",
            "last_index_path": "",
            "last_menu_path": "",
            "last_css_path": "",
            "last_js_path": "",
            "product_csv_folder": "",
            "last_product_csv_path": "",
            "tab_order": []
        }
        try:
            if os.path.exists(SETTINGS_PATH):
                with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                defaults.update({k: loaded.get(k, v) for k, v in defaults.items()})
                if not loaded.get("product_csv_folder") and loaded.get("last_product_csv_path"):
                    defaults["product_csv_folder"] = os.path.dirname(loaded["last_product_csv_path"])
        except Exception:
            pass
        return defaults

    def save_settings(self):
        self.settings.update({
            "auto_load_files": self.auto_load_files,
            "auto_load_product_csv": self.auto_load_product_csv,
            "product_thumb_cache_max_mb": self.product_thumb_cache_max_mb,
            "html_folder": self.settings.get("html_folder", "") or self.get_loaded_html_folder(),
            "last_index_path": self.index_path or self.settings.get("last_index_path", ""),
            "last_menu_path": self.menu_path or self.settings.get("last_menu_path", ""),
            "last_css_path": self.css_path or self.settings.get("last_css_path", ""),
            "last_js_path": self.js_path or self.settings.get("last_js_path", ""),
            "product_csv_folder": self.settings.get("product_csv_folder", "") or self.get_loaded_product_csv_folder(),
            "last_product_csv_path": self.product_csv_path or self.settings.get("last_product_csv_path", "")
        })
        try:
            with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
                json.dump(self.settings, f, ensure_ascii=False, indent=2)
        except Exception as e:
            messagebox.showerror("設定保存失敗", str(e))

    def auto_load_recent_files(self):
        loaded_any = False
        self.defer_tree_updates = True
        self.tree_update_pending = False
        try:
            if self.settings.get("html_folder", ""):
                loaded_any = self.load_html_files_from_folder(silent=True) or loaded_any
            if self.auto_load_product_csv:
                loaded_any = self.load_latest_product_csv_from_folder(silent=True) or loaded_any
            if loaded_any:
                self.restore_session_draft()
        finally:
            self.defer_tree_updates = False
        if loaded_any:
            self.refresh_text_management()
            self.extract_backgrounds()
            self.update_tab_visibility()
            self.update_all_trees(lazy_delay=450, immediate_only_primary=True)
            self.update_status()

    def build_session_draft_payload(self):
        return {
            "draft_version": 2,
            "saved_at": datetime.datetime.now().isoformat(timespec="seconds"),
            "index_path": self.index_path or "",
            "menu_path": self.menu_path or "",
            "css_path": self.css_path or "",
            "js_path": self.js_path or "",
            "product_csv_path": self.product_csv_path or "",
            "index_html": self.index_html or "",
            "menu_html": self.menu_html or "",
            "css_content": self.css_content or "",
            "js_content": self.js_content or "",
            "sections": copy.deepcopy(self.sections),
            "custom_section_defs": copy.deepcopy(self.custom_section_defs),
            "section_headings": copy.deepcopy(self.section_headings),
        }

    def save_session_draft(self):
        if not (self.index_html or self.menu_html or self.css_content or self.js_content):
            return
        try:
            with open(SESSION_DRAFT_PATH, "w", encoding="utf-8") as f:
                json.dump(self.build_session_draft_payload(), f, ensure_ascii=False)
        except Exception as e:
            messagebox.showwarning("作業状態保存失敗", str(e))

    def clear_session_draft(self):
        try:
            if os.path.exists(SESSION_DRAFT_PATH):
                os.remove(SESSION_DRAFT_PATH)
        except OSError:
            pass

    def restore_session_draft(self):
        if not os.path.exists(SESSION_DRAFT_PATH):
            return False
        try:
            with open(SESSION_DRAFT_PATH, "r", encoding="utf-8") as f:
                draft = json.load(f)
        except Exception:
            return False
        if draft.get("index_path", "") and os.path.abspath(draft.get("index_path", "")) != os.path.abspath(self.index_path or ""):
            return False
        if draft.get("menu_path", "") and os.path.abspath(draft.get("menu_path", "")) != os.path.abspath(self.menu_path or ""):
            return False
        if draft.get("css_path", "") and os.path.abspath(draft.get("css_path", "")) != os.path.abspath(self.css_path or ""):
            return False
        if draft.get("js_path", "") and os.path.abspath(draft.get("js_path", "")) != os.path.abspath(self.js_path or ""):
            return False

        if draft.get("index_html"):
            self.index_html = draft.get("index_html", "")
            self.sections["index_text"] = self.extract_free_text(self.index_html)
            self.parse_index_sections()
        if draft.get("menu_html"):
            self.menu_html = draft.get("menu_html", "")
            self.sections["menu_text"] = self.extract_free_text(self.menu_html)
            self.parse_menu_sections()
        if draft.get("css_content"):
            self.css_content = draft.get("css_content", "")
            self.extract_css_backgrounds()
        if draft.get("js_content"):
            self.js_content = draft.get("js_content", "")
            self.parse_calendar_holidays()
        product_csv_path = draft.get("product_csv_path", "")
        if (product_csv_path and os.path.exists(product_csv_path) and
                os.path.abspath(product_csv_path) != os.path.abspath(self.product_csv_path or "")):
            self.load_product_csv(product_csv_path, silent=True)
        self.refresh_text_management()
        self.extract_backgrounds()
        saved_sections = draft.get("sections")
        if isinstance(saved_sections, dict):
            for key, value in saved_sections.items():
                if isinstance(value, list):
                    self.sections[key] = value
            if self.index_html:
                self.prune_stale_index_sections(self.active_index_group_keys, self.active_index_custom_keys)
        saved_custom_defs = draft.get("custom_section_defs")
        if isinstance(saved_custom_defs, list):
            if self.index_html:
                self.custom_section_defs = [
                    meta for meta in saved_custom_defs
                    if isinstance(meta, dict) and meta.get("key", "") in self.active_index_custom_keys
                ]
            else:
                self.custom_section_defs = saved_custom_defs
        saved_headings = draft.get("section_headings")
        if isinstance(saved_headings, dict):
            self.section_headings = saved_headings
            if self.index_html:
                self.prune_stale_index_sections(self.active_index_group_keys, self.active_index_custom_keys)
        self.sync_nav_menu_backgrounds_from_css()
        self.update_tab_visibility()
        self.request_update_all_trees()
        self.update_status()
        return True

    def get_html_folder(self):
        return self.settings.get("html_folder", "") or self.get_loaded_html_folder()

    def get_loaded_html_folder(self):
        folder = ""
        for path in (self.index_path, self.menu_path, self.css_path, self.js_path):
            if path:
                folder = os.path.dirname(path)
                break
        return folder

    def load_html_files_from_folder(self, silent=False):
        folder = self.settings.get("html_folder", "")
        if not folder or not os.path.isdir(folder):
            return False
        loaded_any = False
        index_path = self.find_file_in_folder(folder, "index.html")
        menu_path = self.find_file_in_folder(folder, "menu.html")
        css_path = self.find_file_in_folder(folder, "style.css")
        js_path = self.find_file_in_folder(folder, "main.js")
        loaded_any = self.load_index(index_path, silent=True) or loaded_any
        loaded_any = self.load_menu(menu_path, silent=True) or loaded_any
        loaded_any = self.load_css(css_path, silent=True) or loaded_any
        loaded_any = self.load_js(js_path, silent=True) or loaded_any
        if not loaded_any and not silent:
            messagebox.showwarning("警告", "HTMLフォルダー内とサブフォルダーに index.html / menu.html / style.css / main.js が見つかりません。")
        return loaded_any

    def find_file_in_folder(self, folder, filename):
        direct_path = os.path.join(folder, filename)
        if os.path.exists(direct_path):
            return direct_path
        target = filename.lower()
        matches = []
        for current_dir, _dirs, files in os.walk(folder):
            for name in files:
                if name.lower() == target:
                    path = os.path.join(current_dir, name)
                    try:
                        matches.append((path, os.path.getmtime(path)))
                    except OSError:
                        matches.append((path, 0))
        if not matches:
            return ""
        matches.sort(key=lambda item: (item[0].count(os.sep), -item[1], item[0].lower()))
        return matches[0][0]

    def format_windows_path(self, path):
        return os.path.normpath(path) if path else ""

    def get_product_csv_folder(self):
        return self.settings.get("product_csv_folder", "") or self.get_loaded_product_csv_folder()

    def get_loaded_product_csv_folder(self):
        folder = ""
        if self.product_csv_path:
            folder = os.path.dirname(self.product_csv_path)
        return folder

    def find_latest_product_csv(self):
        folder = self.settings.get("product_csv_folder", "")
        if not folder or not os.path.isdir(folder):
            return ""
        candidates = sorted(glob.glob(os.path.join(folder, "data*.csv")), key=os.path.getmtime, reverse=True)
        return candidates[0] if candidates else ""

    def load_latest_product_csv_from_folder(self, silent=False):
        latest = self.find_latest_product_csv()
        if not latest:
            if not silent:
                messagebox.showwarning("警告", "設定フォルダ内に data*.csv が見つかりません。")
            return False
        return self.load_product_csv(latest, silent=silent)

