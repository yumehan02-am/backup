    def create_thumbnail(self, src):
        if not src:
            return None
        if src.startswith(("http://", "https://")):
            thumb = self.create_url_thumbnail(src)
            if thumb:
                return thumb
            self.download_product_thumbnail(src, lambda: self.root.after(0, self.schedule_rendered_tree_refresh))
            return None
        if not self.images_dir:
            return None
        if src.startswith("images/") or src.startswith("images\\"):
            rel = src.replace("images/", "", 1).replace("images\\", "", 1)
            full_path = os.path.join(self.images_dir, rel)
        elif os.path.isabs(src):
            full_path = src
        else:
            full_path = os.path.join(self.images_dir, src)
        if not os.path.exists(full_path): return None
        try:
            img = Image.open(full_path)
            h = 70
            w = int(img.width * h / img.height)
            img = img.resize((w, h), Image.LANCZOS)
            return ImageTk.PhotoImage(img)
        except Exception:
            return None

    def move_items_up(self, tree, key):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"): return False
        return self._move_selected_items(tree, key, -1)

    def move_items_down(self, tree, key):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"): return False
        return self._move_selected_items(tree, key, 1)

    def _move_selected_items(self, tree, key, direction):
        selection = tree.selection()
        if not selection: return False
        data = self.sections[key]
        selected_pairs = sorted(((iid, tree.index(iid)) for iid in selection), key=lambda pair: pair[1])
        selected = [iid for iid, _idx in selected_pairs]
        if direction == -1:
            if selected_pairs[0][1] == 0:
                return False
            for iid, idx in selected_pairs:
                data[idx - 1], data[idx] = data[idx], data[idx - 1]
                tree.move(iid, "", idx - 1)
        else:
            if selected_pairs[-1][1] == len(data) - 1:
                return False
            for iid, idx in reversed(selected_pairs):
                data[idx], data[idx + 1] = data[idx + 1], data[idx]
                tree.move(iid, "", idx + 1)
        tree.selection_set(selected)
        if selected:
            tree.focus(selected[0])
            tree.see(selected[0])
        return True

