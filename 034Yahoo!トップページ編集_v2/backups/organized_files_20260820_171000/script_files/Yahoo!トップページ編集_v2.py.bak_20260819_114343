    def delete_item(self, tree, key):
        sel = tree.selection()
        if not sel: return
        if not key.startswith("group_") and not messagebox.askyesno("確認", f"{len(sel)} 個の項目を削除しますか？"):
            return
        if key == "background_management":
            for iid in sorted(sel, key=lambda row_id: tree.index(row_id), reverse=True):
                idx = tree.index(iid)
                if idx >= len(self.sections.get("background_management", [])):
                    continue
                combined = self.sections["background_management"][idx]
                source_item, source_key = self.get_background_source_item(combined)
                if source_item and source_key in self.sections:
                    try:
                        self.sections[source_key].remove(source_item)
                    except ValueError:
                        pass
            self.rebuild_background_management_section()
            self.populate_tree(tree, key, self.tree_info[key])
            return
        data = self.sections[key]
        indices_to_delete = [tree.index(iid) for iid in sel]
        for idx in sorted(set(indices_to_delete), reverse=True):
            if idx < len(data):
                del data[idx]
        self.populate_tree(tree, key, self.tree_info[key])
        if key.startswith("group_"):
            self.refresh_product_add_dialog()

