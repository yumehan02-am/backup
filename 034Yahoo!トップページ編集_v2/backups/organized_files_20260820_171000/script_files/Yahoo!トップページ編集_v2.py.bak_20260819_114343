                if (key.startswith(("group_", "special", "index_")) or key == "nav_menu") and has_index:
                    show = True
                elif key == "holiday_notice" and has_index:
                    show = True
                elif key == "calendar_holidays" and has_js:
                    show = True
                elif key.startswith("menu_") and has_menu:
                    show = True
                elif key in ("index_text", "menu_text", "text_management", "background_management") or key.startswith("custom_"):
                    show = True
