        load_frame.pack(fill="x", pady=(0, 10))
        auto_csv_var = tk.BooleanVar(value=self.auto_load_product_csv)
        html_folder_var = tk.StringVar(value=self.settings.get("html_folder", ""))
        csv_folder_var = tk.StringVar(value=self.settings.get("product_csv_folder", ""))
        ttk.Label(load_frame, text="HTMLフォルダーが設定されている場合、起動時に index.html / menu.html / style.css を自動で読み込みます。").pack(anchor="w")
        html_folder_row = ttk.Frame(load_frame)
        html_folder_row.pack(fill="x", pady=(8, 0))
        ttk.Label(html_folder_row, text="HTMLフォルダー:").pack(side="left")
        ttk.Entry(html_folder_row, textvariable=html_folder_var, font=self.default_font).pack(side="left", fill="x", expand=True, padx=6)
        ttk.Button(html_folder_row, text="参照", command=lambda: choose_html_folder()).pack(side="left", padx=2)
        ttk.Button(html_folder_row, text="反映", command=lambda: load_html_from_settings()).pack(side="left", padx=2)
        ttk.Checkbutton(load_frame, text="商品CSVフォルダー内の最新 data*.csv を自動で読み込む", variable=auto_csv_var).pack(anchor="w", pady=(10, 0))
        csv_folder_row = ttk.Frame(load_frame)
        csv_folder_row.pack(fill="x", pady=(8, 0))
        ttk.Label(csv_folder_row, text="商品CSVフォルダー:").pack(side="left")
        ttk.Entry(csv_folder_row, textvariable=csv_folder_var, font=self.default_font).pack(side="left", fill="x", expand=True, padx=6)
        ttk.Button(csv_folder_row, text="参照", command=lambda: choose_csv_folder()).pack(side="left", padx=2)
        ttk.Button(csv_folder_row, text="反映", command=lambda: load_latest_from_settings()).pack(side="left", padx=2)

        path_frame = ttk.LabelFrame(main, text="前回読み込んだファイル", padding=10)
        path_frame.pack(fill="x", pady=(0, 10))
        path_text = tk.Text(path_frame, height=6, wrap="none", font=("MS Gothic", 10))
        path_text.pack(fill="x")

        cache_frame = ttk.LabelFrame(main, text="商品サムネ画像キャッシュ", padding=10)
        cache_frame.pack(fill="x", pady=(0, 10))
        cache_info_var = tk.StringVar()
        progress_var = tk.StringVar(value="")
        cache_progress_var = tk.DoubleVar(value=0)
        max_mb_var = tk.StringVar(value=str(self.product_thumb_cache_max_mb))

        info_row = ttk.Frame(cache_frame)
        info_row.pack(fill="x", pady=(0, 6))
        ttk.Label(info_row, textvariable=cache_info_var).pack(side="left")
        ttk.Button(info_row, text="更新", command=lambda: refresh_cache_info()).pack(side="right")

        progress_row = ttk.Frame(cache_frame)
        progress_row.pack(fill="x", pady=(0, 6))
        ttk.Progressbar(progress_row, variable=cache_progress_var, maximum=100).pack(side="left", fill="x", expand=True)
        ttk.Label(progress_row, textvariable=progress_var, foreground="gray", width=38, anchor="w").pack(side="left", padx=8)

        limit_row = ttk.Frame(cache_frame)
        limit_row.pack(fill="x", pady=4)
        ttk.Label(limit_row, text="最大容量(MB):").pack(side="left")
        ttk.Entry(limit_row, textvariable=max_mb_var, width=8, font=self.default_font).pack(side="left", padx=6)
        ttk.Button(limit_row, text="最大容量を適用して整理", command=lambda: apply_cache_limit()).pack(side="left", padx=4)
        ttk.Label(limit_row, textvariable=progress_var, foreground="gray").pack(side="left", padx=12)

        btn_row = ttk.Frame(cache_frame)
        btn_row.pack(fill="x", pady=(6, 0))
        ttk.Button(btn_row, text="メモリキャッシュをクリア", command=lambda: clear_memory_cache()).pack(side="left", padx=4)
        ttk.Button(btn_row, text="ディスクキャッシュを削除", command=lambda: clear_disk_cache()).pack(side="left", padx=4)
        cache_button = ttk.Button(btn_row, text="商品CSVの画像を一括キャッシュ")
        cache_button.pack(side="left", padx=4)
        cache_button.configure(command=lambda: cache_product_csv_images(progress_var, cache_progress_var, cache_button, refresh_cache_info))
        ttk.Button(btn_row, text="画像フォルダ管理", command=self.open_image_folder_manager).pack(side="left", padx=4)

        bottom = ttk.Frame(main)
        bottom.pack(fill="x", side="bottom")

        def refresh_cache_info():
            files, size = self.get_product_thumb_cache_stats()
            cache_info_var.set(f"保存先: {self.product_thumb_dir} / {files} ファイル / {self.format_bytes(size)}")

        def refresh_path_text():
            path_text.configure(state="normal")
            path_text.delete("1.0", tk.END)
            path_text.insert(tk.END, f"インデックス ファイル: {self.format_windows_path(self.settings.get('last_index_path', ''))}\n")
            path_text.insert(tk.END, f"メニュー ファイル    : {self.format_windows_path(self.settings.get('last_menu_path', ''))}\n")
            path_text.insert(tk.END, f"スタイル シート      : {self.format_windows_path(self.settings.get('last_css_path', ''))}\n")
            path_text.insert(tk.END, f"HTML フォルダー      : {self.format_windows_path(self.settings.get('html_folder', ''))}\n")
            path_text.insert(tk.END, f"商品CSV フォルダー   : {self.format_windows_path(self.settings.get('product_csv_folder', ''))}\n")
            path_text.insert(tk.END, f"商品CSV ファイル     : {self.format_windows_path(self.settings.get('last_product_csv_path', ''))}\n")
            path_text.configure(state="disabled")

        def choose_html_folder():
            folder = filedialog.askdirectory(
                title="HTMLフォルダーを選択",
                initialdir=html_folder_var.get() if os.path.isdir(html_folder_var.get()) else SCRIPT_DIR
            )
            if folder:
                html_folder_var.set(folder)

        def choose_csv_folder():
            folder = filedialog.askdirectory(
                title="商品CSVフォルダーを選択",
                initialdir=csv_folder_var.get() if os.path.isdir(csv_folder_var.get()) else SCRIPT_DIR
            )
            if folder:
                csv_folder_var.set(folder)

        def sync_html_folder_setting():
            folder = html_folder_var.get().strip()
            self.settings["html_folder"] = os.path.abspath(folder) if folder else ""

        def sync_csv_folder_setting():
            folder = csv_folder_var.get().strip()
            self.settings["product_csv_folder"] = os.path.abspath(folder) if folder else ""

        def load_html_from_settings():
            sync_html_folder_setting()
            if self.load_html_files_from_folder():
                refresh_path_text()
                messagebox.showinfo("読込完了", "HTMLフォルダーから必要ファイルを読み込みました。")

        def load_latest_from_settings():
            sync_csv_folder_setting()
            if self.load_latest_product_csv_from_folder():
                refresh_path_text()
                messagebox.showinfo("読込完了", f"最新の商品CSVを読み込みました。\n{self.product_csv_path}")

        def reload_from_settings():
            if not apply_settings(show_done=False):
                return
            loaded = False
            if self.settings.get("html_folder", ""):
                loaded = self.load_html_files_from_folder(silent=True) or loaded
            if self.auto_load_product_csv:
                loaded = self.load_latest_product_csv_from_folder(silent=True) or loaded
            refresh_cache_info()
            refresh_path_text()
            self.update_status()
            messagebox.showinfo("再読込完了", "設定内容を保存して再読込しました。" if loaded else "設定内容を保存しました。読み込めるファイルはありませんでした。")

        def apply_settings(show_done=True):
            try:
                self.product_thumb_cache_max_mb = max(1, int(max_mb_var.get().strip()))
            except ValueError:
                messagebox.showwarning("警告", "最大容量は数値で入力してください。")
                return False
            self.auto_load_files = bool(html_folder_var.get().strip())
            self.auto_load_product_csv = auto_csv_var.get()
            sync_html_folder_setting()
            sync_csv_folder_setting()
            self.save_settings()
            self.cleanup_product_thumb_cache()
            refresh_cache_info()
            refresh_path_text()
            if show_done:
                messagebox.showinfo("保存完了", "設定を保存しました。")
            return True

        def apply_cache_limit():
            try:
                self.product_thumb_cache_max_mb = max(1, int(max_mb_var.get().strip()))
            except ValueError:
                messagebox.showwarning("警告", "最大容量は数値で入力してください。")
                return
            self.cleanup_product_thumb_cache()
            self.save_settings()
            refresh_cache_info()

        def clear_memory_cache():
            self.product_thumb_cache.clear()
            self.product_thumb_failed.clear()
            messagebox.showinfo("完了", "メモリ上のサムネキャッシュをクリアしました。")

        def clear_disk_cache():
            if not messagebox.askyesno("確認", "商品サムネのディスクキャッシュを削除しますか？"):
                return
            self.product_thumb_cache.clear()
            self.product_thumb_failed.clear()
            try:
                if os.path.isdir(self.product_thumb_dir):
                    shutil.rmtree(self.product_thumb_dir)
                os.makedirs(self.product_thumb_dir, exist_ok=True)
                refresh_cache_info()
                messagebox.showinfo("完了", "ディスクキャッシュを削除しました。")
            except Exception as e:
                messagebox.showerror("削除失敗", str(e))

        ttk.Button(bottom, text="保存", command=apply_settings).pack(side="right", padx=4)
        ttk.Button(bottom, text="再読込", command=reload_from_settings).pack(side="right", padx=4)
        ttk.Button(bottom, text="閉じる", command=dlg.destroy).pack(side="right", padx=4)
        refresh_cache_info()
        refresh_path_text()

    def get_product_thumb_cache_stats(self):
        total = 0
        count = 0
        if not os.path.isdir(self.product_thumb_dir):
            return 0, 0
        for name in os.listdir(self.product_thumb_dir):
            path = os.path.join(self.product_thumb_dir, name)
            if os.path.isfile(path):
                count += 1
                try:
                    total += os.path.getsize(path)
                except OSError:
                    pass
        return count, total

    def format_bytes(self, value):
        if value >= 1024 * 1024:
            return f"{value / (1024 * 1024):.1f} MB"
        if value >= 1024:
            return f"{value / 1024:.1f} KB"
        return f"{value} B"

    def cleanup_product_thumb_cache(self):
        if not os.path.isdir(self.product_thumb_dir):
            return
        max_bytes = self.product_thumb_cache_max_mb * 1024 * 1024
        files = []
        total = 0
        for name in os.listdir(self.product_thumb_dir):
            path = os.path.join(self.product_thumb_dir, name)
            if not os.path.isfile(path):
                continue
            try:
                size = os.path.getsize(path)
                total += size
                files.append((path, os.path.getmtime(path), size))
            except OSError:
                continue
        files.sort(key=lambda item: item[1])
        for path, _mtime, size in files:
            if total <= max_bytes:
                break
            try:
                os.remove(path)
                total -= size
            except OSError:
                pass

    def cache_product_csv_images(self, progress_var, progressbar_var=None, button=None, on_done=None):
        if not self.ensure_product_csv_loaded():
            return
        urls = []
        seen = set()
        for row in self.product_rows:
            src = row.get("src", "")
            if src.startswith(("http://", "https://")) and src not in seen:
                seen.add(src)
                urls.append(src)
        if not urls:
            messagebox.showwarning("警告", "キャッシュ対象の画像URLがありません。")
            return
        total = len(urls)
        progress_var.set(f"開始 0/{total}")
        if progressbar_var is not None:
            progressbar_var.set(0)
        if button is not None:
            button.configure(state="disabled")

        def update_progress(done, saved, skipped, failed, current=""):
            percent = (done / total * 100) if total else 0
            progress_var.set(f"{done}/{total} 保存{saved} 既存{skipped} 失敗{failed} {current}")
            if progressbar_var is not None:
                progressbar_var.set(percent)

        def worker():
            os.makedirs(self.product_thumb_dir, exist_ok=True)
            done = 0
            saved = 0
            skipped = 0
            failed = 0
            for src in urls:
                code = self.extract_code_from_href(src) or os.path.basename(src).split(".")[0][:16]
                try:
                    path = self.get_product_thumb_cache_path(src)
                    if path and os.path.exists(path):
                        skipped += 1
                    elif path:
                        req = urllib.request.Request(src, headers={"User-Agent": "Mozilla/5.0"})
                        with urllib.request.urlopen(req, timeout=12) as response:
                            data = response.read()
                        with open(path, "wb") as f:
                            f.write(data)
                        saved += 1
                    else:
                        failed += 1
                except Exception:
                    failed += 1
                done += 1
                self.root.after(0, lambda d=done, s=saved, k=skipped, f=failed, c=code: update_progress(d, s, k, f, c))
            self.cleanup_product_thumb_cache()
            if on_done:
                self.root.after(0, on_done)
            def finish():
                update_progress(done, saved, skipped, failed, "完了")
                if button is not None:
                    button.configure(state="normal")
                messagebox.showinfo("完了", f"商品画像の一括キャッシュが完了しました。\n保存: {saved}\n既存: {skipped}\n失敗: {failed}")
            self.root.after(0, finish)

        threading.Thread(target=worker, daemon=True).start()

    def open_image_folder_manager(self):
        if not self.images_dir or not os.path.isdir(self.images_dir):
            messagebox.showwarning("警告", "images フォルダが見つかりません。先にHTMLフォルダーを読み込んでください。")
            return

        dlg = tk.Toplevel(self.root)
        dlg.title("画像フォルダ管理")
        dlg.geometry("980x620")
        dlg.transient(self.root)

        top = ttk.Frame(dlg, padding=8)
        top.pack(fill="x")
        unused_only_var = tk.BooleanVar(value=False)
        status_var = tk.StringVar(value="")
        ttk.Label(top, text=f"対象: {self.images_dir}", font=self.default_font, wraplength=930).pack(anchor="w")

        tree_frame = ttk.Frame(dlg, padding=(8, 0, 8, 8))
        tree_frame.pack(fill="both", expand=True)
        tree = ttk.Treeview(
            tree_frame,
            columns=("file", "size", "bytes", "status", "used_in"),
            show="tree headings",
            height=18
        )
        tree.heading("#0", text="画像")
        tree.heading("file", text="ファイル名")
        tree.heading("size", text="画像サイズ")
        tree.heading("bytes", text="容量")
        tree.heading("status", text="状態")
        tree.heading("used_in", text="使用場所")
        tree.column("#0", width=90, anchor="center")
        tree.column("file", width=220)
        tree.column("size", width=100, anchor="center")
        tree.column("bytes", width=90, anchor="e")
        tree.column("status", width=80, anchor="center")
        tree.column("used_in", width=360)
        ybar = ttk.Scrollbar(tree_frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=ybar.set)
        tree.pack(side="left", fill="both", expand=True)
        ybar.pack(side="right", fill="y")

        bottom = ttk.Frame(dlg, padding=(8, 0, 8, 8))
        bottom.pack(fill="x")
        ttk.Label(bottom, textvariable=status_var, foreground="gray").pack(side="left")
        ttk.Checkbutton(bottom, text="未使用のみ", variable=unused_only_var, command=lambda: refresh_list()).pack(side="right", padx=6)
        ttk.Button(bottom, text="更新", command=lambda: refresh_list()).pack(side="right", padx=4)
        ttk.Button(bottom, text="選択した未使用画像を退避", command=lambda: move_selected_unused()).pack(side="right", padx=4)
        ttk.Button(bottom, text="閉じる", command=dlg.destroy).pack(side="right")

        thumbs = []
        records = {}

        def normalize_image_ref(ref):
            ref = str(ref or "").strip().replace("\\", "/")
            if not ref:
                return ""
            ref = ref.split("#", 1)[0].split("?", 1)[0]
            m = re.search(r'(?:^|[./])images/(.+)$', ref, re.IGNORECASE)
            if m:
                return m.group(1).lstrip("/")
            if not ref.startswith(("http://", "https://")) and os.path.basename(ref) == ref:
                return ref
            return ""

        def collect_used_images():
            used = {}

            def add(ref, place):
                rel = normalize_image_ref(ref)
                if rel:
                    used.setdefault(rel.lower(), set()).add(place)

            html_patterns = [
                (self.index_html, "index.html"),
                (self.menu_html, "menu.html"),
            ]
            for content, place in html_patterns:
                if not content:
                    continue
                for src in re.findall(r'src=["\']([^"\']+)["\']', content, re.IGNORECASE):
                    add(src, place)
            if self.css_content:
                for src in re.findall(r'url\(["\']?([^"\')]+)["\']?\)', self.css_content, re.IGNORECASE):
                    add(src, "style.css")
            section_names = {
                "group_a": "グループA",
                "group_b": "グループB",
                "group_c": "グループC",
                "group_d": "グループD",
                "special": "special",
                "index_menu_banners": "indexカテゴリ",
                "menu_banners": "menuカテゴリ",
                "index_backgrounds": "index背景",
                "menu_backgrounds": "menu背景",
                "css_backgrounds": "CSS背景",
            }
            for key, label in section_names.items():
                for item in self.sections.get(key, []):
                    if isinstance(item, dict):
                        add(item.get("src", ""), label)
                        add(item.get("original_src", ""), label)
            return used

        def make_thumb(path):
            try:
                img = Image.open(path)
                img.thumbnail((72, 72), Image.LANCZOS)
                return ImageTk.PhotoImage(img.copy())
            except Exception:
                return None

        def scan_images():
            used = collect_used_images()
            rows = []
            for root_dir, _dirs, files in os.walk(self.images_dir):
                for name in files:
                    if not re.search(r'\.(jpg|jpeg|png|gif|webp)$', name, re.IGNORECASE):
                        continue
                    path = os.path.join(root_dir, name)
                    rel = os.path.relpath(path, self.images_dir).replace(os.sep, "/")
                    places = sorted(used.get(rel.lower(), set()))
                    try:
                        with Image.open(path) as img:
                            dims = f"{img.width}x{img.height}"
                    except Exception:
                        dims = "不明"
                    try:
                        size_text = self.format_bytes(os.path.getsize(path))
                    except OSError:
                        size_text = ""
                    rows.append({
                        "path": path,
                        "rel": rel,
                        "dims": dims,
                        "size": size_text,
                        "used": bool(places),
                        "used_in": ", ".join(places)
                    })
            rows.sort(key=lambda row: (row["used"], row["rel"].lower()))
            return rows

        def refresh_list():
            for iid in tree.get_children():
                tree.delete(iid)
            thumbs.clear()
            records.clear()
            rows = scan_images()
            shown = 0
            for row in rows:
                if unused_only_var.get() and row["used"]:
                    continue
                photo = make_thumb(row["path"])
                image_kw = {"image": photo} if photo else {}
                if photo:
                    thumbs.append(photo)
                iid = tree.insert(
                    "",
                    "end",
                    text="",
                    **image_kw,
                    values=(row["rel"], row["dims"], row["size"], "使用中" if row["used"] else "未使用", row["used_in"])
                )
                records[iid] = row
                shown += 1
            used_count = sum(1 for row in rows if row["used"])
            unused_count = len(rows) - used_count
            status_var.set(f"表示 {shown} 件 / 全 {len(rows)} 件 / 使用中 {used_count} 件 / 未使用 {unused_count} 件")

        def move_selected_unused():
            selection = tree.selection()
            if not selection:
                messagebox.showwarning("警告", "退避する未使用画像を選択してください。")
                return
            targets = [records[iid] for iid in selection if iid in records and not records[iid]["used"]]
            skipped = len(selection) - len(targets)
            if not targets:
                messagebox.showwarning("警告", "選択画像は使用中のため退避できません。")
                return
            if not messagebox.askyesno("確認", f"未使用画像 {len(targets)} 件を退避しますか？" + (f"\n使用中 {skipped} 件は除外します。" if skipped else "")):
                return
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_dir = os.path.join(os.path.dirname(self.images_dir), f"images_unused_backup_{timestamp}")
            moved = 0
            try:
                for row in targets:
                    src = os.path.abspath(row["path"])
                    if not src.startswith(os.path.abspath(self.images_dir) + os.sep):
                        continue
                    dest = os.path.join(backup_dir, row["rel"])
                    os.makedirs(os.path.dirname(dest), exist_ok=True)
                    shutil.move(src, dest)
                    moved += 1
            except Exception as e:
                messagebox.showerror("退避失敗", str(e))
            refresh_list()
            messagebox.showinfo("退避完了", f"{moved} 件を退避しました。\n退避先: {backup_dir}")

        refresh_list()

    # ====================== 読み込み ======================
    def load_index(self, path=None, silent=False):
        if not path:
            path = filedialog.askopenfilename(title="index.html を選択", filetypes=[("HTMLファイル", "*.html")])
        if not path or not os.path.exists(path): return False
        try:
            self.index_path = os.path.abspath(path)
            self.images_dir = os.path.join(os.path.dirname(self.index_path), "images")
            with open(self.index_path, encoding="utf-8") as f:
                self.index_html = f.read()
            self.sections["index_text"] = self.extract_free_text(self.index_html)
            self.parse_index_sections()
            self.refresh_text_management()
            self.extract_backgrounds()
            self.ensure_tabs()
            self.update_tab_visibility()
            self.update_all_trees()
            self.update_status()
            self.save_settings()
            return True
        except Exception as e:
            if not silent:
                messagebox.showerror("index.html 読み込み失敗", str(e))
            return False

    def load_menu(self, path=None, silent=False):
        if not path:
            path = filedialog.askopenfilename(title="menu.html を選択", filetypes=[("HTMLファイル", "*.html")])
        if not path or not os.path.exists(path): return False
        try:
            self.menu_path = os.path.abspath(path)
            if not self.images_dir:
                self.images_dir = os.path.join(os.path.dirname(self.menu_path), "images")
            with open(self.menu_path, encoding="utf-8") as f:
                self.menu_html = f.read()
            self.sections["menu_text"] = self.extract_free_text(self.menu_html)
            self.parse_menu_sections()
            self.refresh_text_management()
            self.extract_backgrounds()
            self.ensure_tabs()
            self.update_tab_visibility()
            self.update_all_trees()
            self.update_status()
            self.save_settings()
            return True
        except Exception as e:
            if not silent:
                messagebox.showerror("menu.html 読み込み失敗", str(e))
            return False

    def load_css(self, path=None, silent=False):
        if not path:
            path = filedialog.askopenfilename(title="style.css を選択", filetypes=[("CSSファイル", "*.css")])
        if not path or not os.path.exists(path): return False
        try:
            self.css_path = os.path.abspath(path)
            with open(self.css_path, encoding="utf-8") as f:
                self.css_content = f.read()
            self.extract_css_backgrounds()
            self.ensure_tabs()
            self.update_tab_visibility()
            self.update_all_trees()
            self.update_status()
            self.save_settings()
            return True
        except Exception as e:
            if not silent:
                messagebox.showerror("style.css 読み込み失敗", str(e))
            return False

    def load_product_csv(self, path=None, silent=False):
        if not path:
            path = filedialog.askopenfilename(
                title="Yahoo!商品CSVを選択",
                initialdir=SCRIPT_DIR,
                filetypes=[("CSVファイル", "*.csv")]
            )
        if not path or not os.path.exists(path):
            return False
        try:
            rows = self.read_product_csv(path)
            self.product_rows = [self.normalize_product_row(row) for row in rows]
            self.product_rows = [row for row in self.product_rows if row.get("code") or row.get("name")]
            self.rebuild_product_lookup()
            self.product_csv_path = os.path.abspath(path)
            self.settings["product_csv_folder"] = os.path.dirname(self.product_csv_path)
            self.update_all_trees()
            self.update_status()
            self.save_settings()
            if not silent:
                messagebox.showinfo("商品CSV 読み込み完了", f"{len(self.product_rows)} 件の商品を読み込みました。")
            return True
        except Exception as e:
            if not silent:
                messagebox.showerror("商品CSV 読み込み失敗", str(e))
            return False

    def read_product_csv(self, path):
        last_error = None
        for encoding in ("cp932", "shift-jis", "utf-8-sig", "utf-8"):
            try:
                with open(path, newline="", encoding=encoding) as f:
                    return list(csv.DictReader(f))
            except UnicodeDecodeError as e:
                last_error = e
        raise last_error if last_error else ValueError("CSVを読み込めませんでした。")

    def normalize_product_row(self, row):
        cleaned = {str(k).strip(): ("" if v is None else str(v).strip()) for k, v in row.items() if k is not None}
        code = cleaned.get("code", "")
        name = cleaned.get("name", "")
        image_urls = cleaned.get("item-image-urls", "")
        image = self.get_first_product_image(image_urls)
        href = DEFAULT_STORE_URL.format(code=code) if code else ""
        return {
            "code": code,
            "name": name,
            "path": cleaned.get("path", ""),
            "href": href,
            "src": image,
            "text": name,
            "badge": "",
            "search": f"{code} {name} {cleaned.get('path', '')}".lower()
        }

    def rebuild_product_lookup(self):
        self.product_name_by_code = {}
        self.product_name_by_href = {}
        for row in self.product_rows:
            name = row.get("name", "")
            if not name:
                continue
            code = row.get("code", "")
            href = row.get("href", "")
            if code:
                self.product_name_by_code[code] = name
            if href:
                self.product_name_by_href[href] = name

    def get_product_name_for_display(self, item):
        if not isinstance(item, dict):
            return ""
        href = item.get("href", "")
        if href in self.product_name_by_href:
            return self.product_name_by_href[href]
        code = self.extract_code_from_href(href)
        if code and code in self.product_name_by_code:
            return self.product_name_by_code[code]
        return item.get("text", "")

    def get_image_resolution_text(self, src):
        if not src:
            return ""
        path = ""
        if src.startswith(("http://", "https://")):
            path = self.get_product_thumb_cache_path(src)
        elif self.images_dir:
            if src.startswith("images/") or src.startswith("images\\"):
                rel = src.replace("images/", "", 1).replace("images\\", "", 1)
                path = os.path.join(self.images_dir, rel)
            elif os.path.isabs(src):
                path = src
            else:
                path = os.path.join(self.images_dir, src)
        if not path or not os.path.exists(path):
            return ""
        try:
            with Image.open(path) as img:
                return f"{img.width}x{img.height}"
        except Exception:
            return ""

    def extract_code_from_href(self, href):
        if not href:
            return ""
        m = re.search(r'/([^/?#]+)\.html(?:[?#].*)?$', href)
        return m.group(1) if m else ""

    def get_group_letter_from_key(self, key):
        return key.replace("group_", "", 1) if key.startswith("group_") else ""

    def get_group_key(self, letter):
        return f"group_{letter.lower()}"

    def get_group_keys(self):
        keys = [key for key in self.sections.keys() if key.startswith("group_")]
        return sorted(keys, key=lambda key: self.get_group_letter_from_key(key))

    def get_group_badge(self, group_key):
        if group_key in GROUP_BADGES:
            return GROUP_BADGES[group_key]
        letter = self.get_group_letter_from_key(group_key).upper()
        index = max(0, ord(letter[:1] or "A") - ord("A"))
        bg, fg = GROUP_COLOR_PALETTE[index % len(GROUP_COLOR_PALETTE)]
        return letter, bg, fg

    def get_group_display_name(self, group_key):
        letter = self.get_group_letter_from_key(group_key).upper()
        return f"グループ{letter}" if letter else group_key

    def get_next_group_image_relpath(self, group_key):
        if not self.images_dir:
            return ""
        group_letter = self.get_group_letter_from_key(group_key)
        if not group_letter:
            return ""
        os.makedirs(self.images_dir, exist_ok=True)
        used_numbers = set()
        pattern = re.compile(rf'^item-{re.escape(group_letter)}(\d+)\.(?:jpg|jpeg|png|webp)$', re.IGNORECASE)
        for name in os.listdir(self.images_dir):
            match = pattern.match(name)
            if match:
                try:
                    used_numbers.add(int(match.group(1)))
                except ValueError:
                    pass
        for item in self.sections.get(group_key, []):
            if not isinstance(item, dict):
                continue
            src = item.get("src", "").replace("\\", "/")
            match = re.search(rf'images/item-{re.escape(group_letter)}(\d+)\.(?:jpg|jpeg|png|webp)$', src, re.IGNORECASE)
            if match:
                try:
                    used_numbers.add(int(match.group(1)))
                except ValueError:
                    pass
        number = 1
        while number in used_numbers:
            number += 1
        return f"images/item-{group_letter}{number}.jpg"

    def prepare_group_image_from_product(self, row, group_key):
        src = row.get("src", "")
        if not src:
            raise ValueError("商品画像URLがありません。")
        if not self.images_dir:
            raise ValueError("images フォルダが未設定です。先に index.html または menu.html を読み込んでください。")
        if not src.startswith(("http://", "https://")):
            return src
        rel_path = self.get_next_group_image_relpath(group_key)
        if not rel_path:
            raise ValueError("保存先画像ファイル名を作成できませんでした。")
        dest_path = os.path.join(self.images_dir, rel_path.replace("images/", "", 1))
        if os.path.exists(dest_path):
            return rel_path
        source_path = self.get_product_thumb_cache_path(src)
        if not source_path or not os.path.exists(source_path):
            os.makedirs(self.product_thumb_dir, exist_ok=True)
            req = urllib.request.Request(src, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=20) as response:
                data = response.read()
            source_path = self.get_product_thumb_cache_path(src)
            with open(source_path, "wb") as f:
                f.write(data)
        os.makedirs(os.path.dirname(dest_path), exist_ok=True)
        with Image.open(source_path) as img:
            img = img.convert("RGB")
            img.thumbnail((563, 563), Image.LANCZOS)
            canvas_img = Image.new("RGB", (563, 563), "white")
            x = (563 - img.width) // 2
            y = (563 - img.height) // 2
            canvas_img.paste(img, (x, y))
            canvas_img.save(dest_path, "JPEG", quality=92, optimize=True)
        return rel_path

    def get_group_memberships_for_product(self, row):
        row_keys = {
            row.get("code", ""),
            row.get("href", ""),
            row.get("src", ""),
        }
        row_keys.discard("")
        memberships = []
        for group_key in self.get_group_keys():
            for item in self.sections.get(group_key, []):
                if not isinstance(item, dict):
                    continue
                href = item.get("href", "")
                src = item.get("src", "")
                code = self.extract_code_from_href(href)
                item_keys = {href, src, code}
                item_keys.discard("")
                if row_keys & item_keys:
                    memberships.append(group_key)
                    break
        return memberships

    def wrap_display_text(self, text, width=24, max_lines=3):
        text = str(text or "").strip()
        if not text:
            return ""
        lines = []
        current = ""
        for char in text:
            current += char
            if len(current) >= width:
                lines.append(current)
                current = ""
                if len(lines) >= max_lines:
                    break
        if current and len(lines) < max_lines:
            lines.append(current)
        wrapped = "\n".join(lines)
        if len(text) > width * max_lines:
            wrapped = wrapped.rstrip() + "..."
        return wrapped

    def get_first_product_image(self, image_urls):
        if not image_urls:
            return ""
        for part in re.split(r'[;\r\n]+', image_urls):
            part = part.strip()
            if part:
                return part
        return ""

    def ensure_product_csv_loaded(self):
        if self.product_rows:
            return True
        if self.load_latest_product_csv_from_folder(silent=True):
            return True
        return self.load_product_csv()

    def update_tab_visibility(self):
        has_index = bool(self.index_html)
        has_menu = bool(self.menu_html)
        for title, key, _ in self.tab_info:
            if key in self.tab_frames:
                frame = self.tab_frames[key]
                show = False
                if (key.startswith(("group_", "special", "index_")) or key == "nav_menu") and has_index:
                    show = True
                elif key.startswith("menu_") and has_menu:
                    show = True
                elif key in ("index_text", "menu_text", "text_management", "index_backgrounds", "menu_backgrounds", "css_backgrounds") or key.startswith("custom_"):
                    show = True
                self.notebook.tab(frame, state="normal" if show else "hidden")

    def get_selected_section_key(self):
        selected = self.notebook.select()
        for key, frame in self.tab_frames.items():
            if str(frame) == str(selected):
                return key
        return "group_a" if "group_a" in self.tree_widgets else ""

    def is_section_tab_visible(self, key):
        frame = self.tab_frames.get(key)
        if not frame:
            return False
        try:
            return self.notebook.tab(frame, "state") != "hidden"
        except tk.TclError:
            return False

    def render_section_tree(self, key):
        tree = self.tree_widgets.get(key)
        if not tree:
            return
        self.populate_tree(tree, key, self.tree_info.get(key, True))

    def get_immediate_render_keys(self, primary_key, visible_keys):
        immediate_order = [
            primary_key,
            "special",
            "index_menu_banners",
            "menu_banners",
            "menu_bottom_links",
            "nav_menu",
            "text_management",
        ]
        keys = []
        for key in immediate_order:
            if key and key in visible_keys and key not in keys:
                keys.append(key)
        return keys

    def cancel_lazy_tree_render(self):
        if self.lazy_render_after_id:
            try:
                self.root.after_cancel(self.lazy_render_after_id)
            except tk.TclError:
                pass
            self.lazy_render_after_id = None

    def schedule_lazy_tree_render(self, keys, delay=150):
        self.cancel_lazy_tree_render()
        queue = [key for key in keys if key in self.tree_widgets and self.is_section_tab_visible(key)]

        def render_next():
            self.lazy_render_after_id = None
            while queue and queue[0] in self.rendered_sections:
                queue.pop(0)
            if not queue:
                return
            key = queue.pop(0)
            self.render_section_tree(key)
            if queue:
                self.lazy_render_after_id = self.root.after(delay, render_next)

        if queue:
            self.lazy_render_after_id = self.root.after(delay, render_next)

    def on_tab_changed(self, _event=None):
        key = self.get_selected_section_key()
        tree = self.tree_widgets.get(key) if key else None
        needs_render = bool(tree and not tree.get_children() and self.sections.get(key))
        if key and (key not in self.rendered_sections or needs_render):
            self.render_section_tree(key)
            self.root.after_idle(lambda k=key: self.render_section_tree(k) if k in self.tree_widgets and not self.tree_widgets[k].get_children() and self.sections.get(k) else None)

    def schedule_rendered_tree_refresh(self, delay=250):
        if self.thumbnail_refresh_after_id:
            return

        def refresh_now():
            self.thumbnail_refresh_after_id = None
            keys = [key for key in list(self.rendered_sections)
                    if key in self.tree_widgets and self.is_section_tab_visible(key)]
            for key in keys:
                self.render_section_tree(key)

        self.thumbnail_refresh_after_id = self.root.after(delay, refresh_now)

    # ====================== 自由テキスト抽出 ======================
    def extract_free_text(self, html):
        if not html:
            return []
        lines = html.splitlines()
        free_lines = []
        i = 0
        inside_structured = False
        while i < len(lines):
            line = lines[i]
            stripped = line.strip()
            if (re.search(r'ここからグループ[abcd]', stripped, re.IGNORECASE) or
                re.search(r'ここからspecial', stripped, re.IGNORECASE) or
                re.search(r'ここからカテゴリ', stripped, re.IGNORECASE) or
                re.search(r'<dl class="table reverse">', stripped, re.IGNORECASE)):
                inside_structured = True
            if (re.search(r'ここまでグループ[abcd]', stripped, re.IGNORECASE) or
                re.search(r'ここまでspecial', stripped, re.IGNORECASE) or
                re.search(r'ここまでカテゴリ', stripped, re.IGNORECASE) or
                '</dl>' in stripped):
                inside_structured = False
                i += 1
                continue
            if not inside_structured:
                text_only = re.sub(r'<[^>]+>', '', stripped).strip()
                if text_only:
                    free_lines.append(line)
            i += 1
        return free_lines

    # ====================== テキスト管理 ======================
    def refresh_text_management(self):
        current = self.sections.get("text_management", [])
        keep = [item for item in current if item.get("edited") or item.get("html_edited")]
        extracted = []
        if self.index_html:
            extracted.extend(self.extract_manageable_texts(self.index_html, "index"))
        if self.menu_html:
            extracted.extend(self.extract_manageable_texts(self.menu_html, "menu"))
        edited_keys = {(item.get("file"), item.get("original_html")) for item in keep}
        merged = keep + [item for item in extracted if (item.get("file"), item.get("original_html")) not in edited_keys]
        self.sections["text_management"] = merged

    def extract_manageable_texts(self, html, file_key):
        masked = self.mask_text_excluded_blocks(html)
        items = []
        patterns = [
            (r'<span\b(?=[^>]*class="[^"]*\bhosoku\b[^"]*")[^>]*>.*?</span>', "小見出し"),
            (r'<span\b(?=[^>]*class="[^"]*\bfade-in-text\b[^"]*")[^>]*>.*?</span>', "見出し"),
            (r'<h3\b[^>]*>.*?</h3>', "見出し"),
            (r'<h4\b[^>]*>.*?</h4>', "見出し"),
            (r'<p\b[^>]*>.*?</p>', "段落"),
            (r'<button\b[^>]*>.*?</button>', "ボタン"),
        ]
        for pattern, kind in patterns:
            for m in re.finditer(pattern, masked, re.DOTALL | re.IGNORECASE):
                html_part = html[m.start():m.end()]
                if re.search(r'<(img|script|style|iframe)\b', html_part, re.IGNORECASE):
                    continue
                text = self.html_to_plain_text(html_part)
                if not text:
                    continue
                items.append({
                    "file": file_key,
                    "section": self.find_parent_section_id(html, m.start()),
                    "kind": kind,
                    "text": text,
                    "html": html_part,
                    "original_html": html_part,
                    "edited": False,
                    "html_edited": False,
                })
        items.sort(key=lambda item: html.find(item["original_html"]))
        return items

    def mask_text_excluded_blocks(self, html):
        masked = html
        patterns = [
            r'<nav\s+id="header-menu"[^>]*>.*?</nav>',
            r'<div\s+id="menubar"[^>]*>.*?</div>',
            r'<!--\s*ここからspecial\s*-->.*?<!--\s*ここまでspecial\s*-->',
            r'<!--\s*ここからカテゴリ\s*-->.*?<!--\s*ここまでカテゴリ\s*-->',
            r'<!--\s*ここからグループ[a-z]\s*-->.*?<!--\s*ここまでグループ[a-z]\s*-->',
            r'<dl class="table reverse">.*?</dl>',
            r'<!--\s*YUMEHAN_CUSTOM_SECTION_START\b.*?<!--\s*YUMEHAN_CUSTOM_SECTION_END\b[^>]*-->',
        ]
        for pattern in patterns:
            masked = re.sub(pattern, lambda m: " " * (m.end() - m.start()), masked, flags=re.DOTALL | re.IGNORECASE)
        return masked

    def html_to_plain_text(self, html_part):
        text = re.sub(r'<br\s*/?>', '\n', html_part, flags=re.IGNORECASE)
        text = re.sub(r'<[^>]+>', '', text)
        return re.sub(r'\s+', ' ', text).strip()

    def find_parent_section_id(self, html, pos):
        section_id = ""
        for m in re.finditer(r'<section\s+id="([^"]+)"', html[:pos], re.IGNORECASE):
            section_id = m.group(1)
        return section_id

    def update_html_inner_text(self, original_html, new_text):
        m = re.match(r'(<[^>]+>)(.*?)(</[^>]+>)\s*$', original_html, re.DOTALL)
        if not m:
            return new_text
        return f"{m.group(1)}{new_text}{m.group(3)}"

    def apply_text_management_replaces(self):
        for item in self.sections.get("text_management", []):
            if not item.get("edited") and not item.get("html_edited"):
                continue
            file_key = item.get("file")
            original = item.get("original_html", "")
            if not original:
                continue
            new_html = item.get("html", "") if item.get("html_edited") else self.update_html_inner_text(original, item.get("text", ""))
            if file_key == "index" and self.index_html:
                self.index_html = self.index_html.replace(original, new_html, 1)
            elif file_key == "menu" and self.menu_html:
                self.menu_html = self.menu_html.replace(original, new_html, 1)
            item["original_html"] = new_html
            item["html"] = new_html
            item["text"] = self.html_to_plain_text(new_html)
            item["edited"] = False
            item["html_edited"] = False

    # ====================== 解析 ======================
    def parse_index_sections(self):
        self.custom_section_defs = []
        self.section_headings = {
            key: value for key, value in self.section_headings.items()
            if value.get("file") == "menu"
        }
        self.parse_custom_sections()
        group_letters = set(re.findall(r'ここからグループ([a-z])', self.index_html, re.IGNORECASE))
        group_letters.update(["a", "b", "c", "d"])
        for g in sorted(group_letters):
            self.sections[f"group_{g}"] = self.extract_group(self.index_html, g)
        self.sections["special"] = self.extract_special(self.index_html)
        self.sections["index_menu_banners"] = self.extract_banners(self.index_html)
        self.sections["nav_menu"] = self.extract_nav_menu(self.index_html)
        self.extract_section_headings()

    def parse_custom_sections(self):
        if not self.index_html:
            return
        pattern = (
            r'<!--\s*YUMEHAN_CUSTOM_SECTION_START\s+'
            r'id="([^"]+)"\s+type="([^"]+)"\s+title="([^"]*)"\s+sub="([^"]*)"\s*-->'
            r'(.*?)'
            r'<!--\s*YUMEHAN_CUSTOM_SECTION_END\s+id="\1"\s*-->'
        )
        for section_id, section_type, title, subheading, block in re.findall(pattern, self.index_html, re.DOTALL | re.IGNORECASE):
            key = self.get_custom_section_key(section_type, section_id)
            meta = {"id": section_id, "type": section_type, "title": title, "sub": subheading, "key": key}
            self.custom_section_defs.append(meta)
            if section_type == "special":
                self.sections[key] = self.extract_special_from_block(block)
            elif section_type == "category":
                self.sections[key] = self.extract_banners(block)
            elif section_type == "text":
                self.sections[key] = self.extract_custom_text_items(block)

    def get_custom_section_key(self, section_type, section_id):
        safe_id = re.sub(r'[^a-zA-Z0-9_]+', '_', section_id)
        return f"custom_{section_type}_{safe_id}"

    def extract_special_from_block(self, block):
        items = []
        for b in re.findall(r'<div class="slide[^>]*?>(.*?)</div>', block, re.DOTALL | re.IGNORECASE):
            href = re.search(r'href="([^"]+)"', b)
            src = re.search(r'src="([^"]+)"', b)
            text = re.search(r'<p class="text">([^<]+)</p>', b)
            badge = re.search(r'<span class="icon-menu-point">([^<]+)</span>', b)
            if href and src:
                items.append({
                    "href": href.group(1),
                    "src": src.group(1),
                    "text": text.group(1) if text else "",
                    "badge": badge.group(1) if badge else ""
                })
        return items

    def extract_custom_text_items(self, block):
        items = []
        m = re.search(r'<div class="custom-text-body">(.*?)</div>', block, re.DOTALL | re.IGNORECASE)
        source = m.group(1) if m else block
        for item in re.findall(r'<p>.*?</p>', source, re.DOTALL | re.IGNORECASE):
            items.append(item.strip())
        return items

    def parse_menu_sections(self):
        self.sections["menu_banners"] = self.extract_banners(self.menu_html)
        self.sections["menu_bottom_links"] = self.extract_bottom_links(self.menu_html)
        self.extract_menu_heading()

    def extract_section_headings(self):
        if not self.index_html:
            return
        for key in self.get_group_keys():
            group_letter = self.get_group_letter_from_key(key)
            section_id = self.find_section_id_for_group(group_letter)
            meta = self.get_heading_meta_for_section(self.index_html, section_id)
            if meta:
                meta.update({"file": "index", "section_id": section_id, "key": key})
                self.section_headings[key] = meta
        for key, section_id in (("special", "special"), ("index_menu_banners", "menu")):
            meta = self.get_heading_meta_for_section(self.index_html, section_id)
            if meta:
                meta.update({"file": "index", "section_id": section_id, "key": key})
                self.section_headings[key] = meta
        for custom_meta in self.custom_section_defs:
            key = custom_meta.get("key", "")
            section_id = custom_meta.get("id", "")
            meta = self.get_heading_meta_for_section(self.index_html, section_id) or {
                "title": custom_meta.get("title", ""),
                "sub": custom_meta.get("sub", ""),
                "style": "span" if custom_meta.get("sub") else "simple",
            }
            meta.update({
                "file": "index",
                "section_id": section_id,
                "key": key,
                "custom_meta": custom_meta,
            })
            self.section_headings[key] = meta

    def extract_menu_heading(self):
        if not self.menu_html:
            return
        m = re.search(r'<h2[^>]*>(.*?)</h2>', self.menu_html, re.DOTALL | re.IGNORECASE)
        if not m:
            return
        title, subheading, style = self.parse_heading_inner(m.group(1))
        self.section_headings["menu_banners"] = {
            "file": "menu",
            "section_id": "",
            "key": "menu_banners",
            "title": title,
            "sub": subheading,
            "style": style,
        }

    def find_section_id_for_group(self, group_letter):
        if not group_letter:
            return ""
        marker = f"ここからグループ{group_letter}"
        for m in re.finditer(r'<section\s+id="([^"]+)"[^>]*>(.*?)</section>', self.index_html, re.DOTALL | re.IGNORECASE):
            if re.search(re.escape(marker), m.group(2), re.IGNORECASE):
                return m.group(1)
        gallery_map = {"a": "gallery0", "b": "gallery0", "c": "gallery1", "d": "gallery1"}
        return gallery_map.get(group_letter.lower(), "")

    def get_heading_meta_for_section(self, html, section_id):
        section = self.extract_section_by_id(html, section_id)
        if not section:
            return None
        m = re.search(r'<h2[^>]*>(.*?)</h2>', section, re.DOTALL | re.IGNORECASE)
        if not m:
            return None
        title, subheading, style = self.parse_heading_inner(m.group(1))
        return {"title": title, "sub": subheading, "style": style}

    def parse_heading_inner(self, inner_html):
        spans = re.findall(r'<span[^>]*class="([^"]*)"[^>]*>(.*?)</span>', inner_html, re.DOTALL | re.IGNORECASE)
        subheading = ""
        title = ""
        for classes, value in spans:
            text = self.html_to_plain_text(value)
            if "hosoku" in classes:
                subheading = text
            elif "fade-in-text" in classes:
                title = text
        if title or subheading:
            return title, subheading, "span"
        return self.html_to_plain_text(inner_html), "", "simple"

    def extract_group(self, html, group_letter):
        pattern = rf'ここからグループ{group_letter}.*?(.*?)ここまでグループ{group_letter}'
        m = re.search(pattern, html, re.DOTALL | re.IGNORECASE)
        if m:
            block = m.group(1)
        else:
            block = self.extract_group_without_markers(html, group_letter)
            if not block:
                return []
        items = []
        for href, src in re.findall(r'<div><a href="([^"]+)"><img src="([^"]+)" alt="[^"]*"></a></div>', block):
            items.append({"href": href, "src": src})
        return items

    def extract_group_without_markers(self, html, group_letter):
        gallery_map = {
            "a": ("gallery0", 0),
            "b": ("gallery0", 1),
            "c": ("gallery1", 0),
            "d": ("gallery1", 1),
        }
        section_id, block_index = gallery_map.get(group_letter, ("", -1))
        section = self.extract_section_by_id(html, section_id)
        if not section:
            return ""
        blocks = re.findall(
            r'<div class="slide-thumbnail1">\s*<div class="img[^"]*">\s*(.*?)(?=\n</div>\s*\n</div>)',
            section,
            re.DOTALL | re.IGNORECASE
        )
        if block_index < 0 or block_index >= len(blocks):
            return ""
        return blocks[block_index]

    def extract_section_by_id(self, html, section_id):
        if not section_id:
            return ""
        m = re.search(
            rf'<section\s+id="{re.escape(section_id)}"[^>]*>(.*?)</section>',
            html,
            re.DOTALL | re.IGNORECASE
        )
        return m.group(1) if m else ""

    def extract_special(self, html):
        m = re.search(r'<!--\s*ここからspecial\s*-->(.*?)<!--\s*ここまでspecial\s*-->', html, re.DOTALL | re.IGNORECASE)
        if not m: return []
        block = m.group(1)
        items = []
        for b in re.findall(r'<div class="slide[^>]*?>(.*?)</div>', block, re.DOTALL):
            href = re.search(r'href="([^"]+)"', b)
            src = re.search(r'src="([^"]+)"', b)
            text = re.search(r'<p class="text">([^<]+)</p>', b)
            badge = re.search(r'<span class="icon-menu-point">([^<]+)</span>', b)
            if href and src:
                items.append({
                    "href": href.group(1),
                    "src": src.group(1),
                    "text": text.group(1) if text else "",
                    "badge": badge.group(1) if badge else ""
                })
        return items

    def extract_banners(self, html):
        items = []
        pattern = r'<div class="menu (?:up|blur)">.*?<a href="([^"]+)">.*?<img src="([^"]+)"[^>]*>.*?<p class="text">([^<]+)</p>(?:.*?<span class="icon-menu-point">([^<]+)</span>)?'
        for m in re.finditer(pattern, html, re.DOTALL | re.IGNORECASE):
            items.append({
                "href": m.group(1),
                "src": m.group(2),
                "text": m.group(3).strip(),
                "badge": m.group(4).strip() if m.group(4) else ""
            })
        return items

    def extract_bottom_links(self, html):
        items = []
        dl_block = re.search(r'<dl class="table reverse">(.*?)</dl>', html, re.DOTALL)
        if not dl_block: return []
        for dt, dd in re.findall(r'<dt>(.*?)</dt>\s*<dd>(.*?)</dd>', dl_block.group(1), re.DOTALL):
            href_match = re.search(r'href="([^"]+)"', dd)
            if href_match:
                items.append({
                    "label": re.sub(r'<[^>]+>', '', dt).strip(),
                    "href": href_match.group(1),
                    "link_text": re.sub(r'<[^>]+>', '', dd).strip()
                })
        return items

    def extract_nav_menu(self, html):
        items = self.extract_nav_menu_block(
            html,
            r'<nav\s+id="header-menu"[^>]*>\s*<ul>(.*?)</ul>\s*</nav>'
        )
        if items:
            return items
        return self.extract_nav_menu_block(
            html,
            r'<div\s+id="menubar"[^>]*>\s*<nav>\s*<ul>(.*?)</ul>\s*</nav>\s*</div>'
        )

    def extract_nav_menu_block(self, html, pattern):
        m = re.search(pattern, html, re.DOTALL | re.IGNORECASE)
        if not m:
            return []
        items = []
        for href, text in re.findall(r'<li>\s*<a\s+href="([^"]*)"\s*>(.*?)</a>\s*</li>', m.group(1), re.DOTALL | re.IGNORECASE):
            clean_text = re.sub(r'<[^>]+>', '', text).strip()
            items.append({"href": href.strip(), "text": clean_text})
        return items

    # ====================== 再構築 ======================
    def rebuild_index(self):
        if not self.index_html: return
        self.rebuild_nav_menus()
        self.rebuild_custom_sections()
        group_letters = set(re.findall(r'ここからグループ([a-z])', self.index_html, re.IGNORECASE))
        group_letters.update(self.get_group_letter_from_key(key) for key in self.get_group_keys())
        for g in sorted(letter for letter in group_letters if letter):
            new_content = self.build_group_html(g)
            pattern = rf'(<!--\s*ここからグループ{g}\s*-->)(.*?)(<!--\s*ここまでグループ{g}\s*-->)'
            if re.search(pattern, self.index_html, re.DOTALL | re.IGNORECASE):
                self.index_html = re.sub(pattern, lambda m: f"{m.group(1)}\n{new_content}{m.group(3)}",
                                       self.index_html, flags=re.DOTALL | re.IGNORECASE)
            else:
                self.index_html = self.replace_group_without_markers(self.index_html, g, new_content)

        new_special = self.build_special_html()
        special_pattern = r'<!--\s*ここからspecial\s*-->(.*?)<!--\s*ここまでspecial\s*-->'
        if re.search(special_pattern, self.index_html, re.DOTALL | re.IGNORECASE):
            self.index_html = re.sub(special_pattern, new_special, self.index_html, flags=re.DOTALL | re.IGNORECASE)

        new_banners = self.build_banners_html("index_menu_banners")
        category_pattern = r'<!--\s*ここからカテゴリ\s*-->(.*?)<!--\s*ここまでカテゴリ\s*-->'
        if re.search(category_pattern, self.index_html, re.DOTALL | re.IGNORECASE):
            self.index_html = re.sub(
                category_pattern,
                f"<!-- ここからカテゴリ -->\n{new_banners.strip()}\n<!-- ここまでカテゴリ -->",
                self.index_html,
                flags=re.DOTALL | re.IGNORECASE
            )

    def rebuild_menu(self):
        if not self.menu_html: return
        new_banners = self.build_banners_html("menu_banners")
        category_pattern = r'<!--\s*ここからカテゴリ\s*-->(.*?)<!--\s*ここまでカテゴリ\s*-->'
        if re.search(category_pattern, self.menu_html, re.DOTALL | re.IGNORECASE):
            self.menu_html = re.sub(
                category_pattern,
                f"<!-- ここからカテゴリ -->\n{new_banners.strip()}\n<!-- ここまでカテゴリ -->",
                self.menu_html,
                flags=re.DOTALL | re.IGNORECASE
            )
        new_dl = self.build_bottom_links_html()
        self.menu_html = re.sub(r'(<dl class="table reverse">.*?</dl>)', new_dl, self.menu_html, flags=re.DOTALL | re.IGNORECASE)

    def rebuild_nav_menus(self):
        if not self.index_html:
            return
        nav_html = self.build_nav_menu_html("header")
        header_pattern = r'<nav\s+id="header-menu"[^>]*>\s*<ul>.*?</ul>\s*</nav>'
        self.index_html = re.sub(header_pattern, nav_html, self.index_html, count=1, flags=re.DOTALL | re.IGNORECASE)

        menubar_html = self.build_nav_menu_html("hamburger")
        menubar_pattern = r'<div\s+id="menubar"[^>]*>\s*<nav>\s*<ul>.*?</ul>\s*</nav>\s*</div>'
        self.index_html = re.sub(menubar_pattern, menubar_html, self.index_html, count=1, flags=re.DOTALL | re.IGNORECASE)

    def build_heading_html(self, meta):
        title = html_lib.escape(meta.get("title", "").strip())
        subheading = html_lib.escape(meta.get("sub", "").strip())
        if subheading or meta.get("style") == "span":
            return f'<h2><span class="hosoku">{subheading}</span><span class="fade-in-text">{title}</span></h2>'
        return f'<h2>{title}</h2>'

    def apply_section_heading_to_html(self, section_key):
        meta = self.section_headings.get(section_key)
        if not meta:
            return False
        new_heading = self.build_heading_html(meta)
        file_key = meta.get("file")
        section_id = meta.get("section_id", "")
        if file_key == "menu":
            if not self.menu_html:
                return False
            self.menu_html, count = re.subn(
                r'<h2[^>]*>.*?</h2>',
                new_heading,
                self.menu_html,
                count=1,
                flags=re.DOTALL | re.IGNORECASE
            )
            return bool(count)
        if file_key != "index" or not self.index_html or not section_id:
            return False
        pattern = rf'(<section\s+id="{re.escape(section_id)}"[^>]*>)(.*?)(</section>)'
        match = re.search(pattern, self.index_html, re.DOTALL | re.IGNORECASE)
        if not match:
            return False
        body, count = re.subn(
            r'<h2[^>]*>.*?</h2>',
            new_heading,
            match.group(2),
            count=1,
            flags=re.DOTALL | re.IGNORECASE
        )
        if not count:
            return False
        new_section = match.group(1) + body + match.group(3)
        self.index_html = self.index_html[:match.start()] + new_section + self.index_html[match.end():]
        return True

    def apply_heading_edit(self, section_key, title_var, sub_var):
        meta = self.section_headings.get(section_key)
        if not meta:
            messagebox.showwarning("見出し", "このタブには編集できる見出しが見つかりません。")
            return
        title = title_var.get().strip()
        subheading = sub_var.get().strip()
        if not title:
            messagebox.showwarning("見出し", "見出しを入力してください。")
            return
        meta["title"] = title
        meta["sub"] = subheading
        if subheading:
            meta["style"] = "span"
        custom_meta = meta.get("custom_meta")
        if custom_meta:
            custom_meta["title"] = title
            custom_meta["sub"] = subheading
        for other in self.section_headings.values():
            if other is meta:
                continue
            if other.get("file") == meta.get("file") and other.get("section_id") == meta.get("section_id"):
                other["title"] = title
                other["sub"] = subheading
                other["style"] = meta.get("style", other.get("style", "simple"))
                if other.get("custom_meta"):
                    other["custom_meta"]["title"] = title
                    other["custom_meta"]["sub"] = subheading
        if self.apply_section_heading_to_html(section_key):
            self.refresh_all_heading_editors()
            messagebox.showinfo("見出し", "見出しを反映しました。保存時にHTMLへ書き出されます。")
        else:
            self.refresh_all_heading_editors()
            messagebox.showwarning("見出し", "HTML内の見出し位置を特定できませんでした。")

    def rebuild_custom_sections(self):
        if not self.index_html:
            return
        for meta in self.custom_section_defs:
            new_html = self.build_custom_section_html(meta)
            pattern = (
                rf'<!--\s*YUMEHAN_CUSTOM_SECTION_START\s+id="{re.escape(meta["id"])}"[^>]*-->'
                rf'.*?'
                rf'<!--\s*YUMEHAN_CUSTOM_SECTION_END\s+id="{re.escape(meta["id"])}"\s*-->'
            )
            self.index_html = re.sub(pattern, new_html, self.index_html, count=1, flags=re.DOTALL | re.IGNORECASE)

    def replace_group_without_markers(self, html, group_letter, new_content):
        gallery_map = {
            "a": ("gallery0", 0),
            "b": ("gallery0", 1),
            "c": ("gallery1", 0),
            "d": ("gallery1", 1),
        }
        section_id, block_index = gallery_map.get(group_letter, ("", -1))
        if not section_id:
            return html

        section_pattern = rf'(<section\s+id="{re.escape(section_id)}"[^>]*>)(.*?)(</section>)'
        section_match = re.search(section_pattern, html, re.DOTALL | re.IGNORECASE)
        if not section_match:
            return html

        body = section_match.group(2)
        block_pattern = r'(<div class="slide-thumbnail1">\s*<div class="img[^"]*">\s*)(.*?)(\n</div>\s*\n</div>)'
        matches = list(re.finditer(block_pattern, body, re.DOTALL | re.IGNORECASE))
        if block_index < 0 or block_index >= len(matches):
            return html

        target = matches[block_index]
        new_body = body[:target.start()] + target.group(1) + new_content.rstrip() + "\n" + target.group(3) + body[target.end():]
        new_section = section_match.group(1) + new_body + section_match.group(3)
        return html[:section_match.start()] + new_section + html[section_match.end():]

    def build_group_html(self, group_letter):
        items = self.sections.get(f"group_{group_letter}", [])
        lines = []
        for item in items:
            if isinstance(item, dict):
                href = item.get("href", "#")
                src = item.get("src", "")
                lines.append(f'<div><a href="{href}"><img src="{src}" alt=""></a></div>')
        return '\n'.join(lines) + '\n' if lines else ''

    def build_special_html(self):
        items = self.sections.get("special", [])
        lines = ['<!-- ここからspecial -->']
        for i, item in enumerate(items):
            if isinstance(item, dict):
                css_class = 'slide img1' if i == 0 else 'slide'
                lines.append(f' <div class="{css_class}">')
                lines.append(f' <a href="{item.get("href", "#")}"><img src="{item.get("src", "")}" alt=""></a>')
                if item.get("text"):
                    lines.append(f' <p class="text">{item["text"]}</p>')
                if item.get("badge"):
                    lines.append(f' <span class="icon-menu-point">{item["badge"]}</span>')
                lines.append(' </div>')
        lines.append('<!-- ここまでspecial -->')
        return '\n'.join(lines)

    def build_banners_html(self, section_key):
        items = self.sections.get(section_key, [])
        lines = []
        div_class = "menu up" if section_key == "index_menu_banners" else "menu blur"
        for item in items:
            if isinstance(item, dict):
                lines.append(f'<div class="{div_class}">')
                lines.append(f' <a href="{item.get("href", "#")}">')
                lines.append(f' <img src="{item.get("src", "")}" alt="">')
                lines.append(f' </a>')
                lines.append(f' <p class="text">{item.get("text", "").strip()}</p>')
                if item.get("badge"):
                    lines.append(f' <span class="icon-menu-point">{item.get("badge")}</span>')
                lines.append('</div>')
        return '\n'.join(lines)

    def build_bottom_links_html(self):
        items = self.sections.get("menu_bottom_links", [])
        lines = ['<dl class="table reverse">']
        for item in items:
            if isinstance(item, dict):
                lines.append(f' <dt>{item.get("label", "")}</dt>')
                lines.append(f' <dd><a href="{item.get("href", "#")}">{item.get("link_text", "")}</a></dd>')
        lines.append('</dl>')
        return '\n'.join(lines) + '\n'

    def build_nav_menu_html(self, menu_type):
        items = self.sections.get("nav_menu", [])
        if menu_type == "header":
            lines = ['<nav id="header-menu">', '<ul>']
        else:
            lines = ['<div id="menubar">', '<nav>', '<ul>']
        for item in items:
            if not isinstance(item, dict):
                continue
            href = item.get("href", "").strip()
            text = item.get("text", "").strip()
            if not href and not text:
                continue
            lines.append(f'<li><a href="{href}">{text}</a></li>')
        lines.append('</ul>')
        if menu_type == "header":
            lines.append('</nav>')
        else:
            lines.extend(['</nav>', '</div>'])
        return '\n'.join(lines)

    def build_custom_section_html(self, meta):
        section_type = meta.get("type", "")
        section_id = meta.get("id", "")
        title = meta.get("title", "")
        subheading = meta.get("sub", "")
        body = ""
        if section_type == "special":
            body = self.build_custom_special_body(meta)
        elif section_type == "category":
            body = self.build_custom_category_body(meta)
        elif section_type == "text":
            body = self.build_custom_text_body(meta)
        return (
            f'<!-- YUMEHAN_CUSTOM_SECTION_START id="{section_id}" type="{section_type}" title="{title}" sub="{subheading}" -->\n'
            f'{body}'
            f'<!-- YUMEHAN_CUSTOM_SECTION_END id="{section_id}" -->\n'
        )

    def build_custom_heading_html(self, meta):
        heading_meta = {
            "title": meta.get("title", ""),
            "sub": meta.get("sub", ""),
            "style": "span" if meta.get("sub") else "simple",
        }
        return self.build_heading_html(heading_meta)

    def build_custom_special_body(self, meta):
        key = meta.get("key", "")
        lines = [
            f'<section id="{meta.get("id", "")}" class="section">',
            '<div class="contents">',
            self.build_custom_heading_html(meta),
            '<div class="slide5">',
        ]
        for i, item in enumerate(self.sections.get(key, [])):
            if not isinstance(item, dict):
                continue
            css_class = 'slide img1' if i == 0 else 'slide'
            lines.append(f' <div class="{css_class}">')
            lines.append(f' <a href="{item.get("href", "#")}"><img src="{item.get("src", "")}" alt=""></a>')
            if item.get("text"):
                lines.append(f' <p class="text">{item["text"]}</p>')
            if item.get("badge"):
                lines.append(f' <span class="icon-menu-point">{item["badge"]}</span>')
            lines.append(' </div>')
        lines.extend([
            '<div class="slide-indicators"></div>',
            '</div>',
            '</div>',
            '</section>',
            '',
        ])
        return '\n'.join(lines)

    def build_custom_category_body(self, meta):
        key = meta.get("key", "")
        lines = [
            f'<section id="{meta.get("id", "")}" class="section">',
            '<div class="contents">',
            self.build_custom_heading_html(meta),
        ]
        for item in self.sections.get(key, []):
            if not isinstance(item, dict):
                continue
            lines.append('<div class="menu up">')
            lines.append(f' <a href="{item.get("href", "#")}">')
            lines.append(f' <img src="{item.get("src", "")}" alt="">')
            lines.append(' </a>')
            lines.append(f' <p class="text">{item.get("text", "").strip()}</p>')
            if item.get("badge"):
                lines.append(f' <span class="icon-menu-point">{item.get("badge")}</span>')
            lines.append('</div>')
        lines.extend(['</div>', '</section>', ''])
        return '\n'.join(lines)

    def build_custom_text_body(self, meta):
        key = meta.get("key", "")
        lines = [
            f'<section id="{meta.get("id", "")}" class="section">',
            '<div class="contents">',
            self.build_custom_heading_html(meta),
            '<div class="custom-text-body">',
        ]
        items = self.sections.get(key, [])
        if not items:
            items = ['<p>ここに説明文を入力してください。</p>']
        for item in items:
            lines.append(item if isinstance(item, str) else '<p></p>')
        lines.extend(['</div>', '</div>', '</section>', ''])
        return '\n'.join(lines)

    def get_next_gallery_id(self):
        used = {int(n) for n in re.findall(r'<section\s+id="gallery(\d+)"', self.index_html or "", re.IGNORECASE)}
        number = 0
        while number in used:
            number += 1
        return f"gallery{number}"

    def get_next_custom_section_id(self, section_type):
        prefix_map = {"special": "slide", "category": "category", "text": "info"}
        prefix = prefix_map.get(section_type, "section")
        used = set(re.findall(r'<section\s+id="([^"]+)"', self.index_html or "", re.IGNORECASE))
        number = 1
        while f"{prefix}{number}" in used:
            number += 1
        return f"{prefix}{number}"

    def insert_section_before_menu(self, section_html):
        insert_pattern = r'(?=\n<section\s+id="menu"\s+class="section">)'
        if re.search(insert_pattern, self.index_html or "", re.IGNORECASE):
            self.index_html = re.sub(insert_pattern, "\n" + section_html, self.index_html, count=1, flags=re.IGNORECASE)
        else:
            self.index_html = (self.index_html or "").replace("</main>", section_html + "\n</main>", 1)

    def open_add_section_dialog(self, nav_tree=None):
        if not self.index_html:
            messagebox.showwarning("警告", "先に index.html を読み込んでください。")
            return
        dlg = tk.Toplevel(self.root)
        dlg.title("新しいセクションを追加")
        dlg.geometry("420x280")
        dlg.grab_set()

        type_var = tk.StringVar(value="group")
        title_var = tk.StringVar(value="新しいセクション")
        sub_var = tk.StringVar(value="Lineup")
        ttk.Label(dlg, text="1. セクションの種類").pack(anchor="w", padx=15, pady=(15, 5))
        options = [
            ("グループ横スクロール", "group"),
            ("スライド画像", "special"),
            ("カテゴリ一覧", "category"),
            ("説明ブロック", "text"),
        ]
        for label, value in options:
            ttk.Radiobutton(dlg, text=label, variable=type_var, value=value).pack(anchor="w", padx=28, pady=2)

        form = ttk.Frame(dlg)
        form.pack(fill="x", padx=15, pady=12)
        ttk.Label(form, text="2. メニュー名・見出し:").grid(row=0, column=0, sticky="e", pady=4)
        ttk.Entry(form, textvariable=title_var, width=32, font=self.default_font).grid(row=0, column=1, sticky="we", pady=4)
        ttk.Label(form, text="3. 小見出し:").grid(row=1, column=0, sticky="e", pady=4)
        ttk.Entry(form, textvariable=sub_var, width=32, font=self.default_font).grid(row=1, column=1, sticky="we", pady=4)
        form.columnconfigure(1, weight=1)

        def add_selected():
            section_type = type_var.get()
            title = title_var.get().strip()
            subheading = sub_var.get().strip()
            if not title:
                messagebox.showwarning("警告", "メニュー名・見出しを入力してください。")
                return
            if section_type == "group":
                dlg.destroy()
                self.add_group_section(title, subheading or "Lineup", nav_tree)
                return
            self.add_custom_section(section_type, title, subheading, nav_tree)
            dlg.destroy()

        btns = ttk.Frame(dlg)
        btns.pack(pady=12)
        ttk.Button(btns, text="作成", command=add_selected).pack(side="left", padx=12)
        ttk.Button(btns, text="キャンセル", command=dlg.destroy).pack(side="left")

    def refresh_nav_menu_tree(self):
        nav_tree = self.tree_widgets.get("nav_menu")
        if nav_tree:
            self.populate_tree(nav_tree, "nav_menu", False)

    def add_custom_section(self, section_type, title, subheading, nav_tree=None):
        section_id = self.get_next_custom_section_id(section_type)
        key = self.get_custom_section_key(section_type, section_id)
        meta = {"id": section_id, "type": section_type, "title": title, "sub": subheading, "key": key}
        self.custom_section_defs.append(meta)
        self.section_headings[key] = {
            "file": "index",
            "section_id": section_id,
            "key": key,
            "title": title,
            "sub": subheading,
            "style": "span" if subheading else "simple",
            "custom_meta": meta,
        }
        if section_type == "special":
            self.sections[key] = [{
                "href": "https://store.shopping.yahoo.co.jp/u-b-yumehan/",
                "src": "",
                "text": title,
                "badge": ""
            }]
        elif section_type == "category":
            self.sections[key] = [{
                "href": "https://store.shopping.yahoo.co.jp/u-b-yumehan/",
                "src": "",
                "text": title,
                "badge": ""
            }]
        else:
            self.sections[key] = [f"<p>{title}の説明文を入力してください。</p>"]
        self.insert_section_before_menu(self.build_custom_section_html(meta))
        self.sections["nav_menu"].append({"href": f"#{section_id}", "text": title})
        self.add_custom_section_tab_if_needed(meta)
        self.refresh_nav_menu_tree()
        self.update_tab_visibility()
        self.update_all_trees()
        messagebox.showinfo("追加完了", f"{title} を追加しました。\nセクションID: {section_id}")

    def get_next_group_letters(self, count=2):
        used = {m.lower() for m in re.findall(r'ここからグループ([a-z])', self.index_html or "", re.IGNORECASE)}
        used.update(self.get_group_letter_from_key(key) for key in self.get_group_keys())
        letters = []
        for code in range(ord("a"), ord("z") + 1):
            letter = chr(code)
            if letter not in used:
                letters.append(letter)
                if len(letters) >= count:
                    return letters
        return letters

    def build_group_section_html(self, section_id, heading, subheading, group_letters):
        first = group_letters[0]
        second = group_letters[1] if len(group_letters) > 1 else group_letters[0]
        heading_text = html_lib.escape(heading)
        subheading_text = html_lib.escape(subheading)
        return f'''<!-- ここから{heading} -->
<section id="{section_id}" class="section">
<div class="contents">
<div class="gallery-box">

<h2><span class="hosoku">{subheading_text}</span><span class="fade-in-text">{heading_text}</span></h2>
<aside class="blur"><img src="images/bg_gallery.png" alt=""></aside>

<div class="slide-thumbnail-box">

<div class="slide-thumbnail1">
<div class="img rtl">
<!-- ここからグループ{first} -->
<!-- ここまでグループ{first} -->
</div>
</div>

<div class="slide-thumbnail1">
<div class="img ltr">
<!-- ここからグループ{second} -->
<!-- ここまでグループ{second} -->
</div>
</div>

</div>

</div>
<!--/gallery-box-->

</div>
</section>
'''

    def add_group_section_from_nav(self, tree=None):
        if not self.index_html:
            messagebox.showwarning("警告", "先に index.html を読み込んでください。")
            return
        title = simpledialog.askstring("グループセクション追加", "メニュー名・見出し名を入力してください。", parent=self.root)
        if not title:
            return
        subheading = simpledialog.askstring("グループセクション追加", "小見出しを入力してください。", initialvalue="Lineup", parent=self.root)
        if subheading is None:
            return
        self.add_group_section(title.strip(), subheading.strip() or "Lineup", tree)

    def add_group_section(self, title, subheading, tree=None):
        section_id = self.get_next_gallery_id()
        group_letters = self.get_next_group_letters(2)
        if len(group_letters) < 2:
            messagebox.showerror("追加失敗", "追加できるグループIDが残っていません。")
            return
        section_html = self.build_group_section_html(section_id, title, subheading, group_letters)
        self.insert_section_before_menu(section_html)
        self.sections["nav_menu"].append({"href": f"#{section_id}", "text": title})
        for letter in group_letters:
            group_key = self.get_group_key(letter)
            self.sections[group_key] = []
            self.section_headings[group_key] = {
                "file": "index",
                "section_id": section_id,
                "key": group_key,
                "title": title,
                "sub": subheading,
                "style": "span",
            }
            self.add_group_tab_if_needed(group_key)
        self.refresh_nav_menu_tree()
        self.update_tab_visibility()
        self.update_all_trees()
        messagebox.showinfo(
            "追加完了",
            f"{section_id} を追加しました。\n追加グループ: {', '.join(letter.upper() for letter in group_letters)}"
        )

    def delete_selected_nav_section(self, tree):
        selection = tree.selection()
        if not selection:
            messagebox.showwarning("警告", "削除するメニュー行を選択してください。")
            return
        protected_ids = {"home", "kodawari", "gallery0", "gallery1", "special", "menu", "shop"}
        removed_sections = []
        removed_menus = 0
        indices = sorted([tree.index(iid) for iid in selection], reverse=True)
        for idx in indices:
            if idx >= len(self.sections.get("nav_menu", [])):
                continue
            item = self.sections["nav_menu"][idx]
            href = item.get("href", "")
            section_id = href[1:] if href.startswith("#") else ""
            if section_id in protected_ids:
                messagebox.showwarning("保護中", f"{section_id} は既存の基本セクションなので削除しません。")
                continue
            if section_id and not messagebox.askyesno("確認", f"{item.get('text', section_id)} をメニューとHTMLセクションから削除しますか？"):
                continue
            del self.sections["nav_menu"][idx]
            removed_menus += 1
            if section_id:
                if self.remove_section_by_id(section_id):
                    removed_sections.append(section_id)
        self.populate_tree(tree, "nav_menu", False)
        self.update_tab_visibility()
        self.update_all_trees()
        messagebox.showinfo("削除完了", f"メニュー {removed_menus} 件、セクション {len(removed_sections)} 件を削除しました。")

    def remove_section_by_id(self, section_id):
        if not self.index_html:
            return False
        removed = False
        custom_pattern = (
            rf'\n?<!--\s*YUMEHAN_CUSTOM_SECTION_START\s+id="{re.escape(section_id)}"[^>]*-->'
            rf'.*?'
            rf'<!--\s*YUMEHAN_CUSTOM_SECTION_END\s+id="{re.escape(section_id)}"\s*-->\n?'
        )
        if re.search(custom_pattern, self.index_html, re.DOTALL | re.IGNORECASE):
            self.index_html = re.sub(custom_pattern, "\n", self.index_html, count=1, flags=re.DOTALL | re.IGNORECASE)
            for meta in list(self.custom_section_defs):
                if meta.get("id") == section_id:
                    self.remove_tab_and_section(meta.get("key", ""))
                    self.custom_section_defs.remove(meta)
                    removed = True
            return removed

        section_pattern = rf'\n?<section\s+id="{re.escape(section_id)}"[^>]*>.*?</section>\n?'
        m = re.search(section_pattern, self.index_html, re.DOTALL | re.IGNORECASE)
        if not m:
            return False
        block = m.group(0)
        group_letters = re.findall(r'ここからグループ([a-z])', block, re.IGNORECASE)
        self.index_html = self.index_html[:m.start()] + "\n" + self.index_html[m.end():]
        for letter in group_letters:
            self.remove_tab_and_section(self.get_group_key(letter))
        return True

    def remove_tab_and_section(self, key):
        self.sections.pop(key, None)
        self.tree_widgets.pop(key, None)
        self.tree_info.pop(key, None)
        frame = self.tab_frames.pop(key, None)
        if frame:
            try:
                self.notebook.forget(frame)
            except Exception:
                pass
        self.tab_info = [info for info in self.tab_info if info[1] != key]
        self.rendered_sections.discard(key)

    # ====================== 背景抽出 ======================
    def extract_backgrounds(self):
        index_all = set()
        if self.index_html:
            index_all.update(re.findall(r'src=["\']([^"\']+\.(?:jpg|png|gif|webp|jpeg))["\']',
                                      self.index_html, re.IGNORECASE))
        index_used = set()
        for key in self.get_group_keys() + ["special", "index_menu_banners"]:
            for item in self.sections.get(key, []):
                if isinstance(item, dict) and "src" in item:
                    index_used.add(item["src"])
        self.sections["index_backgrounds"] = [{"src": src, "original_src": src} for src in sorted(index_all - index_used)]

        menu_all = set()
        if self.menu_html:
            menu_all.update(re.findall(r'src=["\']([^"\']+\.(?:jpg|png|gif|webp|jpeg))["\']',
                                     self.menu_html, re.IGNORECASE))
        menu_used = set()
        for item in self.sections.get("menu_banners", []):
            if isinstance(item, dict) and "src" in item:
                menu_used.add(item["src"])
        self.sections["menu_backgrounds"] = [{"src": src, "original_src": src} for src in sorted(menu_all - menu_used)]

    def extract_css_backgrounds(self):
        self.sections["css_backgrounds"] = []
        if not self.css_content:
            return
        pattern = r'url\s*\(\s*["\']?([^"\')]+?)["\']?\s*\)'
        matches = re.findall(pattern, self.css_content, re.IGNORECASE)
        image_ext = ('.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg')
        images = [m.strip() for m in matches if m.strip().lower().endswith(image_ext)]
        # === 修正1: 重複を許容し、CSS内での出現順のまま保持（setを使わない）===
        self.sections["css_backgrounds"] = [{"src": src, "original_src": src} for src in images]

    # ====================== 背景置換 ======================
    def apply_background_replaces(self):
        if self.index_html:
            for item in self.sections.get("index_backgrounds", []):
                old = item.get("original_src", "")
                new = item.get("src", "")
                if old and new and old != new:
                    self.index_html = self.index_html.replace(f'src="{old}"', f'src="{new}"')
                    self.index_html = self.index_html.replace(f"src='{old}'", f'src="{new}"')

        if self.menu_html:
            for item in self.sections.get("menu_backgrounds", []):
                old = item.get("original_src", "")
                new = item.get("src", "")
                if old and new and old != new:
                    self.menu_html = self.menu_html.replace(f'src="{old}"', f'src="{new}"')
                    self.menu_html = self.menu_html.replace(f"src='{old}'", f'src="{new}"')

        # style.css 用（修正2: 同じURLが複数あっても1つずつ順番に置換）
        if self.css_content:
            for item in self.sections.get("css_backgrounds", []):
                old = item.get("original_src", "").strip()
                new = item.get("src", "").strip()
                if old and new and old != new:
                    escaped_old = re.escape(old)
                    self.css_content = re.sub(
                        rf'(url\s*\(\s*["\']?){escaped_old}([\'"]?\s*\))',
                        lambda m: m.group(1) + new + m.group(2),
                        self.css_content,
                        count=1,                    # 1回だけ置換 → 個別対応
                        flags=re.IGNORECASE
                    )

    def sync_background_originals(self):
        for key in ["index_backgrounds", "menu_backgrounds", "css_backgrounds"]:
            for item in self.sections.get(key, []):
                if "original_src" in item:
                    item["original_src"] = item["src"]

    # ====================== グループ間移動 ======================
    def move_to_other_group(self, tree, current_key):
        selection = tree.selection()
        if not selection:
            messagebox.showwarning("警告", "移動する行を選択してください。")
            return
        groups = self.get_group_keys()
        groups.remove(current_key)
        group_names = {group_key: self.get_group_display_name(group_key) for group_key in groups + [current_key]}
        dlg = tk.Toplevel(self.root)
        dlg.title("別グループへ移動")
        dlg.geometry("340x260")
        dlg.grab_set()
        ttk.Label(dlg, text="移動先グループを選択してください：").pack(pady=10, padx=20)
        target_var = tk.StringVar()
        for g in groups:
            ttk.Radiobutton(dlg, text=group_names[g], variable=target_var, value=g).pack(anchor="w", padx=40, pady=4)

        def do_move():
            target_key = target_var.get()
            if not target_key:
                messagebox.showwarning("警告", "移動先を選択してください。")
                return
            data = self.sections[current_key]
            target_data = self.sections[target_key]
            indices = sorted([tree.index(iid) for iid in selection], reverse=True)
            to_move = [data[i] for i in indices]
            for i in indices:
                del data[i]
            target_data.extend(to_move)
            self.populate_tree(tree, current_key, True)
            if target_key in self.tree_widgets:
                self.populate_tree(self.tree_widgets[target_key], target_key, True)
            messagebox.showinfo("移動完了",
                f"{len(to_move)} 件を {group_names[target_key]} の最下部へ移動しました。")
            dlg.destroy()

        ttk.Button(dlg, text="移動実行", command=do_move).pack(pady=20)
        ttk.Button(dlg, text="キャンセル", command=dlg.destroy).pack()

    def copy_to_other_banner(self, tree, current_key):
        selection = tree.selection()
        if not selection:
            messagebox.showwarning("警告", "コピーする行を選択してください。")
            return
        target_key = "menu_banners" if current_key == "index_menu_banners" else "index_menu_banners"
        target_name = "Menu: 商品カテゴリ一覧" if target_key == "menu_banners" else "Index: 商品カテゴリ一覧"
        added = 0
        for iid in selection:
            idx = tree.index(iid)
            if idx < len(self.sections[current_key]):
                self.sections[target_key].append(copy.deepcopy(self.sections[current_key][idx]))
                added += 1
        if added > 0:
            if target_key in self.tree_widgets:
                self.populate_tree(self.tree_widgets[target_key], target_key, True)
            self.populate_tree(tree, current_key, True)
            messagebox.showinfo("完了", f"{added} 件を {target_name} の最下部にコピーしました。")

    # ====================== タブ作成 ======================
    def ensure_tabs(self):
        if self.tabs_built: return
        self.tabs_built = True
        self.tab_info = []
        for group_key in self.get_group_keys():
            label, _bg, _fg = self.get_group_badge(group_key)
            self.tab_info.append((f"{label}: {self.get_group_display_name(group_key)}", group_key, True))
        self.tab_info.extend([
            ("Index: Special 水着", "special", True),
            ("Index: 商品カテゴリ一覧", "index_menu_banners", True),
            ("Menu: 商品カテゴリ一覧", "menu_banners", True),
            ("Menu: 下部テキストリンク", "menu_bottom_links", False),
            ("メニュー同期", "nav_menu", False),
            ("テキスト管理", "text_management", False),
            ("Index背景等", "index_backgrounds", True),
            ("Menu背景等", "menu_backgrounds", True),
            ("Style.css 背景等", "css_backgrounds", True),
        ])
        for meta in self.custom_section_defs:
            has_image = meta.get("type") in ("special", "category")
            self.tab_info.append((f"追加: {meta.get('title', meta.get('id', ''))}", meta["key"], has_image))
        for title, key, has_image in self.tab_info:
            self.create_tab(title, key, has_image)
        self.notebook.bind("<<NotebookTabChanged>>", self.on_tab_changed)

    def create_tab(self, title, key, has_image):
        if key in self.tab_frames:
            return
        frame = ttk.Frame(self.notebook)
        tab_options = {"text": title}
        if key.startswith("group_"):
            _label, bg, _fg = self.get_group_badge(key)
            icon = self.create_color_square(bg)
            self.tab_icons[key] = icon
            tab_options.update({"image": icon, "compound": "left"})
        self.notebook.add(frame, **tab_options)
        self.tab_frames[key] = frame
        self.create_section_ui(frame, key, has_image)

    def add_group_tab_if_needed(self, group_key):
        if group_key in self.tab_frames:
            return
        if not hasattr(self, "notebook"):
            return
        label, _bg, _fg = self.get_group_badge(group_key)
        title = f"{label}: {self.get_group_display_name(group_key)}"
        insert_at = len([key for _title, key, _has_image in self.tab_info if key.startswith("group_")])
        self.tab_info.insert(insert_at, (title, group_key, True))
        self.create_tab(title, group_key, True)

    def add_custom_section_tab_if_needed(self, meta):
        key = meta["key"]
        if key in self.tab_frames:
            return
        if not hasattr(self, "notebook"):
            return
        has_image = meta.get("type") in ("special", "category")
        title = f"追加: {meta.get('title', meta.get('id', ''))}"
        self.tab_info.append((title, key, has_image))
        self.create_tab(title, key, has_image)

    def create_color_square(self, color):
        img = tk.PhotoImage(width=12, height=12)
        img.put(color, to=(0, 0, 12, 12))
        return img

    def create_heading_editor(self, parent, section_key):
        can_edit = (
            section_key.startswith("group_")
            or section_key.startswith("custom_")
            or section_key in ("special", "index_menu_banners", "menu_banners")
        )
        if not can_edit:
            return
        frame = ttk.LabelFrame(parent, text="見出し・小見出し")
        parent.add(frame, weight=0)

        sub_var = tk.StringVar()
        title_var = tk.StringVar()
        ttk.Label(frame, text="小見出し").grid(row=0, column=0, padx=(8, 4), pady=5, sticky="w")
        sub_entry = ttk.Entry(frame, textvariable=sub_var, width=28)
        sub_entry.grid(row=0, column=1, padx=(0, 10), pady=5, sticky="ew")
        ttk.Label(frame, text="見出し").grid(row=0, column=2, padx=(0, 4), pady=5, sticky="w")
        title_entry = ttk.Entry(frame, textvariable=title_var, width=34)
        title_entry.grid(row=0, column=3, padx=(0, 10), pady=5, sticky="ew")
        apply_btn = ttk.Button(
            frame,
            text="見出し反映",
            command=lambda: self.apply_heading_edit(section_key, title_var, sub_var)
        )
        apply_btn.grid(row=0, column=4, padx=(0, 8), pady=5)
        frame.columnconfigure(1, weight=1)
        frame.columnconfigure(3, weight=1)

        self.heading_editors[section_key] = {
            "frame": frame,
            "title_var": title_var,
            "sub_var": sub_var,
            "title_entry": title_entry,
            "sub_entry": sub_entry,
            "apply_btn": apply_btn,
        }
        self.refresh_heading_editor(section_key)

    def refresh_heading_editor(self, section_key):
        editor = self.heading_editors.get(section_key)
        if not editor:
            return
        meta = self.section_headings.get(section_key)
        state = "normal" if meta else "disabled"
        editor["title_var"].set(meta.get("title", "") if meta else "")
        editor["sub_var"].set(meta.get("sub", "") if meta else "")
        editor["title_entry"].configure(state=state)
        editor["sub_entry"].configure(state=state)
        editor["apply_btn"].configure(state=state)

    def refresh_all_heading_editors(self):
        for section_key in list(self.heading_editors):
            self.refresh_heading_editor(section_key)

    def create_section_ui(self, parent, section_key, has_image):
        main_pane = ttk.PanedWindow(parent, orient="vertical")
        main_pane.pack(fill="both", expand=True, padx=5, pady=5)

        self.create_heading_editor(main_pane, section_key)

        tree_frame = ttk.Frame(main_pane)
        main_pane.add(tree_frame, weight=1)

        is_text_tab = section_key in ("index_text", "menu_text") or section_key.startswith("custom_text_")
        is_background_tab = section_key in ("index_backgrounds", "menu_backgrounds", "css_backgrounds")

        if section_key == "text_management":
            tree = ttk.Treeview(tree_frame, columns=("file", "section", "kind", "text"), show="tree headings", height=18, style="Treeview")
            tree.heading("#0", text="No.")
            tree.heading("file", text="ファイル")
            tree.heading("section", text="セクション")
            tree.heading("kind", text="種類")
            tree.heading("text", text="表示テキスト")
            tree.column("#0", width=50, anchor="center")
            tree.column("file", width=80, anchor="center")
            tree.column("section", width=120, anchor="center")
            tree.column("kind", width=90, anchor="center")
            tree.column("text", width=720, anchor="w")
        elif section_key == "nav_menu":
            tree = ttk.Treeview(tree_frame, columns=("text", "href"), show="tree headings", height=16, style="Treeview")
            tree.heading("#0", text="No.")
            tree.heading("text", text="表示名")
            tree.heading("href", text="リンク")
            tree.column("#0", width=50, anchor="center")
            tree.column("text", width=260, anchor="w")
            tree.column("href", width=420, anchor="w")
        elif is_text_tab:
            tree = ttk.Treeview(tree_frame, columns=("display_text",), show="tree headings", height=22, style="Treeview")
            tree.heading("#0", text="No.")
            tree.heading("display_text", text="HTML行（タグ込み）")
            tree.column("#0", width=60, anchor="center")
            tree.column("display_text", width=1200, anchor="w")
        elif is_background_tab:
            tree = ttk.Treeview(tree_frame, columns=("src", "resolution"), show="tree headings", height=18, style="Treeview")
            tree.heading("#0", text="サムネイル")
            tree.heading("src", text="画像パス")
            tree.heading("resolution", text="解像度")
            tree.column("#0", width=180, anchor="center")
            tree.column("src", width=800, anchor="w")
            tree.column("resolution", width=100, anchor="center")
        elif has_image:
            is_group_tab = section_key.startswith("group_")
            columns = ("src", "href", "text", "resolution") if is_group_tab else ("src", "href", "text", "badge", "resolution")
            tree = ttk.Treeview(tree_frame, columns=columns, show="tree headings", height=12, style="Treeview")
            tree.heading("#0", text="サムネ")
            tree.heading("src", text="画像パス")
            tree.heading("href", text="リンク")
            tree.heading("text", text="商品名" if is_group_tab else "表示テキスト")
            if not is_group_tab:
                tree.heading("badge", text="バッジ")
            tree.heading("resolution", text="解像度")
            tree.column("#0", width=100, anchor="center")
            tree.column("src", width=200)
            tree.column("href", width=280)
            tree.column("text", width=220)
            if not is_group_tab:
                tree.column("badge", width=80)
            tree.column("resolution", width=90, anchor="center")
        else:
            tree = ttk.Treeview(tree_frame, columns=("label", "href", "link_text"), show="tree headings", height=12, style="Treeview")
            tree.heading("#0", text="No.")
            tree.heading("label", text="ラベル")
            tree.heading("href", text="リンク")
            tree.heading("link_text", text="リンクテキスト")
            tree.column("#0", width=50, anchor="center")
            tree.column("label", width=160)
            tree.column("href", width=280)
            tree.column("link_text", width=220)

        yscrollbar = ttk.Scrollbar(tree_frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=yscrollbar.set)
        tree.pack(side="left", fill="both", expand=True)
        yscrollbar.pack(side="right", fill="y")

        self.tree_widgets[section_key] = tree
        self.tree_info[section_key] = has_image
        if section_key == "group_a":
            self.populate_tree(tree, section_key, has_image)

        btn_frame = ttk.Frame(main_pane)
        main_pane.add(btn_frame, weight=0)

        if not is_text_tab and not is_background_tab and section_key != "text_management":
            ttk.Button(btn_frame, text="↑ 上へ", command=lambda: self.move_items_up(tree, section_key)).pack(side="left", padx=3)
            ttk.Button(btn_frame, text="↓ 下へ", command=lambda: self.move_items_down(tree, section_key)).pack(side="left", padx=3)

        if section_key == "text_management":
            ttk.Button(btn_frame, text="編集", command=lambda: self.edit_item(tree, section_key, has_image)).pack(side="left", padx=8)
            ttk.Button(btn_frame, text="HTML表示", command=lambda: self.show_selected_text_html(tree)).pack(side="left", padx=8)
            ttk.Button(btn_frame, text="更新", command=lambda: self.refresh_text_management_tree(tree)).pack(side="left", padx=8)

        if section_key.startswith("group_"):
            ttk.Button(btn_frame, text="→ 別グループへ移動",
                      command=lambda: self.move_to_other_group(tree, section_key)).pack(side="left", padx=8)
            ttk.Button(btn_frame, text="📦 商品CSVから追加",
                      command=lambda: self.add_products_from_csv(tree, section_key)).pack(side="left", padx=4)

        if section_key == "nav_menu":
            ttk.Button(btn_frame, text="追加セクション削除",
                      command=lambda: self.delete_selected_nav_section(tree)).pack(side="left", padx=8)

        if section_key in ("index_menu_banners", "menu_banners"):
            ttk.Button(btn_frame, text="→ 別カテゴリへコピー",
                      command=lambda: self.copy_to_other_banner(tree, section_key)).pack(side="left", padx=8)

        if section_key.startswith("group_") or section_key in ("special",
                           "index_menu_banners", "menu_banners", "menu_bottom_links", "nav_menu"):
            ttk.Button(btn_frame, text="📋 選択行をコピーして追加",
                      command=lambda: self.copy_and_add(tree, section_key)).pack(side="left", padx=8)
            ttk.Button(btn_frame, text="↕ 逆順",
                      command=lambda: self.reverse_order(tree, section_key)).pack(side="left", padx=4)
            ttk.Button(btn_frame, text="↓ 最下部へ",
                      command=lambda: self.move_to_bottom(tree, section_key)).pack(side="left", padx=4)

        if not is_background_tab and section_key != "text_management":
            ttk.Button(btn_frame, text="＋ 新規追加", command=lambda: self.add_new_item(tree, section_key, has_image)).pack(side="left", padx=10)

        if section_key != "text_management":
            ttk.Button(btn_frame, text="－ 削除", command=lambda: self.delete_item(tree, section_key)).pack(side="left", padx=3)
            ttk.Button(btn_frame, text="✏️ 編集", command=lambda: self.edit_item(tree, section_key, has_image)).pack(side="left", padx=10)

        tree.bind("<Double-1>", lambda e: self.edit_item(tree, section_key, has_image))

        if not is_text_tab and not is_background_tab and section_key != "text_management":
            tree.bind("<ButtonPress-1>", lambda e: self.drag_start(e, tree))
            tree.bind("<B1-Motion>", lambda e: self.drag_motion(e, tree))
            tree.bind("<ButtonRelease-1>", lambda e: self.drag_end(e, tree, section_key))
            tree.tag_configure("DragTarget", background="#fff9c4")
            tree.tag_configure("dragging", background="#0078d7", foreground="white")

    # ====================== ドラッグ＆ドロップ ======================
    def drag_start(self, event, tree):
        tree.drag_iid = tree.identify_row(event.y)
        if tree.drag_iid:
            tree.drag_selected = list(tree.selection())
            if tree.drag_iid not in tree.drag_selected:
                tree.drag_selected = [tree.drag_iid]
            self.dragging_items = tree.drag_selected[:]
            for iid in self.dragging_items:
                if tree.exists(iid):
                    tree.item(iid, tags=("dragging",))

    def drag_motion(self, event, tree):
        if not hasattr(tree, "drag_selected") or not tree.drag_selected:
            return
        target = tree.identify_row(event.y)
        if target == self.current_highlight:
            return
        if self.current_highlight and tree.exists(self.current_highlight):
            tree.item(self.current_highlight, tags=())
        if target and target not in getattr(tree, "drag_selected", []):
            tree.item(target, tags=("DragTarget",))
            self.current_highlight = target
        else:
            self.current_highlight = None

    def drag_end(self, event, tree, section_key):
        if self.current_highlight and tree.exists(self.current_highlight):
            tree.item(self.current_highlight, tags=())
        self.current_highlight = None
        if hasattr(tree, "drag_selected") and tree.drag_selected:
            for iid in self.dragging_items:
                if tree.exists(iid):
                    tree.item(iid, tags=())
        self.dragging_items = []
        if not hasattr(tree, "drag_iid") or not getattr(tree, "drag_iid", None):
            self._cleanup_drag(tree)
            return
        target = tree.identify_row(event.y)
        data = self.sections[section_key]
        selected = getattr(tree, "drag_selected", [])
        if not selected:
            self._cleanup_drag(tree)
            return
        if target and target in selected:
            self._cleanup_drag(tree)
            return
        sel_indices = sorted(tree.index(iid) for iid in selected)
        to_move = [data[i] for i in sel_indices]
        for i in sorted(sel_indices, reverse=True):
            del data[i]
        if target is None:
            insert_pos = len(data)
        else:
            orig_target_idx = tree.index(target)
            num_removed_before = sum(1 for i in sel_indices if i < orig_target_idx)
            insert_pos = orig_target_idx - num_removed_before + 1
        data[insert_pos:insert_pos] = to_move
        self.populate_tree(tree, section_key, self.tree_info[section_key])
        self._cleanup_drag(tree)

    def _cleanup_drag(self, tree):
        for attr in ("drag_iid", "drag_selected"):
            if hasattr(tree, attr):
                delattr(tree, attr)

    # ====================== その他の機能 ======================
    def reverse_order(self, tree, key):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"): return
        data = self.sections[key]
        if not data: return
        data.reverse()
        self.populate_tree(tree, key, self.tree_info[key])
        messagebox.showinfo("完了", "すべての行を逆順に並び替えました。")

    def move_to_bottom(self, tree, key):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"): return
        selection = tree.selection()
        if not selection:
            messagebox.showwarning("警告", "移動する行を選択してください。")
            return
        data = self.sections[key]
        indices = sorted([tree.index(iid) for iid in selection], reverse=True)
        to_move = [data[i] for i in indices]
        for i in indices:
            del data[i]
        data.extend(to_move)
        self.populate_tree(tree, key, self.tree_info[key])
        new_children = tree.get_children()
        if new_children:
            new_iids = new_children[-len(to_move):]
            tree.selection_set(new_iids)
            tree.focus(new_iids[0])
            tree.see(new_iids[0])
        messagebox.showinfo("完了", f"{len(to_move)} 件を最下部へ移動しました。")

    def copy_and_add(self, tree, key):
        selection = tree.selection()
        if not selection:
            messagebox.showwarning("警告", "コピーする行を選択してください。")
            return
        data = self.sections[key]
        added_count = 0
        for iid in selection:
            idx = tree.index(iid)
            if idx < len(data):
                data.append(copy.deepcopy(data[idx]))
                added_count += 1
        if added_count > 0:
            self.populate_tree(tree, key, self.tree_info[key])
            new_children = tree.get_children()
            if new_children:
                tree.selection_set(new_children[-added_count:])
                tree.focus(new_children[-1])
                tree.see(new_children[-1])
            messagebox.showinfo("コピー完了", f"{added_count} 件を末尾にコピーして追加しました。")

    def populate_tree(self, tree, key, has_image):
        for i in tree.get_children():
            tree.delete(i)
        data_list = self.sections[key]
        is_background_tab = key in ("index_backgrounds", "menu_backgrounds", "css_backgrounds")

        if is_background_tab:
            for item in data_list:
                src = item.get("src", "")
                thumb = self.create_thumbnail(src)
                img_kw = {"image": thumb} if thumb is not None else {}
                resolution = self.get_image_resolution_text(src)
                tree.insert("", "end", text="", **img_kw, values=(src, resolution))
                if thumb:
                    self.all_thumbs.append(thumb)
            self.rendered_sections.add(key)
            return

        display_idx = 1
        for item in data_list:
            if key == "text_management":
                if not isinstance(item, dict):
                    continue
                text = item.get("text", "")
                if item.get("edited") or item.get("html_edited"):
                    text = "* " + text
                tree.insert("", "end", text=str(display_idx), values=(
                    item.get("file", ""),
                    item.get("section", ""),
                    item.get("kind", ""),
                    text
                ))
                display_idx += 1
                continue

            if key == "nav_menu":
                if not isinstance(item, dict):
                    continue
                tree.insert("", "end", text=str(display_idx), values=(item.get("text", ""), item.get("href", "")))
                display_idx += 1
                continue

            if key in ("index_text", "menu_text") or key.startswith("custom_text_"):
                if not isinstance(item, str) or not item.strip(): continue
                display_text = (item[:120] + "..." if len(item) > 120 else item).replace("\n", " ")
                tree.insert("", "end", text=str(display_idx), values=(display_text,))
                display_idx += 1
                continue

            if has_image:
                thumb = self.create_thumbnail(item.get("src", "")) if isinstance(item, dict) else None
                img_kw = {"image": thumb} if thumb is not None else {}
                src = item.get("src", "") if isinstance(item, dict) else ""
                href = item.get("href", "") if isinstance(item, dict) else ""
                text = self.wrap_display_text(self.get_product_name_for_display(item))
                resolution = self.get_image_resolution_text(src)
                if key.startswith("group_"):
                    values = (src, href, text, resolution)
                else:
                    badge = item.get("badge", "") if isinstance(item, dict) else ""
                    values = (src, href, text, badge, resolution)
                tree.insert("", "end", text="", **img_kw, values=values)
                if thumb:
                    self.all_thumbs.append(thumb)
            else:
                label = item.get("label", "") if isinstance(item, dict) else ""
                href = item.get("href", "") if isinstance(item, dict) else ""
                link_text = item.get("link_text", "") if isinstance(item, dict) else ""
                values = (label, href, link_text)
                tree.insert("", "end", text=str(len(tree.get_children()) + 1), values=values)
        self.rendered_sections.add(key)

    def refresh_text_management_tree(self, tree=None):
        self.refresh_text_management()
        target = tree or self.tree_widgets.get("text_management")
        if target:
            self.populate_tree(target, "text_management", False)

    def show_selected_text_html(self, tree):
        sel = tree.selection()
        if not sel:
            messagebox.showwarning("警告", "HTMLを表示する行を選択してください。")
            return
        idx = tree.index(sel[0])
        if idx >= len(self.sections.get("text_management", [])):
            return
        self.show_text_html_dialog(self.sections["text_management"][idx], tree)

    def show_text_html_dialog(self, item, tree=None):
        dlg = tk.Toplevel(self.root)
        dlg.title("HTML表示")
        dlg.geometry("900x420")
        dlg.grab_set()
        info = f"{item.get('file', '')} / {item.get('section', '')} / {item.get('kind', '')}"
        ttk.Label(dlg, text=info).pack(anchor="w", padx=12, pady=(10, 4))
        text = tk.Text(dlg, height=14, wrap="none", font=self.mono_font)
        text.pack(fill="both", expand=True, padx=12, pady=8)
        text.insert("1.0", item.get("html", item.get("original_html", "")))
        text.configure(state="disabled")

        btns = ttk.Frame(dlg)
        btns.pack(fill="x", padx=12, pady=(0, 12))
        edit_allowed = tk.BooleanVar(value=False)

        def allow_edit():
            edit_allowed.set(True)
            text.configure(state="normal")
            allow_btn.configure(state="disabled")
            apply_btn.configure(state="normal")

        def apply_html():
            if not edit_allowed.get():
                return
            new_html = text.get("1.0", "end-1c").strip()
            if not new_html:
                messagebox.showwarning("警告", "HTMLが空です。")
                return
            item["html"] = new_html
            item["text"] = self.html_to_plain_text(new_html)
            item["html_edited"] = True
            item["edited"] = False
            if tree:
                self.populate_tree(tree, "text_management", False)
            dlg.destroy()

        ttk.Button(btns, text="閉じる", command=dlg.destroy).pack(side="right", padx=6)
        apply_btn = ttk.Button(btns, text="HTMLを反映", command=apply_html, state="disabled")
        apply_btn.pack(side="right", padx=6)
        allow_btn = ttk.Button(btns, text="編集を許可", command=allow_edit)
        allow_btn.pack(side="right", padx=6)

    def create_thumbnail(self, src):
        if not src:
            return None
        if src.startswith(("http://", "https://")):
            thumb = self.create_url_thumbnail(src)
            if thumb:
                return thumb
            self.download_product_thumbnail(src, lambda: self.root.after(0, self.schedule_rendered_tree_refresh))
            return None
        if not self.images_dir:
            return None
        if src.startswith("images/") or src.startswith("images\\"):
            rel = src.replace("images/", "", 1).replace("images\\", "", 1)
            full_path = os.path.join(self.images_dir, rel)
        elif os.path.isabs(src):
            full_path = src
        else:
            full_path = os.path.join(self.images_dir, src)
        if not os.path.exists(full_path): return None
        try:
            img = Image.open(full_path)
            h = 70
            w = int(img.width * h / img.height)
            img = img.resize((w, h), Image.LANCZOS)
            return ImageTk.PhotoImage(img)
        except Exception:
            return None

    def move_items_up(self, tree, key):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"): return
        self._move_selected_items(tree, key, -1)

    def move_items_down(self, tree, key):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"): return
        self._move_selected_items(tree, key, 1)

    def _move_selected_items(self, tree, key, direction):
        selection = tree.selection()
        if not selection: return
        data = self.sections[key]
        indices = sorted(tree.index(iid) for iid in selection)
        if direction == -1 and indices[0] == 0: return
        if direction == 1 and indices[-1] == len(data) - 1: return
        to_move = [data[i] for i in indices]
        for i in sorted(indices, reverse=True):
            del data[i]
        new_start = indices[0] + direction
        if new_start < 0: new_start = 0
        data[new_start:new_start] = to_move
        self.populate_tree(tree, key, self.tree_info[key])
        new_children = tree.get_children()
        new_iids = [new_children[i] for i in range(new_start, new_start + len(to_move))]
        tree.selection_set(new_iids)
        if new_iids:
            tree.focus(new_iids[0])

    def add_products_from_csv(self, tree, key):
        if not key.startswith("group_"):
            return
        self.product_add_state = {"key": key, "tree": tree}
        existing = self.product_add_dialog
        if existing and existing.winfo_exists():
            if hasattr(existing, "refresh_for_context"):
                existing.refresh_for_context()
            existing.deiconify()
            existing.lift()
            existing.focus_force()
            existing.grab_set()
            return
        if not self.ensure_product_csv_loaded():
            return
        if not self.product_rows:
            messagebox.showwarning("警告", "商品CSVに追加できる商品がありません。")
            return

        dlg = tk.Toplevel(self.root)
        self.product_add_dialog = dlg
        dlg.title("商品CSVからグループへ追加 - 商品カードをクリックすると追加/削除")
        dlg.geometry("1180x760")
        dlg.minsize(430, 480)
        dlg.resizable(False, True)
        dlg.grab_set()

        top = ttk.Frame(dlg)
        top.pack(fill="x", padx=10, pady=8)
        top_search = ttk.Frame(top)
        top_search.pack(fill="x")
        top_filter = ttk.Frame(top)
        top_filter.pack(fill="x", pady=(4, 0))
        top_options = ttk.Frame(top)
        top_options.pack(fill="x", pady=(4, 0))
        ttk.Label(top_search, text="検索:").pack(side="left")
        search_var = tk.StringVar()
        search_entry = ttk.Entry(top_search, textvariable=search_var, width=24, font=self.default_font)
        search_entry.pack(side="left", padx=6)
        ttk.Button(top_search, text="検索", command=lambda: refresh_grid()).pack(side="left", padx=(0, 6))
        count_var = tk.StringVar()
        ttk.Label(top_search, textvariable=count_var, foreground="gray").pack(side="left", padx=8)
        ttk.Button(top_search, text="CSVを読み替え", command=lambda: reload_csv()).pack(side="right", padx=4)
        ttk.Label(top_options, text="カテゴリ:").pack(side="left", padx=(0, 2))
        category_var = tk.StringVar(value="すべて")
        categories = ["すべて"] + sorted({row.get("path", "") for row in self.product_rows if row.get("path", "")})
        category_combo = ttk.Combobox(top_options, textvariable=category_var, values=categories, state="readonly", width=16, font=self.default_font)
        category_combo.pack(side="left", padx=4)
        image_only_var = tk.BooleanVar(value=False)
        ttk.Checkbutton(top_filter, text="画像ありのみ", variable=image_only_var, command=lambda: refresh_grid()).pack(side="left", padx=6)
        filter_mode_var = tk.StringVar(value="all")
        filter_frame = ttk.Frame(top_filter)
        filter_frame.pack(side="left", padx=6)
        for text, value in (
            ("全て表示", "all"),
            ("現未登録", "current_unregistered"),
            ("全未登録", "all_unregistered"),
        ):
            ttk.Radiobutton(
                filter_frame,
                text=text,
                value=value,
                variable=filter_mode_var,
                style="Toolbutton",
                command=lambda: refresh_grid()
            ).pack(side="left")
        card_width = 194
        card_height = 144
        tile_gap = 4
        tile_columns_var = tk.IntVar(value=6)

        def apply_dialog_width():
            columns = tile_columns_var.get()
            content_width = columns * card_width + max(0, columns - 1) * tile_gap
            width = max(430, content_width + 46)
            height = max(dlg.winfo_height(), 480)
            dlg.geometry(f"{width}x{height}")

        def change_tile_columns(delta):
            columns = max(1, min(10, tile_columns_var.get() + delta))
            if columns == tile_columns_var.get():
                return
            tile_columns_var.set(columns)
            apply_dialog_width()
            layout_cards()

        tile_frame = ttk.Frame(top_options)
        tile_frame.pack(side="left", padx=6)
        ttk.Button(tile_frame, text="－", width=3, command=lambda: change_tile_columns(-1)).pack(side="left")
        ttk.Label(tile_frame, textvariable=tile_columns_var, width=2, anchor="center").pack(side="left", padx=2)
        ttk.Label(tile_frame, text="列").pack(side="left")
        ttk.Button(tile_frame, text="＋", width=3, command=lambda: change_tile_columns(1)).pack(side="left", padx=(2, 0))
        sort_var = tk.StringVar(value="CSV順")
        ttk.Combobox(top_options, textvariable=sort_var, values=["CSV順", "商品コード順", "商品名順"], state="readonly", width=12, font=self.default_font).pack(side="left", padx=4)

        canvas_frame = ttk.Frame(dlg)
        canvas_frame.pack(fill="both", expand=True, padx=10, pady=(0, 8))
        canvas = tk.Canvas(canvas_frame, highlightthickness=0)
        yscroll = ttk.Scrollbar(canvas_frame, orient="vertical", command=canvas.yview)
        grid_frame = ttk.Frame(canvas)
        window_id = canvas.create_window((0, 0), window=grid_frame, anchor="nw")
        canvas.configure(yscrollcommand=yscroll.set)
        canvas.pack(side="left", fill="both", expand=True)
        yscroll.pack(side="right", fill="y")

        bottom = ttk.Frame(dlg)
        bottom.pack(fill="x", padx=10, pady=(0, 10))
        visible_rows = []
        added_codes = set()
        product_photos = []
        card_widgets = []
        card_records = []
        action_var = tk.StringVar(value="")
        render_after_id = None
        batch_size = 30

        def current_key():
            return self.product_add_state.get("key", key)

        def current_tree():
            return self.product_add_state.get("tree") or tree

        def current_group_label():
            group_key = current_key()
            return self.get_group_display_name(group_key) if group_key else ""

        def get_registered_keys():
            registered = set()
            for item in self.sections.get(current_key(), []):
                href = item.get("href", "") if isinstance(item, dict) else ""
                src = item.get("src", "") if isinstance(item, dict) else ""
                registered.add(href)
                registered.add(src)
                m = re.search(r'/([^/]+)\.html(?:$|\?)', href)
                if m:
                    registered.add(m.group(1))
            return registered

        def match_registered(row, registered):
            return (
                row.get("code", "") in registered or
                row.get("href", "") in registered or
                row.get("src", "") in registered
            )

        def row_matches_current_filters(row):
            query = search_var.get().strip().lower()
            words = [w for w in query.split() if w]
            if words and not all(word in row.get("search", "") for word in words):
                return False
            if category_var.get() != "すべて" and row.get("path", "") != category_var.get():
                return False
            if image_only_var.get() and not row.get("src", ""):
                return False
            filter_mode = filter_mode_var.get()
            if filter_mode == "current_unregistered" and match_registered(row, get_registered_keys()):
                return False
            if filter_mode == "all_unregistered" and self.get_group_memberships_for_product(row):
                return False
            return True

        def filter_rows():
            registered = get_registered_keys()
            rows = []
            for row in self.product_rows:
                if not row_matches_current_filters(row):
                    continue
                rows.append(row)
            if sort_var.get() == "商品コード順":
                rows.sort(key=lambda row: row.get("code", ""))
            elif sort_var.get() == "商品名順":
                rows.sort(key=lambda row: row.get("name", ""))
            return rows

        def layout_cards():
            if not card_widgets:
                return
            columns = tile_columns_var.get()
            for index, card in enumerate(card_widgets):
                col = index % columns
                row = index // columns
                card.place(x=col * (card_width + tile_gap), y=row * (card_height + tile_gap), width=card_width, height=card_height)
            rows = (len(card_widgets) + columns - 1) // columns
            content_width = columns * card_width + max(0, columns - 1) * tile_gap
            content_height = rows * card_height + max(0, rows - 1) * tile_gap
            grid_frame.configure(
                width=content_width,
                height=content_height
            )
            canvas.itemconfigure(window_id, width=content_width)
            grid_frame.update_idletasks()
            canvas.configure(scrollregion=canvas.bbox("all"))

        def cancel_render():
            nonlocal render_after_id
            if render_after_id:
                try:
                    dlg.after_cancel(render_after_id)
                except tk.TclError:
                    pass
                render_after_id = None

        def create_status_badge(parent, text, bg, fg):
            badge_frame = tk.Frame(parent, width=28, height=18, bg="#dddddd", relief="flat", bd=0)
            badge_frame.grid_propagate(False)
            badge = tk.Label(
                badge_frame,
                text=text,
                bg=bg,
                fg=fg,
                font=("MS Gothic", 8),
                relief="flat",
                bd=0,
                highlightthickness=0
            )
            badge.place(x=1, y=1, width=26, height=16)
            return badge_frame

        def refresh_badges_for_frame(badge_frame, row):
            for widget in badge_frame.winfo_children():
                widget.destroy()
            memberships = self.get_group_memberships_for_product(row)
            for badge_index, group_key in enumerate(self.get_group_keys()):
                label, bg, fg = self.get_group_badge(group_key)
                if group_key not in memberships:
                    label, bg, fg = "未", "#f7f7f7", "#666666"
                badge = create_status_badge(badge_frame, label, bg, fg)
                badge.grid(row=0, column=badge_index, padx=(0, 3), pady=1)

        def create_product_card(row):
            card = ttk.Frame(grid_frame, padding=4, relief="groove")
            card_widgets.append(card)
            thumb_frame = tk.Frame(card, bd=0, relief="flat", highlightthickness=2, highlightbackground="#d9d9d9")
            thumb_frame.grid(row=0, column=0, rowspan=2, sticky="n", padx=(0, 5))
            thumb = ttk.Label(thumb_frame, text="画像読込中", anchor="center", width=12)
            thumb.pack()
            self.set_product_thumb(thumb, row, product_photos, size=82)
            code_label = ttk.Label(card, text=row.get("code", ""), font=("Consolas", 10, "bold"))
            code_label.grid(row=0, column=1, sticky="w")
            name = row.get("name", "")
            name_font = ("Yu Gothic", 8)
            name_frame = tk.Frame(card, width=96, height=88)
            name_frame.grid(row=1, column=1, sticky="nw")
            name_frame.grid_propagate(False)
            name_label = tk.Label(
                name_frame,
                text=self.wrap_display_text(name, width=8, max_lines=6),
                font=name_font,
                justify="left",
                anchor="nw",
                height=6
            )
            name_label.pack(fill="both", expand=True)
            badge_frame = tk.Frame(card, width=166, height=22)
            badge_frame.grid(row=2, column=0, columnspan=2, sticky="w", pady=(3, 0))
            badge_frame.grid_propagate(False)
            refresh_badges_for_frame(badge_frame, row)
            card_records.append({"row": row, "card": card, "badge_frame": badge_frame})

            def mark_hover(_event, frame=thumb_frame):
                frame.configure(highlightbackground="#90ff90", highlightcolor="#90ff90")

            def clear_hover(_event, frame=thumb_frame):
                frame.configure(highlightbackground="#d9d9d9", highlightcolor="#d9d9d9")

            for widget in (thumb_frame, thumb):
                widget.bind("<Enter>", mark_hover)
                widget.bind("<Leave>", clear_hover)
                widget.bind("<Button-1>", lambda e, r=row: add_product_now(r))
            return card

        def update_added_product_card(row):
            filter_mode = filter_mode_var.get()
            target_records = [record for record in card_records if record.get("row") is row]
            if filter_mode in ("current_unregistered", "all_unregistered"):
                for record in target_records:
                    card = record.get("card")
                    if card in card_widgets:
                        card_widgets.remove(card)
                    if record in card_records:
                        card_records.remove(record)
                    try:
                        card.destroy()
                    except tk.TclError:
                        pass
                if row in visible_rows:
                    visible_rows.remove(row)
                layout_cards()
            else:
                for record in target_records:
                    refresh_badges_for_frame(record["badge_frame"], row)
            count_var.set(f"タイル {len(card_widgets)} / {len(visible_rows)} 件")

        def find_group_item_index(row):
            row_keys = {row.get("code", ""), row.get("href", ""), row.get("src", "")}
            row_keys.discard("")
            for index, item in enumerate(self.sections.get(current_key(), [])):
                if not isinstance(item, dict):
                    continue
                href = item.get("href", "")
                src = item.get("src", "")
                code = self.extract_code_from_href(href)
                item_keys = {href, src, code}
                item_keys.discard("")
                if row_keys & item_keys:
                    return index
            return None

        def update_removed_product_card(row):
            target_records = [record for record in card_records if record.get("row") is row]
            if target_records:
                for record in target_records:
                    refresh_badges_for_frame(record["badge_frame"], row)
            elif row_matches_current_filters(row):
                visible_rows.append(row)
                create_product_card(row)
                layout_cards()
            count_var.set(f"タイル {len(card_widgets)} / {len(visible_rows)} 件")

        def render_next_batch():
            nonlocal render_after_id
            render_after_id = None
            start = len(card_widgets)
            end = min(start + batch_size, len(visible_rows))
            for row in visible_rows[start:end]:
                create_product_card(row)
            layout_cards()
            count_var.set(f"タイル {len(card_widgets)} / {len(visible_rows)} 件")
            if len(card_widgets) < len(visible_rows):
                render_after_id = dlg.after(40, render_next_batch)

        def refresh_grid(*_, reset_scroll=True):
            nonlocal visible_rows
            cancel_render()
            visible_rows = filter_rows()
            for widget in grid_frame.winfo_children():
                widget.destroy()
            product_photos.clear()
            card_widgets.clear()
            card_records.clear()
            grid_frame.configure(width=1, height=1)
            canvas.configure(scrollregion=(0, 0, 1, 1))
            if reset_scroll:
                canvas.yview_moveto(0)
            count_var.set(f"タイル 0 / {len(visible_rows)} 件")
            render_next_batch()
            if reset_scroll:
                dlg.after_idle(lambda: canvas.yview_moveto(0))

        def add_product_now(row):
            existing_index = find_group_item_index(row)
            if existing_index is not None:
                group_key = current_key()
                target_tree = current_tree()
                del self.sections[group_key][existing_index]
                if row.get("code", ""):
                    added_codes.discard(row.get("code", ""))
                self.populate_tree(target_tree, group_key, True)
                action_var.set(f"{current_group_label()}から削除しました: {row.get('code', '')} / {row.get('name', '')[:30]}")
                update_removed_product_card(row)
                return
            try:
                group_key = current_key()
                target_tree = current_tree()
                local_src = self.prepare_group_image_from_product(row, group_key)
            except Exception as e:
                messagebox.showerror("画像保存失敗", f"商品画像を images フォルダへ保存できませんでした。\n\n{e}")
                return
            new_item = {
                "href": row.get("href", ""),
                "src": local_src,
                "text": row.get("text", ""),
                "badge": row.get("badge", "")
            }
            self.sections[group_key].append(new_item)
            if row.get("code", ""):
                added_codes.add(row.get("code", ""))
            self.populate_tree(target_tree, group_key, True)
            children = target_tree.get_children()
            if children:
                newest = children[-1]
                target_tree.selection_set(newest)
                target_tree.focus(newest)
                target_tree.see(newest)
            action_var.set(f"{current_group_label()}へ追加しました: {row.get('code', '')} / {row.get('name', '')[:30]}")
            update_added_product_card(row)

        def update_scroll_region(event=None):
            canvas.configure(scrollregion=canvas.bbox("all"))

        def resize_canvas_window(event):
            canvas.itemconfigure(window_id, width=grid_frame.winfo_width())

        def on_mousewheel(event):
            canvas.yview_scroll(-1 * int(event.delta / 120), "units")
            return "break"

        def close_dialog():
            try:
                dlg.grab_release()
            except tk.TclError:
                pass
            dlg.withdraw()

        def reload_csv():
            if self.load_product_csv():
                categories[:] = ["すべて"] + sorted({row.get("path", "") for row in self.product_rows if row.get("path", "")})
                category_combo.configure(values=categories)
                category_var.set("すべて")
                added_codes.clear()
                refresh_grid()

        def refresh_visible_badges():
            for record in card_records:
                refresh_badges_for_frame(record["badge_frame"], record["row"])

        def refresh_for_context():
            dlg.title(f"商品CSVからグループへ追加 - {current_group_label()} - 商品カードをクリックすると追加/削除")
            if filter_mode_var.get() == "current_unregistered":
                refresh_grid(reset_scroll=False)
            else:
                refresh_visible_badges()
                count_var.set(f"タイル {len(card_widgets)} / {len(visible_rows)} 件")
            action_var.set(f"対象: {current_group_label()}")

        dlg.refresh_for_context = refresh_for_context

        ttk.Label(bottom, textvariable=action_var, foreground="gray").pack(side="left", padx=4)
        ttk.Button(bottom, text="閉じる", command=close_dialog).pack(side="right", padx=4)

        search_entry.bind("<Return>", lambda _event: refresh_grid())
        category_var.trace_add("write", refresh_grid)
        sort_var.trace_add("write", refresh_grid)
        grid_frame.bind("<Configure>", update_scroll_region)
        canvas.bind("<Configure>", resize_canvas_window)
        dlg.bind("<MouseWheel>", on_mousewheel)
        dlg.protocol("WM_DELETE_WINDOW", close_dialog)
        apply_dialog_width()
        dlg.title(f"商品CSVからグループへ追加 - {current_group_label()} - 商品カードをクリックすると追加/削除")
        action_var.set(f"対象: {current_group_label()}")
        refresh_grid()
        search_entry.focus_set()

    def set_product_thumb(self, label, row, photo_holder, size=120):
        src = row.get("src", "")
        if not src:
            label.configure(text="画像なし")
            return
        photo = self.get_product_thumbnail(src, size=size)
        if photo:
            photo_holder.append(photo)
            label.configure(image=photo, text="")
            return
        if src in self.product_thumb_failed:
            label.configure(text="画像取得不可")
            return
        label.configure(text="画像読込中")
        self.download_product_thumbnail(src, lambda: self.root.after(0, lambda: self.apply_product_thumb(label, src, photo_holder, size=size)))

    def apply_product_thumb(self, label, src, photo_holder, size=120):
        if not label.winfo_exists():
            return
        photo = self.get_product_thumbnail(src, size=size)
        if photo:
            photo_holder.append(photo)
            label.configure(image=photo, text="")
        else:
            label.configure(text="画像取得不可")

    def get_product_thumbnail(self, src, size=120):
        cache_key = (src, size)
        if cache_key in self.product_thumb_cache:
            return self.product_thumb_cache[cache_key]
        path = self.get_product_thumb_cache_path(src)
        if not path or not os.path.exists(path):
            return None
        try:
            img = Image.open(path)
            img.thumbnail((size, size))
            photo = ImageTk.PhotoImage(img)
            self.product_thumb_cache[cache_key] = photo
            return photo
        except Exception:
            return None

    def create_url_thumbnail(self, src):
        path = self.get_product_thumb_cache_path(src)
        if not path or not os.path.exists(path):
            return None
        try:
            img = Image.open(path)
            h = 70
            w = max(1, int(img.width * h / img.height))
            img = img.resize((w, h), Image.LANCZOS)
            return ImageTk.PhotoImage(img)
        except Exception:
            return None

    def get_product_thumb_cache_path(self, src):
        if src.startswith(("http://", "https://")):
            digest = hashlib.sha1(src.encode("utf-8")).hexdigest()
            return os.path.join(self.product_thumb_dir, f"{digest}.jpg")
        if os.path.isabs(src):
            return src
        return None

    def download_product_thumbnail(self, src, on_done):
        if not src.startswith(("http://", "https://")) or src in self.product_thumb_loading or src in self.product_thumb_failed:
            return
        self.product_thumb_loading.add(src)

        def worker():
            success = False
            try:
                os.makedirs(self.product_thumb_dir, exist_ok=True)
                path = self.get_product_thumb_cache_path(src)
                if path and not os.path.exists(path):
                    req = urllib.request.Request(src, headers={"User-Agent": "Mozilla/5.0"})
                    with urllib.request.urlopen(req, timeout=12) as response:
                        data = response.read()
                    with open(path, "wb") as f:
                        f.write(data)
                    self.cleanup_product_thumb_cache()
                success = True
            except Exception:
                pass
            finally:
                if not success:
                    self.product_thumb_failed.add(src)
                self.product_thumb_loading.discard(src)
                on_done()

        threading.Thread(target=worker, daemon=True).start()

    def add_new_item(self, tree, key, has_image):
        if key in ("index_text", "menu_text") or key.startswith("custom_text_"):
            new_item = '<p>新しいテキストをここに入力してください</p>'
            self.sections[key].append(new_item)
        else:
            if key == "nav_menu":
                new_item = {"href": "#new-section", "text": "新しいメニュー"}
            elif key in ("index_backgrounds", "menu_backgrounds", "css_backgrounds"):
                new_item = {"src": "", "original_src": ""}
            elif has_image:
                new_item = {"href": "https://example.com", "src": "", "text": "新しい項目", "badge": ""}
            else:
                new_item = {"label": "新しいラベル", "href": "https://example.com", "link_text": "リンクテキスト"}
            self.sections[key].append(new_item)
        self.populate_tree(tree, key, has_image)

    def delete_item(self, tree, key):
        sel = tree.selection()
        if not sel: return
        if not messagebox.askyesno("確認", f"{len(sel)} 個の項目を削除しますか？"):
            return
        data = self.sections[key]
        indices_to_delete = [tree.index(iid) for iid in sel]
        for idx in sorted(set(indices_to_delete), reverse=True):
            if idx < len(data):
                del data[idx]
        self.populate_tree(tree, key, self.tree_info[key])

    def edit_item(self, tree, key, has_image):
        sel = tree.selection()
        if not sel: return
        tree_idx = tree.index(sel[0])
        is_background_tab = key in ("index_backgrounds", "menu_backgrounds", "css_backgrounds")

        if key == "text_management":
            item = self.sections[key][tree_idx]
            dlg = tk.Toplevel(self.root)
            dlg.title("テキスト編集")
            dlg.geometry("780x260")
            dlg.grab_set()
            info = f"{item.get('file', '')} / {item.get('section', '')} / {item.get('kind', '')}"
            ttk.Label(dlg, text=info).pack(anchor="w", padx=15, pady=(15, 6))
            text_var = tk.StringVar(value=item.get("text", ""))
            entry = ttk.Entry(dlg, textvariable=text_var, width=95, font=self.default_font)
            entry.pack(padx=15, pady=8, fill="x")
            entry.focus_set()

            def save_dlg():
                item["text"] = text_var.get()
                item["html"] = self.update_html_inner_text(item.get("original_html", ""), item["text"])
                item["edited"] = True
                item["html_edited"] = False
                self.populate_tree(tree, key, False)
                dlg.destroy()

            btns = ttk.Frame(dlg)
            btns.pack(pady=18)
            ttk.Button(btns, text="保存", command=save_dlg).pack(side="left", padx=12)
            ttk.Button(btns, text="HTML表示", command=lambda: self.show_text_html_dialog(item, tree)).pack(side="left", padx=12)
            ttk.Button(btns, text="キャンセル", command=dlg.destroy).pack(side="left", padx=12)
            return

        if is_background_tab:
            item = self.sections[key][tree_idx]
            dlg = tk.Toplevel(self.root)
            dlg.title("背景画像 編集")
            dlg.geometry("750x220")
            dlg.grab_set()
            ttk.Label(dlg, text="画像パス:").pack(anchor="w", padx=15, pady=(15, 5))
            src_var = tk.StringVar(value=item.get("src", ""))
            entry = ttk.Entry(dlg, textvariable=src_var, width=90, font=self.default_font)
            entry.pack(padx=15, pady=8, fill="x")
            ttk.Button(dlg, text="🖼️ 画像ファイルを選択",
                       command=lambda: self.choose_image(src_var, for_css=(key == "css_backgrounds"))).pack(pady=10)

            def save_dlg():
                new_src = src_var.get().strip()
                if new_src:
                    item["src"] = new_src
                self.populate_tree(tree, key, True)
                dlg.destroy()

            ttk.Button(dlg, text="保存", command=save_dlg).pack(pady=10)
            return

        if key in ("index_text", "menu_text") or key.startswith("custom_text_"):
            real_idx = tree_idx
            current_html = self.sections[key][real_idx]
            dlg = tk.Toplevel(self.root)
            dlg.title("HTML行編集（タグごと編集）")
            dlg.geometry("1050x300")
            dlg.grab_set()
            ttk.Label(dlg, text=f"行 {real_idx + 1} のHTML（タグごと編集してください）:").pack(anchor="w", padx=10, pady=(10, 5))
            text_var = tk.StringVar(value=current_html)
            entry = ttk.Entry(dlg, textvariable=text_var, width=150, font=self.default_font)
            entry.pack(padx=10, pady=8, fill="x")
            entry.focus_set()

            def save_dlg():
                new_html = text_var.get().strip()
                self.sections[key][real_idx] = new_html if new_html else "<p></p>"
                self.populate_tree(tree, key, False)
                dlg.destroy()

            btn_f = ttk.Frame(dlg)
            btn_f.pack(pady=15)
            ttk.Button(btn_f, text="保存", command=save_dlg).pack(side="left", padx=30)
            ttk.Button(btn_f, text="キャンセル", command=dlg.destroy).pack(side="left")
            return

        item = self.sections[key][tree_idx]
        dlg = tk.Toplevel(self.root)
        dlg.title("項目編集")
        dlg.geometry("620x420")
        dlg.grab_set()
        row = 0
        entries = {}

        if has_image:
            ttk.Label(dlg, text="画像パス:").grid(row=row, column=0, sticky="e", padx=5, pady=4)
            src_var = tk.StringVar(value=item.get("src", ""))
            ttk.Entry(dlg, textvariable=src_var, width=60, font=self.default_font).grid(row=row, column=1, padx=5, pady=4)
            ttk.Button(dlg, text="画像選択", command=lambda: self.choose_image(src_var)).grid(row=row, column=2, padx=5)
            entries["src"] = src_var
            row += 1

        ttk.Label(dlg, text="リンクURL:").grid(row=row, column=0, sticky="e", padx=5, pady=4)
        href_var = tk.StringVar(value=item.get("href", ""))
        ttk.Entry(dlg, textvariable=href_var, width=60, font=self.default_font).grid(row=row, column=1, padx=5, pady=4, columnspan=2)
        entries["href"] = href_var
        row += 1

        if "text" in item or "link_text" in item:
            label_text = "表示テキスト:" if "text" in item else "リンクテキスト:"
            ttk.Label(dlg, text=label_text).grid(row=row, column=0, sticky="e", padx=5, pady=4)
            text_var = tk.StringVar(value=item.get("text", item.get("link_text", "")))
            ttk.Entry(dlg, textvariable=text_var, width=60, font=self.default_font).grid(row=row, column=1, padx=5, pady=4, columnspan=2)
            entries["text"] = text_var
            row += 1

        if "badge" in item:
            ttk.Label(dlg, text="バッジ:").grid(row=row, column=0, sticky="e", padx=5, pady=4)
            badge_var = tk.StringVar(value=item.get("badge", ""))
            ttk.Entry(dlg, textvariable=badge_var, width=60, font=self.default_font).grid(row=row, column=1, padx=5, pady=4, columnspan=2)
            entries["badge"] = badge_var
            row += 1

        if not has_image and "label" in item:
            ttk.Label(dlg, text="ラベル:").grid(row=row, column=0, sticky="e", padx=5, pady=4)
            label_var = tk.StringVar(value=item.get("label", ""))
            ttk.Entry(dlg, textvariable=label_var, width=60, font=self.default_font).grid(row=row, column=1, padx=5, pady=4, columnspan=2)
            entries["label"] = label_var

        def save_dlg():
            if has_image and "src" in entries:
                item["src"] = entries["src"].get()
            item["href"] = entries["href"].get()
            if "text" in entries:
                item["text"] = entries["text"].get()
            elif "link_text" in entries:
                item["link_text"] = entries["text"].get()
            if "badge" in entries:
                item["badge"] = entries["badge"].get()
            if "label" in entries:
                item["label"] = entries["label"].get()
            self.populate_tree(tree, key, has_image)
            dlg.destroy()

        ttk.Button(dlg, text="保存", command=save_dlg).grid(row=row + 1, column=1, pady=25)

    # ====================== 画像選択 ======================
    def choose_image(self, var, for_css=False):
        path = filedialog.askopenfilename(title="新しい画像を選択", 
                                         filetypes=[("画像ファイル", "*.jpg *.png *.gif *.webp *.jpeg")])
        if not path: 
            return

        if self.images_dir and os.path.exists(self.images_dir):
            abs_images = os.path.abspath(self.images_dir)
            abs_selected = os.path.abspath(path)

            if abs_selected.startswith(abs_images + os.sep):
                rel = os.path.relpath(abs_selected, abs_images).replace(os.sep, "/")
                final_path = f"images/{rel}"
            else:
                basename = os.path.basename(path)
                dest = os.path.join(self.images_dir, basename)
                try:
                    if abs_selected != os.path.abspath(dest):
                        shutil.copy2(path, dest)
                    final_path = f"images/{basename}"
                except Exception as e:
                    messagebox.showerror("コピー失敗", str(e))
                    return
        else:
            final_path = path

        if for_css and final_path.startswith(("images/", "images\\")):
            final_path = "../" + final_path.replace("\\", "/")

        var.set(final_path)

    # ====================== 保存 ======================
    def save_all_with_backup(self):
        self._save_core(backup=True)

    def save_all_overwrite(self):
        if not messagebox.askyesno("確認", "バックアップを作成して上書き保存しますか？"):
            return
        self._save_core(backup=True)

    def _save_core(self, backup=True):
        self.apply_text_management_replaces()
        if self.index_path:
            self.rebuild_index()
        if self.menu_path:
            self.rebuild_menu()
        self.apply_background_replaces()

        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")

        if self.index_path and self.index_html:
            if backup:
                bak = self.index_path + f".{timestamp}.bak"
                shutil.copy2(self.index_path, bak)
            with open(self.index_path, "w", encoding="utf-8") as f:
                f.write(self.index_html)

        if self.menu_path and self.menu_html:
            if backup:
                bak = self.menu_path + f".{timestamp}.bak"
                shutil.copy2(self.menu_path, bak)
            with open(self.menu_path, "w", encoding="utf-8") as f:
                f.write(self.menu_html)

        if self.css_path and self.css_content:
            if backup:
                bak = self.css_path + f".{timestamp}.bak"
                shutil.copy2(self.css_path, bak)
            with open(self.css_path, "w", encoding="utf-8") as f:
                f.write(self.css_content)

        self.sync_background_originals()
        self.update_all_trees()
        self.save_settings()
        messagebox.showinfo("保存完了", "保存しました。" + ("\nバックアップも作成済みです。" if backup else ""))

    def update_all_trees(self):
        if not self.tree_widgets:
            return
        self.refresh_all_heading_editors()
        self.cancel_lazy_tree_render()
        self.rendered_sections.clear()
        visible_keys = [key for _title, key, _has_image in self.tab_info
                        if key in self.tree_widgets and self.is_section_tab_visible(key)]
        if not visible_keys:
            return
        primary_key = self.get_selected_section_key()
        if primary_key not in self.tree_widgets or not self.is_section_tab_visible(primary_key):
            primary_key = "group_a" if "group_a" in visible_keys else visible_keys[0]
        immediate_keys = self.get_immediate_render_keys(primary_key, visible_keys)
        for key in immediate_keys:
            self.render_section_tree(key)
        remaining = [key for key in visible_keys if key not in immediate_keys]
        self.schedule_lazy_tree_render(remaining)

    def update_status(self):
        txt = []
        if self.index_path: txt.append(f"index: {os.path.basename(self.index_path)}")
        if self.menu_path: txt.append(f"menu: {os.path.basename(self.menu_path)}")
        if self.css_path: txt.append(f"css: {os.path.basename(self.css_path)}")
        if self.product_csv_path: txt.append(f"商品CSV: {os.path.basename(self.product_csv_path)} ({len(self.product_rows)}件)")
        self.status_label.config(
            text=" | ".join(txt) if txt else "未読み込み",
            foreground="green" if txt else "gray"
        )
        if self.index_path or self.menu_path or self.css_path:
            self.save_backup_btn.config(state="normal")
            self.save_overwrite_btn.config(state="normal")

    def on_close(self):
        if messagebox.askokcancel("終了", "編集を終了しますか？"):
            self.cancel_lazy_tree_render()
            if self.thumbnail_refresh_after_id:
                try:
                    self.root.after_cancel(self.thumbnail_refresh_after_id)
                except tk.TclError:
                    pass
                self.thumbnail_refresh_after_id = None
            self.save_settings()
            self.root.destroy()


if __name__ == "__main__":
    app = YumehanEditor()
    app.root.mainloop()
