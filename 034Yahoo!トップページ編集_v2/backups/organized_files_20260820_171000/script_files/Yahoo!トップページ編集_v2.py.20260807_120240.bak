class YumehanEditor:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("ゆめはん HTML編集ツール V2 - index.html & menu.html & style.css")
        self.root.geometry("1280x720")
        self.root.minsize(1000, 600)
        style = ttk.Style()
        style.configure("Treeview", rowheight=80)
        self.default_font = ("Yu Gothic", 10)
        self.mono_font = ("Consolas", 10)
        available_fonts = tkfont.families()
        if "Yu Gothic" not in available_fonts:
            self.default_font = ("MS Gothic", 10)
        if "Consolas" not in available_fonts:
            self.mono_font = ("MS Gothic", 10)
        style.configure("TEntry", font=self.default_font)

        self.index_path = None
        self.menu_path = None
        self.css_path = None
        self.index_html = None
        self.menu_html = None
        self.css_content = None

        self.sections = {
            "group_a": [], "group_b": [], "group_c": [], "group_d": [],
            "special": [],
            "index_menu_banners": [],
            "menu_banners": [],
            "menu_bottom_links": [],
            "nav_menu": [],
            "text_management": [],
            "index_text": [],
            "menu_text": [],
            "index_backgrounds": [],
            "menu_backgrounds": [],
            "css_backgrounds": []
        }
        self.custom_section_defs = []
        self.section_headings = {}

        self.tree_widgets = {}
        self.tree_info = {}
        self.heading_editors = {}
        self.all_thumbs = []
        self.tab_icons = {}
        self.images_dir = None
        self.tabs_built = False
        self.tab_frames = {}
        self.rendered_sections = set()
        self.lazy_render_after_id = None
        self.thumbnail_refresh_after_id = None
        self.current_highlight = None
        self.dragging_items = []
        self.product_csv_path = None
        self.product_rows = []
        self.product_name_by_code = {}
        self.product_name_by_href = {}
        self.product_thumb_cache = {}
        self.product_thumb_loading = set()
        self.product_thumb_failed = set()
        self.product_add_dialog = None
        self.product_add_state = {"key": "", "tree": None}
        self.product_thumb_dir = os.path.join(SCRIPT_DIR, "cache_product_thumbs")
        self.settings = self.load_settings()
        self.auto_load_files = bool(self.settings.get("auto_load_files", True))
        self.auto_load_product_csv = bool(self.settings.get("auto_load_product_csv", True))
        self.product_thumb_cache_max_mb = max(1, int(self.settings.get("product_thumb_cache_max_mb", 200)))
        self.settings_window = None

        self.create_ui()
        self.save_settings()
        self.root.after(100, self.auto_load_recent_files)
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def create_ui(self):
        toolbar = ttk.Frame(self.root)
        toolbar.pack(fill="x", padx=8, pady=6)

        ttk.Button(toolbar, text="セクション追加", command=self.open_add_section_dialog).pack(side="left", padx=4)
        ttk.Button(toolbar, text="設定", command=self.open_settings).pack(side="left", padx=4)

        self.status_label = ttk.Label(toolbar, text="未読み込み", foreground="gray")
        self.status_label.pack(side="left", padx=20)

        self.save_backup_btn = ttk.Button(toolbar, text="💾 保存（自動バックアップ）",
                                         command=self.save_all_with_backup, state="disabled")
        self.save_backup_btn.pack(side="right", padx=4)

        self.save_overwrite_btn = ttk.Button(toolbar, text="💾 上書き保存",
                                            command=self.save_all_overwrite, state="disabled")
        self.save_overwrite_btn.pack(side="right", padx=4)

        ttk.Button(toolbar, text="❌ 終了", command=self.on_close).pack(side="right", padx=4)

        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(fill="both", expand=True, padx=8, pady=4)

    # ====================== 設定 ======================
    def load_settings(self):
        defaults = {
            "auto_load_files": False,
            "auto_load_product_csv": False,
            "product_thumb_cache_max_mb": 200,
            "html_folder": "",
            "last_index_path": "",
            "last_menu_path": "",
            "last_css_path": "",
            "product_csv_folder": "",
            "last_product_csv_path": ""
        }
        try:
            if os.path.exists(SETTINGS_PATH):
                with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                defaults.update({k: loaded.get(k, v) for k, v in defaults.items()})
                if not loaded.get("product_csv_folder") and loaded.get("last_product_csv_path"):
                    defaults["product_csv_folder"] = os.path.dirname(loaded["last_product_csv_path"])
        except Exception:
            pass
        return defaults

    def save_settings(self):
        self.settings.update({
            "auto_load_files": self.auto_load_files,
            "auto_load_product_csv": self.auto_load_product_csv,
            "product_thumb_cache_max_mb": self.product_thumb_cache_max_mb,
            "html_folder": self.get_html_folder(),
            "last_index_path": self.index_path or self.settings.get("last_index_path", ""),
            "last_menu_path": self.menu_path or self.settings.get("last_menu_path", ""),
            "last_css_path": self.css_path or self.settings.get("last_css_path", ""),
            "product_csv_folder": self.get_product_csv_folder(),
            "last_product_csv_path": self.product_csv_path or self.settings.get("last_product_csv_path", "")
        })
        try:
            with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
                json.dump(self.settings, f, ensure_ascii=False, indent=2)
        except Exception as e:
            messagebox.showerror("設定保存失敗", str(e))

    def auto_load_recent_files(self):
        loaded_any = False
        if self.settings.get("html_folder", ""):
            loaded_any = self.load_html_files_from_folder(silent=True) or loaded_any
        if self.auto_load_product_csv:
            loaded_any = self.load_latest_product_csv_from_folder(silent=True) or loaded_any
        if loaded_any:
            self.update_status()

    def get_html_folder(self):
        folder = self.settings.get("html_folder", "")
        for path in (self.index_path, self.menu_path, self.css_path):
            if path:
                folder = os.path.dirname(path)
                break
        return folder

    def load_html_files_from_folder(self, silent=False):
        folder = self.settings.get("html_folder", "")
        if not folder or not os.path.isdir(folder):
            return False
        loaded_any = False
        index_path = self.find_file_in_folder(folder, "index.html")
        menu_path = self.find_file_in_folder(folder, "menu.html")
        css_path = self.find_file_in_folder(folder, "style.css")
        loaded_any = self.load_index(index_path, silent=True) or loaded_any
        loaded_any = self.load_menu(menu_path, silent=True) or loaded_any
        loaded_any = self.load_css(css_path, silent=True) or loaded_any
        if not loaded_any and not silent:
            messagebox.showwarning("警告", "HTMLフォルダー内とサブフォルダーに index.html / menu.html / style.css が見つかりません。")
        return loaded_any

    def find_file_in_folder(self, folder, filename):
        direct_path = os.path.join(folder, filename)
        if os.path.exists(direct_path):
            return direct_path
        target = filename.lower()
        matches = []
        for current_dir, _dirs, files in os.walk(folder):
            for name in files:
                if name.lower() == target:
                    path = os.path.join(current_dir, name)
                    try:
                        matches.append((path, os.path.getmtime(path)))
                    except OSError:
                        matches.append((path, 0))
        if not matches:
            return ""
        matches.sort(key=lambda item: (item[0].count(os.sep), -item[1], item[0].lower()))
        return matches[0][0]

    def format_windows_path(self, path):
        return os.path.normpath(path) if path else ""

    def get_product_csv_folder(self):
        folder = self.settings.get("product_csv_folder", "")
        if self.product_csv_path:
            folder = os.path.dirname(self.product_csv_path)
        return folder

    def find_latest_product_csv(self):
        folder = self.settings.get("product_csv_folder", "")
        if not folder or not os.path.isdir(folder):
            return ""
        candidates = sorted(glob.glob(os.path.join(folder, "data*.csv")), key=os.path.getmtime, reverse=True)
        return candidates[0] if candidates else ""

    def load_latest_product_csv_from_folder(self, silent=False):
        latest = self.find_latest_product_csv()
        if not latest:
            if not silent:
                messagebox.showwarning("警告", "設定フォルダ内に data*.csv が見つかりません。")
            return False
        return self.load_product_csv(latest, silent=silent)

