/* ─────── ゆめはん専用 フローティング検索 v2（グレー＆超透明・列揃え）─────── */
.yumekan-floating-search-v2 {
    --search-pulse-count: 3;
    --search-pulse-color-rgb: 0, 255, 0;
    position: fixed;
    right: 36px;              /* ← ハンバーガーメニューと完全に列を合わせる値（必要に応じて±2pxで微調整） */
    bottom: 24px;
    z-index: 9998;
    display: flex;
    align-items: center;
    font-family: 'Sawarabi Mincho', 'Noto Sans JP', sans-serif;
}

.yumekan-floating-search-v2 .search-toggle {
    position: relative;
    overflow: visible;
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.75);   /* 超透明 */
    backdrop-filter: blur(12px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #666;              /* グレー系 */
    border: 1.8px solid rgba(180, 180, 180, 0.4);
    box-shadow: none;         /* 影完全削除 */
    transition: all 0.35s ease;
}

.yumekan-floating-search-v2 .search-toggle:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: scale(1.07);
}

.yumekan-floating-search-v2 .search-toggle.search-pulse {
    animation: searchButtonSoftPulse 1.8s ease-out var(--search-pulse-count);
}

.yumekan-floating-search-v2 .search-toggle.search-pulse::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(var(--search-pulse-color-rgb), 0.55);
    pointer-events: none;
    animation: searchButtonPulseRing 1.8s ease-out var(--search-pulse-count);
}

@keyframes searchButtonSoftPulse {
    0%, 100% {
        background: rgba(255, 255, 255, 0.75);
        box-shadow: none;
        transform: scale(1);
    }
    32% {
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 0 20px rgba(var(--search-pulse-color-rgb), 0.34);
        transform: scale(1.06);
    }
}

@keyframes searchButtonPulseRing {
    0% {
        opacity: 0;
        transform: scale(0.9);
    }
    18% {
        opacity: 1;
    }
    100% {
        opacity: 0;
        transform: scale(1.55);
    }
}

.yumekan-floating-search-v2 .search-input {
    height: 56px;
    padding: 0 24px;
    border: none;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    font-size: 15px;
    color: #444;
    outline: none;
    box-shadow: none;         /* 影なし */
    margin-right: -68px;
    width: 0;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1.8px solid rgba(180, 180, 180, 0.3);
}

.yumekan-floating-search-v2.active .search-input {
    width: 280px;
    opacity: 1;
    padding: 0 24px;
}

/* スマホ調整 */
@media (max-width: 480px) {
    .yumekan-floating-search-v2 { right: 24px; bottom: 18px; }
    .yumekan-floating-search-v2.active .search-input { width: 210px; }
    .yumekan-floating-search-v2 .search-toggle { width: 50px; height: 50px; }
}

